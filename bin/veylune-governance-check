pdp_services_line="$(grep -n 'class="veylune-pdp-services"' "$pdp_commerce_template" | cut -d: -f1)"
[[ "$pdp_purchase_line" -lt "$pdp_services_line" ]] || fail 'PDP primary purchase action must precede optional services'

step 'discoverability containment'
discoverability_routes=('/' '/editions')
detail_reference_pattern='material-study-travertine-volume-01|material-study-basalt-plane|material-study-limestone-field|material-study-granite-surface|material-study-slate-line|material-study-porphyry-plane|material-study-tuff-surface'

for route in "${discoverability_routes[@]}"; do
    file="${TMP_DIR}/discoverability_${route//\//_}.html"
    assert_status "$route" 200 "$file"
    assert_absent_pattern "$file" "$detail_reference_pattern" "$route discoverability surface"
    assert_absent_pattern "$file" 'other editions|route-network|route network|route-count|route count|edition directory|edition catalog|browse editions' "$route discoverability surface"
done

step 'canonical storefront transitional containment'
storefront_drift_pattern='data-cart-widget|data-veylune-search|/search\?search=|quiet luxury|collectible furniture|curated artistic living|edition catalog|browse editions'

for route in "${discoverability_routes[@]}"; do
    file="${TMP_DIR}/storefront_${route//\//_}.html"
    assert_status "$route" 200 "$file"
    assert_absent_pattern "$file" "$storefront_drift_pattern" "$route canonical storefront transitional surface"
done

home_file="${TMP_DIR}/storefront_home.html"
assert_status '/' 200 "$home_file"
assert_contains "$home_file" 'href="/legal/privacy" title="More information"' '/ homepage canonical cookie privacy routing'
assert_absent_pattern "$home_file" 'href="[[:space:]]+/' '/ homepage whitespace-prefixed internal routing'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_marketplace-global-control-closure.scss' '.cookie-permission-container' 'global cookie control closure'
