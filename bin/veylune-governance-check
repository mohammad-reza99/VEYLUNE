assert_absent_pattern "$collection_scene_file" 'VLS-FUR-000001|VLS-FUR-000010|__veylune-vision|__veylune-preview' '/collections/founder-selection draft containment'

assert_contains "$object_probe_file" 'data-veylune-object-scene-context="living-room"' 'Object Mode Room scene bridge'
