    assert_contains "$axis_file" 'data-veylune-axis-destination="maker"' "$axis_route Maker continuity"
    assert_contains "$axis_file" 'data-veylune-axis-destination="project"' "$axis_route Project continuity"
    assert_absent_pattern "$axis_file" 'data-veylune-identity-denial|__veylune-preview|__veylune-vision' "$axis_route public axis containment"
done

material_axis_file="${TMP_DIR}/living_index_axis_material.html"
