assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_marketplace-global-control-closure.scss' '.form-control' 'global form control closure'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_marketplace-global-control-closure.scss' '.accordion-button' 'global disclosure control closure'
