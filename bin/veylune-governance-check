# The global marketplace header intentionally owns the cart link. Object content
# remains activation-pending and is checked separately at the template boundary.
assert_absent_pattern "$object_probe_file" 'data-product-id|product-box|add-to-cart|wishlist' '/__veylune-vision/object/F01 commerce containment'

object_denied_file="${TMP_DIR}/living_index_object_denied.html"
assert_status '/objects/VLS-SOF-001' 404 "$object_denied_file"
assert_contains "$object_denied_file" 'data-veylune-identity-denial' '/objects/VLS-SOF-001 fail-closed publication gate'
assert_contains "$object_denied_file" '<meta name="robots" content="noindex,nofollow">' '/objects/VLS-SOF-001 fail-closed indexing gate'

object_template='custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/living-index-object.html.twig'
assert_contains "$object_template" 'application/ld+json' 'Object Mode structured-data contract'
assert_contains "$object_template" "path('frontend.veylune.consultation.page'" 'Object Mode real consultation action'
assert_absent_pattern "$object_template" 'Add to cart|Add to selection|wishlist|checkout/cart' 'Object Mode activation-pending commerce containment'
assert_contains 'custom/plugins/VeyluneTheme/src/Discovery/ProductExposureService.php' "!== 'published'" 'Object Mode explicit publication-state gate'
assert_contains 'custom/plugins/VeyluneTheme/src/Storefront/StorefrontRouteOwnershipPolicy.php' 'SURFACE_OBJECTS' 'Object Mode governed route ownership'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_living-index-object.scss' 'min-height: 48px' 'Object Mode primary touch target'

