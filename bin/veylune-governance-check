assert_contains 'custom/plugins/VeyluneTheme/src/Resources/views/storefront/layout/header/header.html.twig' 'Catalog activation pending' 'header pending destination disclosure'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/views/storefront/layout/header/marketplace-mobile-drawer.html.twig' 'frontend.veylune.preview.catalog.category' 'private mobile category routing'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/views/storefront/layout/header/marketplace-mobile-drawer.html.twig' 'veyluneRoutes.partnership' 'mobile trade routing'
