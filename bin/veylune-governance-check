assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_marketplace-global-control-closure.scss' '.veylune-plp-popover--sort button' 'preview listing dropdown action closure'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_marketplace-global-control-closure.scss' '.veylune-pdp-delivery__control button' 'preview product delivery action closure'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_marketplace-global-control-closure.scss' '.veylune-cart-preview__alert button' 'preview cart recovery action closure'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/views/storefront/page/account/sidebar.html.twig' 'veylune-account-sidebar__marker' 'account sidebar duplicate SVG identity closure'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/views/storefront/page/account/addressbook/address-item.html.twig' "addressItemRole" 'account address role-scoped dropdown identity'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/views/storefront/layout/header/header.html.twig' 'veylunePreviewToken|default' 'preview header token continuity'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/views/storefront/layout/header/mobile-navigation.html.twig' 'veyluneMobilePreviewToken' 'preview mobile navigation token continuity'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/catalog-preview-product.html.twig' "product.department|replace({'_': '-'})" 'preview product department route normalization'

if [[ -n "${VEYLUNE_DRAFT_PREVIEW_TOKEN:-}" ]]; then
    preview_home_file="${TMP_DIR}/private_preview_home.html"
    assert_status "/__veylune-preview/catalog?token=${VEYLUNE_DRAFT_PREVIEW_TOKEN}" 200 "$preview_home_file"

    for preview_record in K01 K02 K04; do
        preview_product_file="${TMP_DIR}/private_preview_product_${preview_record}.html"
        assert_status "/__veylune-preview/catalog/product/${preview_record}?token=${VEYLUNE_DRAFT_PREVIEW_TOKEN}" 200 "$preview_product_file"
    done

    assert_absent_pattern "$preview_home_file" 'href="/__veylune-preview/catalog/(category|collection|room)/[^"?]+"' 'private preview tokenless navigation containment'
fi
assert_contains "$home_file" 'data-veylune-home' '/ homepage transitional surface'
assert_contains "$home_file" 'Online catalog opening soon.' '/ homepage truthful catalog pending disclosure'
assert_contains "$home_file" 'Room collections opening soon.' '/ homepage truthful room pending disclosure'
