assert_contains "$project_axis_file" 'href="/contact-studio?from=consultation"' '/private-consultation contextual non-recursive project action'
assert_contains 'custom/plugins/VeyluneTheme/src/Storefront/StorefrontRouteOwnershipPolicy.php' 'SURFACE_PARTNERSHIPS' 'Maker public route ownership'
assert_contains 'custom/plugins/VeyluneTheme/src/Storefront/StorefrontRouteOwnershipPolicy.php' "frontend.veylune.consultation.page" 'Project public route ownership'
assert_contains 'custom/plugins/VeyluneTheme/src/Sitemap/IdentityUrlProvider.php' "'/editions', 'axis:material'" 'Material sitemap axis'
