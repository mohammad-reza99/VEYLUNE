#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TMP_DIR"' EXIT

DDEV_BIN="${DDEV_BIN:-ddev}"
HOST_HEADER="${VEYLUNE_HOST_HEADER:-veylune-shopware.ddev.site}"
BASE_URL="${VEYLUNE_INTERNAL_BASE_URL:-http://localhost}"

cd "$ROOT_DIR"

step() {
    printf '[veylune-governance] %s\n' "$1"
}

fail() {
    printf '[veylune-governance][FAIL] %s\n' "$1" >&2
    exit 1
}

run_console() {
    if [[ "${VEYLUNE_INSIDE_DDEV:-0}" == '1' ]]; then
        php bin/console "$@"
    else
        "$DDEV_BIN" exec php bin/console "$@"
    fi
}

run_ddev_php() {
    if [[ "${VEYLUNE_INSIDE_DDEV:-0}" == '1' ]]; then
        php "$@"
    else
        "$DDEV_BIN" exec php "$@"
    fi
}

fetch_path() {
    local path="$1"
    local output_file="$2"
    local response
    local status
    local body

    if [[ "${VEYLUNE_INSIDE_DDEV:-0}" == '1' ]]; then
        response="$(curl -sS -H "Host: ${HOST_HEADER}" -H "X-Forwarded-Proto: https" -w $'\n__STATUS__:%{http_code}' "${BASE_URL}${path}")"
    else
        response="$("$DDEV_BIN" exec curl -sS -H "Host: ${HOST_HEADER}" -H "X-Forwarded-Proto: https" -w $'\n__STATUS__:%{http_code}' "${BASE_URL}${path}")"
    fi
    status="${response##*__STATUS__:}"
    body="${response%$'\n'__STATUS__:*}"

    printf '%s' "$body" > "$output_file"
    printf '%s' "$status"
}

assert_status() {
    local path="$1"
    local expected="$2"
    local output_file="$3"
    local status

    status="$(fetch_path "$path" "$output_file")"
    [[ "$status" == "$expected" ]] || fail "$path returned HTTP $status, expected $expected"
}

assert_contains() {
    local file="$1"
    local needle="$2"
    local label="$3"

    grep -Fq "$needle" "$file" || fail "$label did not contain required marker: $needle"
}

assert_absent_pattern() {
    local file="$1"
    local pattern="$2"
    local label="$3"

    if grep -Eiq "$pattern" "$file"; then
        fail "$label exposed blocked public language matching: $pattern"
    fi
}

assert_single_main() {
    local file="$1"
    local label="$2"
    local count

    count="$(awk 'BEGIN { count = 0 } { line = $0; while (match(line, /<main([[:space:]>])/)) { count++; line = substr(line, RSTART + RLENGTH) } } END { print count }' "$file")"
    [[ "$count" == '1' ]] || fail "$label rendered $count main landmarks, expected exactly 1"
}

step 'syntax checks'
bash -n bin/veylune-governance-check
while IFS= read -r -d '' file; do
    php -l "$file" >/dev/null
done < <(find custom/plugins/VeyluneTheme/src custom/plugins/VeyluneTheme/bin -name '*.php' -print0)
php -l bin/console >/dev/null

step 'container lint'
run_console lint:container >/dev/null

step 'governance command audits'
run_console veylune:semantic:audit >/dev/null
run_console veylune:semantic:authoring-audit >/dev/null
run_console veylune:runtime:distributed-audit >/dev/null
run_console veylune:runtime:topology-pressure-audit >/dev/null
run_console veylune:publication-state:audit >/dev/null
run_console veylune:sitemap:audit >/dev/null

step 'semantic and authoring regression harness'
run_ddev_php custom/plugins/VeyluneTheme/bin/governance-regression-check.php >/dev/null

step 'audit determinism'
for command in \
    'veylune:semantic:audit' \
    'veylune:semantic:authoring-audit' \
    'veylune:runtime:distributed-audit' \
    'veylune:runtime:topology-pressure-audit' \
    'veylune:publication-state:audit' \
    'veylune:sitemap:audit'
do
    safe_name="${command//:/_}"
    previous_file=''

    for run in 1 2 3; do
        output_file="${TMP_DIR}/${safe_name}_${run}.out"
        run_console "$command" > "$output_file"

        if [[ -n "$previous_file" ]] && ! cmp -s "$previous_file" "$output_file"; then
            fail "$command output was not deterministic across repeated runs"
        fi

        previous_file="$output_file"
    done
done

public_diagnostics='route-network|route-count|topology|audit|classification|rollback|authoring|approval|semantic maturity|diagnostic|x-debug-token|governance diagnostics'
commerce_surfaces='add-to-cart|buy-widget|product-detail|cms-element-product|line-item|checkout|cart-widget|price-unit|purchase|relationship|recommend|recommended|collection|reserve|inquire'
adjacency_surfaces='next|previous|related|featured|grouped|other editions|route network|route count|one of [0-9]+|[0-9]+ routes|[0-9]+ editions'

step 'runtime route regression'
approved_routes=(
    '/editions/material-study-travertine-volume-01'
    '/de/editionen/material-study-travertine-volume-01'
    '/editions/material-study-basalt-plane'
    '/de/editionen/material-study-basalt-plane'
)

for route in "${approved_routes[@]}"; do
    file="${TMP_DIR}/approved_${route//\//_}.html"
    assert_status "$route" 200 "$file"
    assert_contains "$file" 'data-veylune-edition-detail-skeleton' "$route"
    assert_absent_pattern "$file" "$public_diagnostics" "$route"
    assert_absent_pattern "$file" "$commerce_surfaces" "$route"
    assert_absent_pattern "$file" "$adjacency_surfaces" "$route"
done

denied_routes=(
    '/editions/not-approved'
    '/editions/Bad_Reference'
    '/editions/material-study-basalt-plane-02'
    '/editionen/material-study-basalt-plane'
    '/editions/material-study-limestone-field'
)

for route in "${denied_routes[@]}"; do
    file="${TMP_DIR}/denied_${route//\//_}.html"
    assert_status "$route" 404 "$file"
    if [[ -s "$file" ]]; then
        assert_absent_pattern "$file" "$public_diagnostics|exception|stack trace|traceable|debug" "$route denied body"
    fi
done

step 'browser-surface verification'
for route in "${approved_routes[@]}"; do
    file="${TMP_DIR}/browser_${route//\//_}.html"
    assert_status "$route" 200 "$file"
    assert_contains "$file" '<!DOCTYPE html>' "$route browser surface"
    assert_contains "$file" '<div class="veylune-edition-skeleton"' "$route browser surface"
    assert_contains "$file" '<meta name="robots" content="noindex,nofollow">' "$route browser surface"
    assert_absent_pattern "$file" 'other editions|recommended alongside|paired with|browse|edition catalog|route-network|route network|topology|semanticRiskClassification|x-debug-token' "$route browser surface"
done

step 'phase 8 storefront hardening'
optimized_asset_dir='custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/assets'
optimized_asset_count="$(find "$optimized_asset_dir" -maxdepth 1 -type f -name 'veylune-*.webp' | wc -l | tr -d ' ')"
optimized_asset_bytes="$(find "$optimized_asset_dir" -maxdepth 1 -type f -name 'veylune-*.webp' -printf '%s\n' | awk '{ total += $1 } END { print total + 0 }')"
[[ "$optimized_asset_count" -ge 13 ]] || fail "optimized storefront asset set has $optimized_asset_count WebP files, expected at least 13"
[[ "$optimized_asset_bytes" -le 2500000 ]] || fail "optimized storefront asset set is ${optimized_asset_bytes} bytes, budget is 2500000"
if grep -REq --include='*.scss' --include='*.twig' 'veylune-(category|room|promo)-[^[:space:]]+\.png' custom/plugins/VeyluneTheme/src/Resources/app/storefront/src custom/plugins/VeyluneTheme/src/Resources/views/storefront; then
    fail 'optimized storefront surfaces reintroduced a legacy PNG reference'
fi

assert_contains '.ddev/nginx_full/nginx-site.conf' 'public, max-age=31536000, immutable' 'immutable theme asset cache policy'
assert_absent_pattern '.ddev/nginx_full/nginx-site.conf' '^#ddev-generated$' 'custom nginx ownership marker'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/base/_foundation.scss' 'animation-duration: 0.01ms !important' 'global reduced-motion fallback'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/base/_foundation.scss' 'transition-duration: 0.01ms !important' 'global reduced-motion fallback'

hardening_routes=(
    '/'
    '/account/login'
    '/__veylune-preview/catalog/category/furniture?token=wp-des-cat-01-8f46c2d19a'
    '/__veylune-preview/catalog/product/F03?token=wp-des-cat-01-8f46c2d19a'
    '/__veylune-preview/account?token=wp-des-cat-01-8f46c2d19a'
    '/__veylune-preview/checkout?token=wp-des-cat-01-8f46c2d19a'
)

for route in "${hardening_routes[@]}"; do
    file="${TMP_DIR}/hardening_$(printf '%s' "$route" | tr '/?=&' '____').html"
    assert_status "$route" 200 "$file"
    assert_single_main "$file" "$route hardening surface"
    assert_contains "$file" '<h1' "$route hardening surface"
done

assert_contains "${TMP_DIR}/hardening__.html" 'content="index,follow"' '/ public robots policy'
assert_contains "${TMP_DIR}/hardening__.html" '<link rel="canonical" href="https://veylune-shopware.ddev.site/">' '/ public canonical URL'
assert_contains "${TMP_DIR}/hardening__.html" 'content="summary_large_image"' '/ public Twitter card policy'
assert_contains "${TMP_DIR}/hardening__.html" 'veylune-home-hero-architectural-warm-v1.webp' '/ public social image policy'
assert_contains "${TMP_DIR}/hardening__.html" 'rel="preload"' '/ public critical resource preload policy'
assert_contains "${TMP_DIR}/hardening__.html" 'fetchpriority="high"' '/ public LCP priority policy'
assert_contains "${TMP_DIR}/hardening__.html" 'Inter-Variable-Roman-Latin.woff2' '/ public critical font preload policy'
assert_contains "${TMP_DIR}/hardening__.html" '"@type": "WebSite"' '/ public WebSite schema'
assert_contains "${TMP_DIR}/hardening__.html" '"@type": "Organization"' '/ public Organization schema'
assert_contains "${TMP_DIR}/hardening__.html" '"@type": "CollectionPage"' '/ public CollectionPage schema'
assert_contains "${TMP_DIR}/hardening__.html" '"name": "Veylune Studio"' '/ public organization identity'
assert_contains "${TMP_DIR}/hardening__account_login.html" 'content="noindex,follow"' '/account/login robots policy'
assert_absent_pattern "${TMP_DIR}/hardening__account_login.html" 'application/ld\+json' '/account/login structured-data containment'
for file in "${TMP_DIR}"/hardening____veylune-preview_*.html; do
    assert_contains "$file" 'content="noindex,nofollow,noarchive,nosnippet"' 'private preview robots policy'
    assert_absent_pattern "$file" 'application/ld\+json' 'private preview structured-data containment'
done

invalid_preview_file="${TMP_DIR}/hardening_invalid_preview.html"
assert_status '/__veylune-preview/account?token=invalid' 404 "$invalid_preview_file"
invalid_product_file="${TMP_DIR}/hardening_invalid_product.html"
assert_status '/__veylune-preview/catalog/product/not-real?token=wp-des-cat-01-8f46c2d19a' 404 "$invalid_product_file"

step 'phase 9 reference gap closure'
legacy_consultation_file="${TMP_DIR}/phase9_legacy_consultation.html"
assert_status '/consultation' 301 "$legacy_consultation_file"

for legacy_cms_route in \
    '/page/cms/019e3bf907a971b3a48974fb8e7f7fbe' \
    '/page/cms/019e3bf90c8271f2ab585548d3e747f9' \
    '/page/cms/019e3bf90c7f7226a8cb32e3f0ceac6b'
do
    legacy_cms_file="${TMP_DIR}/phase9_legacy_cms_${legacy_cms_route##*/}.html"
    assert_status "$legacy_cms_route" 301 "$legacy_cms_file"
done

partnership_file="${TMP_DIR}/phase9_partnership.html"
assert_status '/atelier-partnerships' 200 "$partnership_file"
assert_contains "$partnership_file" 'href="/atelier-partnerships"' 'partnership trade self-route'
assert_absent_pattern "$partnership_file" '/search\?search=trade' 'partnership dead trade route removal'

assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_marketplace-header-reference-refinement.scss' 'grid-template-rows: 60px 74px' 'reference-aligned header height'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_marketplace-header-premium-polish.scss' 'grid-template-columns: 227px minmax(500px, 1fr) 308px' 'reference-aligned desktop search width'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_marketplace-plp-discovery.scss' 'grid-template-columns: repeat(4, minmax(0, 1fr))' 'reference-aligned PLP category grid'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_marketplace-plp-discovery.scss' 'font-size: 2rem' 'reference-aligned PLP title scale'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_marketplace-pdp-wayfair-alignment.scss' 'grid-template-columns: minmax(0, 0.98fr) minmax(0, 1fr)' 'reference-aligned PDP columns'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_marketplace-pdp-wayfair-alignment.scss' 'width: min(calc(100% - 10px), 1600px)' 'reference-aligned PDP canvas'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_marketplace-phase-9-mobile-closure.scss' '.veylune-pdp-gallery__support' 'mobile PDP gallery support-image containment'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_marketplace-phase-9-mobile-closure.scss' 'display: none' 'mobile PDP gallery single-stage rule'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_marketplace-phase-9-mobile-closure.scss' 'font-size: clamp(2.35rem, 11vw, 2.7rem)' 'mobile homepage hero scale'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_marketplace-phase-9-commerce-closure.scss' '.veylune-cart-preview__header h1' 'reference-scaled cart title'
