assert_contains 'custom/plugins/VeyluneTheme/src/Sitemap/IdentityUrlProvider.php' "'/collections/founder-selection'" 'Collection sitemap identity path'
assert_contains 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_living-index-discovery.scss' 'min-height: 190px' 'Scene path touch target'

