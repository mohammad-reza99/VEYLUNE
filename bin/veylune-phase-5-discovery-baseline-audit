#!/usr/bin/env php
<?php

declare(strict_types=1);

$root = dirname(__DIR__);
$contractPath = $root . '/config/veylune-route-unification-contract.json';

function phase5Require(bool $condition, string $message): void
{
    if (!$condition) {
        throw new RuntimeException($message);
    }
}

function phase5Read(string $root, string $relativePath): string
{
    $path = $root . '/' . $relativePath;
    phase5Require(is_file($path), 'Required source is missing: ' . $relativePath);

    return (string) file_get_contents($path);
}

try {
    phase5Require(is_file($contractPath), 'Canonical route-unification contract is missing.');
    $contract = json_decode((string) file_get_contents($contractPath), true, 512, JSON_THROW_ON_ERROR);
    phase5Require(is_array($contract), 'Canonical route-unification contract must be an object.');
    phase5Require(($contract['schemaVersion'] ?? null) === '1.0', 'Unexpected route-unification schema version.');
    phase5Require(($contract['policy'] ?? null) === 'one public catalog, native cart, isolated token preview', 'Canonical route policy drifted.');

    $canonicalRoutes = $contract['canonicalRoutes'] ?? [];
    $aliases = $contract['aliases'] ?? [];
    phase5Require(is_array($canonicalRoutes) && count($canonicalRoutes) === 15, 'Exactly 15 representative canonical routes are required.');
    phase5Require(is_array($aliases) && count($aliases) >= 29, 'The compatibility alias matrix is incomplete.');
    phase5Require(count($canonicalRoutes) === count(array_unique($canonicalRoutes)), 'Canonical route paths must be unique.');

    foreach ($canonicalRoutes as $route) {
        phase5Require(is_string($route) && str_starts_with($route, '/'), 'Canonical route paths must be absolute.');
        phase5Require(!preg_match('#^/(categories|rooms|collections|discover|selection)(?:/|\?|$)#', $route), 'A legacy path remains canonical: ' . $route);
    }

    $aliasPaths = [];
    foreach ($aliases as $alias) {
        phase5Require(is_array($alias), 'Every alias must be an object.');
        $path = $alias['path'] ?? null;
        $location = $alias['location'] ?? null;
        $status = $alias['status'] ?? null;
        phase5Require(is_string($path) && str_starts_with($path, '/'), 'Alias path must be absolute.');
        phase5Require(is_string($location) && str_starts_with($location, '/'), 'Alias destination must be absolute.');
        phase5Require(in_array($status, [301, 303], true), 'Alias status must be permanent or see-other.');
        phase5Require(!isset($aliasPaths[$path]), 'Duplicate alias path: ' . $path);
        $aliasPaths[$path] = true;
    }

    $sourceMarkers = [
        'custom/plugins/VeyluneTheme/src/Controller/DraftCatalogPreviewController.php' => [
            "name: 'frontend.veylune.catalog.home'",
            "name: 'frontend.veylune.catalog.search'",
            "name: 'frontend.veylune.preview.catalog.home'",
        ],
        'custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/catalog-preview-destination.html.twig' => [
            'discovery-listing.html.twig',
            "veyluneCatalogRouteMode|default('preview') == 'public'",
        ],
        'custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/catalog-preview-card.html.twig' => [
            'discovery-product-card.html.twig',
        ],
        'custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/discovery-listing.html.twig' => [
            'data-discovery-listing',
            'data-veylune-plp',
        ],
        'custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/discovery-product-card.html.twig' => [
            'data-discovery-card-kind="product"',
        ],
        'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/js/veylune-plp-v2.js' => [
            '[data-veylune-plp]',
            "addEventListener('pointerleave'",
            "addEventListener('popstate'",
        ],
        'custom/plugins/VeyluneTheme/src/Resources/views/storefront/layout/header/header.html.twig' => [
            "veyluneHeaderSearchRoute = 'frontend.veylune.catalog.search'",
        ],
    ];

    foreach ($sourceMarkers as $relativePath => $markers) {
        $source = phase5Read($root, $relativePath);
        foreach ($markers as $marker) {
            phase5Require(str_contains($source, $marker), sprintf('Marker %s is missing from %s.', $marker, $relativePath));
        }
    }

    foreach ([
        'custom/plugins/VeyluneTheme/src/Controller/DiscoveryDestinationController.php',
        'custom/plugins/VeyluneTheme/src/Controller/LivingIndexUtilityController.php',
    ] as $relativePath) {
        $source = phase5Read($root, $relativePath);
        phase5Require(str_contains($source, 'redirectToRoute('), 'Compatibility controller lost its redirect boundary: ' . $relativePath);
        phase5Require(!str_contains($source, 'renderStorefront('), 'Compatibility controller renders a competing storefront: ' . $relativePath);
    }

    $retiredFiles = [
        'living-index-home.html.twig',
        '_living-index-home-foundation.scss',
        'discovery-destination.html.twig',
        'living-index-discovery.html.twig',
        'living-index-search.html.twig',
        'living-index-search-results.html.twig',
        'living-index-selection.html.twig',
        '_living-index-discovery.scss',
        '_living-index-search-selection.scss',
        '_living-index-wayfair-parity.scss',
    ];
    foreach ($retiredFiles as $file) {
        phase5Require(is_file($root . '/docs/archive/wave2-retired/' . $file), 'Retired source archive is missing: ' . $file);
    }

    phase5Require(!is_file($root . '/custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/living-index-home.html.twig'), 'Legacy homepage template is still active.');
    phase5Require(!is_file($root . '/custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/scss/component/_living-index-home-foundation.scss'), 'Legacy homepage foundation is still active.');
    phase5Require(!is_file($root . '/custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/living-index-discovery.html.twig'), 'Legacy discovery template is still active.');
    phase5Require(!is_file($root . '/custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/living-index-search.html.twig'), 'Legacy search template is still active.');
    phase5Require(!is_file($root . '/custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/living-index-selection.html.twig'), 'Legacy selection template is still active.');

    printf(
        "Phase 5 canonical discovery baseline audit passed: %d canonical routes, %d compatibility aliases, one shared catalog implementation, and %d archived retired sources.\n",
        count($canonicalRoutes),
        count($aliases),
        count($retiredFiles),
    );
} catch (Throwable $error) {
    fwrite(STDERR, 'Phase 5 canonical discovery baseline audit failed: ' . $error->getMessage() . PHP_EOL);
    exit(1);
}
