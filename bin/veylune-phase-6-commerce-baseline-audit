#!/usr/bin/env php
<?php declare(strict_types=1);

$root = dirname(__DIR__);
$fail = static function (string $message): never {
    fwrite(STDERR, 'Phase 6.1A commerce baseline audit failed: ' . $message . PHP_EOL);
    exit(1);
};
$readJson = static function (string $relative) use ($root, $fail): array {
    $path = $root . '/' . $relative;
    if (!is_file($path)) {
        $fail('Missing file: ' . $relative);
    }
    try {
        $decoded = json_decode((string) file_get_contents($path), true, 512, JSON_THROW_ON_ERROR);
    } catch (Throwable $error) {
        $fail('Invalid JSON in ' . $relative . ': ' . $error->getMessage());
    }
    if (!is_array($decoded)) {
        $fail('JSON root must be an object: ' . $relative);
    }

    return $decoded;
};
$require = static function (bool $condition, string $message) use ($fail): void {
    if (!$condition) {
        $fail($message);
    }
};

$contract = $readJson('config/veylune-phase-6-commerce-baseline-contract.json');
$reportPath = $contract['report'] ?? '';
$require(is_string($reportPath) && $reportPath !== '', 'Report path is missing from the contract.');
$report = $readJson($reportPath);

$require(($contract['workPackage'] ?? null) === '6.1A', 'Contract work package must be 6.1A.');
$require(($report['workPackage'] ?? null) === '6.1A', 'Report work package must be 6.1A.');
$expected = $contract['expected'] ?? [];
$summary = $report['summary'] ?? [];
foreach ($expected as $metric => $value) {
    $require(array_key_exists($metric, $summary), sprintf('Summary metric is missing: %s.', $metric));
    $require($summary[$metric] === $value, sprintf('Metric %s expected %s, got %s.', $metric, json_encode($value), json_encode($summary[$metric])));
}

$inventory = $report['productInventory'] ?? [];
$require(count($inventory) === 50, 'Product inventory must contain 50 records.');
$require(count(array_unique(array_column($inventory, 'recordId'))) === 50, 'Product record IDs must be unique.');
$require(count(array_unique(array_column($inventory, 'databaseProductId'))) === 50, 'Database product IDs must be unique.');
$require(count(array_filter($inventory, static fn (array $item): bool => ($item['governedCover'] ?? false) === true)) === 50, 'All products must retain a governed Admin cover.');
$require(count(array_filter($inventory, static fn (array $item): bool => ($item['launchApproved'] ?? true) === true)) === 0, 'No draft product may be represented as launch-approved.');

$surfaces = $report['surfaces'] ?? [];
$require(count($surfaces) === 192, 'Surface inventory must contain 192 entries.');
foreach ($surfaces as $surface) {
    $require(($surface['statusPass'] ?? false) === true, sprintf('Status expectation failed for %s at %s.', $surface['route'] ?? 'unknown', $surface['viewport'] ?? 'unknown'));
    $require(($surface['finalPathPass'] ?? false) === true, sprintf('Redirect boundary failed for %s at %s.', $surface['route'] ?? 'unknown', $surface['viewport'] ?? 'unknown'));
    $require(($surface['markerPass'] ?? false) === true, sprintf('Surface marker failed for %s at %s.', $surface['route'] ?? 'unknown', $surface['viewport'] ?? 'unknown'));
    $require(($surface['accessibilityPass'] ?? false) === true, sprintf('Accessibility baseline failed for %s at %s.', $surface['route'] ?? 'unknown', $surface['viewport'] ?? 'unknown'));
}

$privatePdpSurfaces = array_values(array_filter($surfaces, static fn (array $item): bool => ($item['scope'] ?? '') === 'private-pdp'));
$pdpCounts = [];
foreach ($privatePdpSurfaces as $surface) {
    if (preg_match('~/product/([A-Z][0-9]{2})$~', (string) ($surface['route'] ?? ''), $match) === 1) {
        $pdpCounts[$match[1]] = ($pdpCounts[$match[1]] ?? 0) + 1;
    }
    $require(($surface['computed']['privatePdp'] ?? false) === true, 'Private PDP root is missing.');
    $require(($surface['computed']['galleryImages'] ?? 0) > 0, 'Private PDP rendered without semantic gallery media.');
    $require(($surface['computed']['noVerifiedReviewsCopy'] ?? false) === true, 'Private PDP review state is not truthful.');
}
$require(count($pdpCounts) === 50, 'All 50 private PDP identities must be captured.');
$require(count(array_filter($pdpCounts, static fn (int $count): bool => $count !== 3)) === 0, 'Every private PDP must have desktop, tablet and mobile captures.');

$interactions = $report['privatePdpInteractions'] ?? [];
$require(count($interactions) === 100, 'Expected 100 private PDP interaction scenarios.');
$interactionCounts = array_count_values(array_column($interactions, 'recordId'));
$require(count($interactionCounts) === 50, 'Interaction coverage must include all 50 private PDPs.');
$require(count(array_filter($interactionCounts, static fn (int $count): bool => $count !== 2)) === 0, 'Every private PDP must pass desktop and mobile interaction scenarios.');
$require(count(array_filter($interactions, static fn (array $item): bool => ($item['pass'] ?? false) !== true)) === 0, 'A private PDP interaction scenario failed.');

$journeys = $report['privateJourneyScenarios'] ?? [];
$require(count($journeys) === 3, 'Expected three private cart-to-checkout journey scenarios.');
$require(count(array_filter($journeys, static fn (array $item): bool => ($item['pass'] ?? false) !== true)) === 0, 'A private cart-to-checkout journey scenario failed.');

$publicBoundaries = $report['publicProductBoundaries'] ?? [];
$require(count($publicBoundaries) === 50, 'Expected 50 public product boundary checks.');
$require(count(array_filter($publicBoundaries, static fn (array $item): bool => ($item['pass'] ?? false) !== true)) === 0, 'A draft product crossed the public publication boundary.');

$privateBoundaries = $report['unauthorizedPrivateRoutes'] ?? [];
$require(count($privateBoundaries) === 53, 'Expected 53 unauthorized private-route checks.');
$require(count(array_filter($privateBoundaries, static fn (array $item): bool => ($item['pass'] ?? false) !== true)) === 0, 'A private commerce route was available without its token.');

$gaps = $report['knownGaps'] ?? [];
$require(count($gaps) === 7, 'Exactly seven evidence-backed Phase 6 unification gaps must be registered.');
$require(count(array_unique(array_column($gaps, 'id'))) === 7, 'Gap IDs must be unique.');

$evidenceDirectory = $contract['evidenceDirectory'] ?? '';
$screenshots = glob($root . '/' . $evidenceDirectory . '/*.png') ?: [];
$require(count($screenshots) === 192, sprintf('Expected 192 screenshots, found %d.', count($screenshots)));

$sourceMarkers = [
    'custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/catalog-preview-product.html.twig' => 'data-veylune-pdp-preview',
    'custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/catalog-preview-product-commerce.html.twig' => 'data-pdp-add-selection',
    'custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/catalog-preview-product-information.html.twig' => 'No verified reviews yet',
    'custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/catalog-preview-cart.html.twig' => 'data-veylune-cart-preview',
    'custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/catalog-preview-checkout.html.twig' => 'data-veylune-checkout-preview',
    'custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/catalog-preview-account.html.twig' => 'data-veylune-account-preview',
    'custom/plugins/VeyluneTheme/src/Resources/views/storefront/page/content/product-detail.html.twig' => 'data-veylune-commerce-posture',
    'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/js/veylune-pdp-preview.js' => 'upsertSelectionItem',
    'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/js/veylune-preview-cart-page.js' => 'hydrateSelectionMedia',
    'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/js/veylune-preview-checkout.js' => 'dialog.showModal()',
];
foreach ($sourceMarkers as $relative => $marker) {
    $source = $root . '/' . $relative;
    $require(is_file($source), 'Commerce source is missing: ' . $relative);
    $require(str_contains((string) file_get_contents($source), $marker), 'Commerce marker is missing from ' . $relative . ': ' . $marker);
}

printf(
    "Phase 6.1A commerce baseline audit passed: %d products, %d surfaces, %d PDP interactions, %d journey scenarios, %d boundary checks, %d screenshots, %d registered gaps.\n",
    count($inventory),
    count($surfaces),
    count($interactions),
    count($journeys),
    count($publicBoundaries) + count($privateBoundaries),
    count($screenshots),
    count($gaps),
);
