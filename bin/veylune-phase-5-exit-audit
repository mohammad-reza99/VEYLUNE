#!/usr/bin/env php
<?php

declare(strict_types=1);

$root = dirname(__DIR__);

function phase5ExitRequire(bool $condition, string $message): void
{
    if (!$condition) {
        throw new RuntimeException($message);
    }
}

function phase5ExitRead(string $root, string $relativePath): string
{
    $path = $root . '/' . $relativePath;
    phase5ExitRequire(is_file($path), 'Required Phase 5 exit source is missing: ' . $relativePath);

    return (string) file_get_contents($path);
}

try {
    $contract = json_decode(
        phase5ExitRead($root, 'config/veylune-route-unification-contract.json'),
        true,
        512,
        JSON_THROW_ON_ERROR,
    );
    phase5ExitRequire(is_array($contract), 'Route-unification contract must decode to an object.');

    $canonicalRoutes = $contract['canonicalRoutes'] ?? [];
    $aliases = $contract['aliases'] ?? [];
    $preview = $contract['privatePreview'] ?? [];
    phase5ExitRequire(count($canonicalRoutes) === 15, 'Canonical route representative matrix is incomplete.');
    phase5ExitRequire(count($aliases) >= 29, 'Compatibility alias matrix is incomplete.');
    phase5ExitRequire(($preview['unauthorizedStatus'] ?? null) === 404, 'Unauthorized preview must stay fail-closed.');
    phase5ExitRequire(($preview['requiredHeaders']['cache-control'] ?? null) === 'no-store', 'Preview no-store boundary is missing.');
    phase5ExitRequire(($preview['requiredHeaders']['x-robots-tag'] ?? null) === 'noindex', 'Preview noindex boundary is missing.');

    $listingEngine = phase5ExitRead($root, 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/js/veylune-plp-v2.js');
    $headerEngine = phase5ExitRead($root, 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/js/veylune-header.js');
    $selectionState = phase5ExitRead($root, 'custom/plugins/VeyluneTheme/src/Resources/app/storefront/src/js/veylune-living-index-state.js');
    $resolver = phase5ExitRead($root, 'custom/plugins/VeyluneTheme/src/Discovery/EditorialMediaResolver.php');
    $sharedListing = phase5ExitRead($root, 'custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/discovery-listing.html.twig');
    $sharedCard = phase5ExitRead($root, 'custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/discovery-product-card.html.twig');
    $destination = phase5ExitRead($root, 'custom/plugins/VeyluneTheme/src/Resources/views/storefront/veylune/catalog-preview-destination.html.twig');
    $routeSmoke = phase5ExitRead($root, 'tools/audit/veylune-route-unification-smoke.cjs');
    $sourceSmoke = phase5ExitRead($root, 'tools/audit/veylune-active-source-contract.cjs');

    phase5ExitRequire(str_contains($sharedListing, 'data-discovery-listing'), 'Shared listing contract is missing.');
    phase5ExitRequire(str_contains($sharedCard, 'data-discovery-card-kind="product"'), 'Shared product-card contract is missing.');
    phase5ExitRequire(str_contains($destination, "veyluneCatalogRouteMode|default('preview') == 'public'"), 'Public/private route mode boundary is missing.');
    phase5ExitRequire(str_contains($listingEngine, "addEventListener('pointerleave'"), 'Filter/sort pointer-leave dismissal is missing.');
    phase5ExitRequire(str_contains($listingEngine, "addEventListener('popstate'"), 'Back/forward listing-state restoration is missing.');
    phase5ExitRequire(str_contains($headerEngine, "addEventListener('mouseleave'"), 'Header suggestion mouse-leave dismissal is missing.');
    phase5ExitRequire(str_contains($headerEngine, "event.key !== 'Escape'"), 'Header Escape dismissal is missing.');
    phase5ExitRequire(str_contains($selectionState, "pathname.includes('/media/')"), 'Admin media is not accepted by saved-context state.');
    phase5ExitRequire(str_contains($resolver, "'shopware_admin_media'"), 'Admin editorial-media resolution is missing.');

    foreach ([
        'canonicalRoutes',
        'aliases',
        'privatePreview',
        'legacyInternalLink',
        'cache-control',
        'x-robots-tag',
    ] as $marker) {
        phase5ExitRequire(str_contains($routeSmoke, $marker), 'Runtime route smoke lost marker: ' . $marker);
    }
    foreach ([
        'retiredActiveFiles',
        'forbiddenLegacyRouteReferences',
        'Compatibility controller renders a competing UI',
        'SCSS imports do not resolve',
        'JavaScript imports do not resolve',
    ] as $marker) {
        phase5ExitRequire(str_contains($sourceSmoke, $marker), 'Active-source smoke lost marker: ' . $marker);
    }

    printf(
        "Phase 5 canonical exit audit passed: %d routes, %d aliases, shared listing/card ownership, isolated preview, interaction dismissal, and active-source regression guards.\n",
        count($canonicalRoutes),
        count($aliases),
    );
} catch (Throwable $error) {
    fwrite(STDERR, 'Phase 5 canonical exit audit failed: ' . $error->getMessage() . PHP_EOL);
    exit(1);
}
