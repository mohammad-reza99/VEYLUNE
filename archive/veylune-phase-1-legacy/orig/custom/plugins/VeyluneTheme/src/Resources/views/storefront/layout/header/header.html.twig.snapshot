{% sw_extends '@Storefront/storefront/layout/header/header.html.twig' %}

{% block layout_header %}
	{% import '@VeyluneTheme/storefront/veylune/category-routes.html.twig' as veyluneCategoryRoutes %}
    {% set publicSurfaces = veylunePublicSurfaces|default({}) %}
	{% set veyluneRoutes = {
        shop: veyluneCategoryRoutes.url('furniture'),
        rooms: veyluneCategoryRoutes.url('livingRoom'),
        collections: veyluneCategoryRoutes.url('founderSelection'),
        editions: path(app.request.locale starts with 'de' ? 'frontend.veylune.editions.page.de' : 'frontend.veylune.editions.page'),
        consultation: veyluneCategoryRoutes.url('consultation')
    } %}
    {% set veyluneNavigationRegistry = [
        {
            key: 'shop',
            label: 'veylune.header.nav.shop',
            url: veyluneRoutes.shop,
            mega: 'shop',
            desktop: publicSurfaces['category:furniture']|default(false),
            mobile: publicSurfaces['category:furniture']|default(false)
        },
        {
            key: 'rooms',
            label: 'veylune.header.nav.rooms',
            url: veyluneRoutes.rooms,
            mega: 'rooms',
            desktop: publicSurfaces['room:living-room']|default(false),
            mobile: publicSurfaces['room:living-room']|default(false)
        },
        {
            key: 'collections',
            label: 'veylune.header.nav.collections',
            url: veyluneRoutes.collections,
            mega: 'collections',
            desktop: publicSurfaces['collection:founder-selection']|default(false),
            mobile: publicSurfaces['collection:founder-selection']|default(false)
        },
        {
            key: 'editions',
            label: 'veylune.header.nav.journal',
            url: veyluneRoutes.editions,
            mega: null,
            desktop: true,
            mobile: true
        },
        {
            key: 'consultation',
            label: 'veylune.header.nav.consultation',
            url: veyluneRoutes.consultation,
            mega: null,
            desktop: true,
            mobile: true
        }
    ] %}
    {% set veyluneMegaCategories = [
        { key: 'furniture', label: 'veylune.home.discovery.categories.furniture', url: veyluneCategoryRoutes.url('furniture') }
    ] %}
    {% set veyluneMegaRooms = [
        { key: 'living-room', label: 'veylune.home.discovery.rooms.livingRoom', url: veyluneCategoryRoutes.url('livingRoom') },
        { key: 'dining-room', label: 'veylune.home.discovery.rooms.diningRoom', url: veyluneCategoryRoutes.url('diningRoom') }
    ] %}
    {% set veyluneMegaCollections = [
        { key: 'founder-selection', label: 'veylune.home.discovery.collections.founderSelection', url: veyluneCategoryRoutes.url('founderSelection') },
        { key: 'new-arrivals', label: 'veylune.home.discovery.collections.newArrivals', url: veyluneCategoryRoutes.url('newArrivals') }
    ] %}
    {% set veyluneMarketplaceDepartments = [
        'Verified',
        'New Arrivals',
        'Best Sellers',
        'Trending',
        'Collaborations',
        'Shop by Room',
        'Design Services',
        'Inspiration',
        'Services',
        'Furniture',
        'Outdoor',
        'Bedding & Bath',
        'Mattresses',
        'Rugs',
        'Decor & Pillows',
        'Lighting',
        'Organization',
        'Sale'
    ] %}

	<header class="veylune-header" data-veylune-header>
		{% block layout_header_navigation %}
            <div class="veylune-marketplace-utility" aria-label="Store services">
                <div class="veylune-marketplace-utility__inner">
                    <div class="veylune-marketplace-family" aria-label="Veylune family">
                        <a class="veylune-marketplace-family__primary" href="{{ path('frontend.home.page') }}">Veylune</a>
                        <a href="{{ veyluneRoutes.editions }}">Editions</a>
                        <a href="{{ veyluneRoutes.editions }}">Journal</a>
                        <a href="{{ veyluneRoutes.consultation }}">Trade</a>
                    </div>
                    <div class="veylune-marketplace-utility__right">
                        <nav class="veylune-marketplace-utility__links" aria-label="Programs and services">
                            <span>Rewards</span>
                            <span>Financing</span>
                            <a href="{{ veyluneRoutes.consultation }}">Professional</a>
                        </nav>
                        <span class="veylune-marketplace-utility__shipping">Fast & free delivery on eligible orders</span>
                    </div>
                </div>
            </div>
			<div class="veylune-header__bar">
				<div class="veylune-header__inner">

					<div class="veylune-header__mobile-toggle">
						{% block layout_header_navigation_toggle %}
							<button class="veylune-header__icon-button nav-main-toggle-btn header-actions-btn" type="button" data-veylune-mobile-toggle aria-expanded="false" aria-controls="veyluneMobileNav" aria-label="{{ 'general.menuLink'|trans|striptags }}">
								{% sw_icon 'stack' %}
							</button>
						{% endblock %}
					</div>

					{% block layout_header_logo %}
						<a class="veylune-header__logo" href="{{ path('frontend.home.page') }}" aria-label="{{ 'header.logoLink'|trans|striptags }}">
							<span class="veylune-header__logo-main">
								{% if theme_config('sw-logo-desktop') %}
									<img src="{{ theme_config('sw-logo-desktop')|sw_encode_url }}" alt="{{ 'veylune.header.logoAlt'|trans|striptags }}" class="veylune-header__logo-image">
								{% else %}
									{{ 'veylune.header.logoText'|trans|sw_sanitize }}
								{% endif %}
							</span>
						</a>
					{% endblock %}

                    <div class="veylune-marketplace-search" role="search">
                        <form class="veylune-marketplace-search__form" action="{{ path('frontend.search.page') }}" method="get" data-search-form>
                            <label class="visually-hidden" for="veyluneMarketplaceSearch">{{ 'header.searchPlaceholder'|trans|striptags }}</label>
                            <input id="veyluneMarketplaceSearch"
                                   class="veylune-marketplace-search__input"
                                   type="search"
                                   name="search"
                                   autocomplete="off"
                                   placeholder="Find anything home..."
                                   aria-label="{{ 'header.searchPlaceholder'|trans|striptags }}">
                            <button class="veylune-marketplace-search__submit" type="submit" aria-label="{{ 'header.searchButton'|trans|striptags }}">{% sw_icon 'search' %}</button>
                        </form>
                    </div>
					<nav class="veylune-header__nav" id="veylunePrimaryNavigation" aria-label="{{ 'veylune.header.primaryNavAriaLabel'|trans|striptags }}">
                        {% for department in veyluneMarketplaceDepartments %}
                            {% if department in ['Verified', 'Trending', 'Collaborations', 'Shop by Room', 'Services', 'Furniture', 'Outdoor', 'Bedding & Bath', 'Lighting', 'Organization'] %}
                                <button class="veylune-header__nav-link veylune-header__nav-link--button"
                                        type="button"
                                        data-veylune-mega-trigger="marketplace"
                                        aria-expanded="false"
                                        aria-controls="veyluneMegaPanel-marketplace">{{ department }}</button>
                            {% else %}
                                <span class="veylune-header__nav-link veylune-header__nav-link--pending" aria-disabled="true">
                                    {{ department }}
                                </span>
                            {% endif %}
                        {% endfor %}
                        {% for item in veyluneNavigationRegistry %}
                            {% if item.desktop %}
                                <a class="veylune-header__nav-link"
                                   href="{{ item.url }}"
                                   data-veylune-nav-key="{{ item.key }}"
                                   {% if item.mega %}data-veylune-mega-trigger="{{ item.mega }}" aria-expanded="false" aria-controls="veyluneMegaPanel-{{ item.mega }}"{% endif %}
                                   data-veylune-page-transition>
                                    {{ item.label|trans|sw_sanitize }}
                                </a>
                            {% endif %}
                        {% endfor %}
					</nav>

					<div class="veylune-header__actions">
						{% block layout_header_search %}
                            <a class="veylune-header__search-toggle veylune-header__search-toggle--mobile" href="#veyluneMarketplaceSearch" aria-label="{{ 'header.searchButton'|trans|striptags }}">
                                <span class="veylune-header__search-toggle-icon" aria-hidden="true">{% sw_icon 'search' %}</span>
                            </a>
                        {% endblock %}

                        {% block layout_header_actions_account %}
                            <a class="veylune-marketplace-action" href="{{ path('frontend.account.home.page') }}" aria-label="{{ 'account.myAccount'|trans|striptags }}">
                                <span class="veylune-marketplace-action__icon" aria-hidden="true">{% sw_icon 'avatar' %}</span>
                                <span class="veylune-marketplace-action__label">Sign In</span>
                            </a>
                        {% endblock %}

                        {% if config('core.cart.wishlistEnabled') %}
                            {% block layout_header_actions_wishlist %}
                                <span class="veylune-header__utility veylune-header__utility--desktop" aria-disabled="true">
                                    {{ 'header.wishlist'|trans|sw_sanitize }}
                                </span>
                            {% endblock %}
                        {% endif %}

						{% block layout_header_actions_cart %}
                            <a class="veylune-header__bag veylune-marketplace-action" href="{{ path('frontend.checkout.cart.page') }}" aria-label="{{ 'checkout.cartTitle'|trans|striptags }}">
                                <span class="veylune-header__bag-icon" aria-hidden="true">{% sw_icon 'basket' %}</span>
                                <span class="veylune-header__bag-label veylune-marketplace-action__label">Cart <span class="veylune-marketplace-action__count">0</span></span>
                            </a>
                        {% endblock %}
					</div>
				</div>
			</div>

            <div class="veylune-mega" data-veylune-mega aria-hidden="true">
                <div class="veylune-mega__backdrop" aria-hidden="true"></div>
                <div class="veylune-mega__panel" role="region" aria-label="{{ 'veylune.header.mega.ariaLabel'|trans|striptags }}">
                    <button class="veylune-mega__close" type="button" data-veylune-mega-close aria-label="{{ 'general.close'|trans|striptags }}">
                        {% sw_icon 'x' %}
                    </button>
                    {% sw_include '@VeyluneTheme/storefront/layout/header/marketplace-mega-panel.html.twig' %}

                    {% for item in veyluneNavigationRegistry %}
                        {% if item.mega and item.desktop %}
                            <section class="veylune-mega__scene"
                                     id="veyluneMegaPanel-{{ item.mega }}"
                                     data-veylune-mega-panel="{{ item.mega }}"
                                     aria-label="{{ item.label|trans|striptags }}"
                                     aria-hidden="true">
                                {% if item.mega == 'shop' %}
                                    <div class="veylune-mega__group" data-veylune-registry-scope="mega-shop" data-veylune-registry-entity="departments">
                                        <h3>{{ 'veylune.header.mega.groups.categories'|trans|sw_sanitize }}</h3>
                                        <div class="veylune-mega__links">
                                            {% for category in veyluneMegaCategories %}
                                                <a href="{{ category.url }}" data-veylune-registry-key="{{ category.key }}" data-veylune-page-transition>{{ category.label|trans|sw_sanitize }}</a>
                                            {% endfor %}
                                        </div>
                                    </div>
                                    <div class="veylune-mega__group" data-veylune-registry-scope="mega-shop" data-veylune-registry-entity="rooms">
                                        <h3>{{ 'veylune.header.mega.groups.rooms'|trans|sw_sanitize }}</h3>
                                        <div class="veylune-mega__links">
                                            {% for room in veyluneMegaRooms %}
                                                <a href="{{ room.url }}" data-veylune-registry-key="{{ room.key }}" data-veylune-page-transition>{{ room.label|trans|sw_sanitize }}</a>
                                            {% endfor %}
                                        </div>
                                    </div>
                                    <div class="veylune-mega__group" data-veylune-registry-scope="mega-shop" data-veylune-registry-entity="collections">
                                        <h3>{{ 'veylune.header.mega.groups.collections'|trans|sw_sanitize }}</h3>
                                        <div class="veylune-mega__links">
                                            {% for collection in veyluneMegaCollections %}
                                                <a href="{{ collection.url }}" data-veylune-registry-key="{{ collection.key }}" data-veylune-page-transition>{{ collection.label|trans|sw_sanitize }}</a>
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% elseif item.mega == 'rooms' %}
                                    <div class="veylune-mega__group veylune-mega__group--wide" data-veylune-registry-scope="mega-rooms" data-veylune-registry-entity="rooms">
                                        <h3>{{ 'veylune.header.mega.groups.rooms'|trans|sw_sanitize }}</h3>
                                        <div class="veylune-mega__links veylune-mega__links--columns">
                                            {% for room in veyluneMegaRooms %}
                                                <a href="{{ room.url }}" data-veylune-registry-key="{{ room.key }}" data-veylune-page-transition>{{ room.label|trans|sw_sanitize }}</a>
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% elseif item.mega == 'collections' %}
                                    <div class="veylune-mega__group veylune-mega__group--wide" data-veylune-registry-scope="mega-collections" data-veylune-registry-entity="collections">
                                        <h3>{{ 'veylune.header.mega.groups.collections'|trans|sw_sanitize }}</h3>
                                        <div class="veylune-mega__links">
                                            {% for collection in veyluneMegaCollections %}
                                                <a href="{{ collection.url }}" data-veylune-registry-key="{{ collection.key }}" data-veylune-page-transition>{{ collection.label|trans|sw_sanitize }}</a>
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% endif %}
                            </section>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

			<div class="veylune-mobile-nav" id="veyluneMobileNav" data-veylune-mobile-nav role="dialog" aria-modal="true" aria-label="{{ 'veylune.header.mobile.navAriaLabel'|trans|striptags }}" aria-hidden="true">
				<div class="veylune-mobile-nav__inner">
					<button class="veylune-mobile-nav__close" type="button" data-veylune-mobile-close aria-label="{{ 'veylune.header.mobile.closeAriaLabel'|trans|striptags }}">
						{% sw_icon 'x' %}
					</button>
					<span class="veylune-mobile-nav__kicker">{{ 'veylune.header.logoText'|trans|sw_sanitize }}</span>
					<nav class="veylune-mobile-nav__links" aria-label="{{ 'veylune.header.mobile.navAriaLabel'|trans|striptags }}">
                        {% for item in veyluneNavigationRegistry %}
                            {% if item.mobile %}
                                <a href="{{ item.url }}" data-veylune-nav-key="{{ item.key }}" data-veylune-page-transition>
                                    {{ item.label|trans|sw_sanitize }}
                                </a>
                            {% endif %}
                        {% endfor %}
                    {% sw_include '@VeyluneTheme/storefront/layout/header/marketplace-mobile-drawer.html.twig' %}
                        <span class="veylune-mobile-nav__pending">{{ 'account.myAccount'|trans|sw_sanitize }}</span>
                        {% if config('core.cart.wishlistEnabled') %}
                            <span class="veylune-mobile-nav__pending">{{ 'header.wishlist'|trans|sw_sanitize }}</span>
                        {% endif %}
					</nav>
					<div class="veylune-mobile-nav__note">{{ 'veylune.header.mobile.note'|trans|sw_sanitize }}</div>
				</div>
			</div>
		{% endblock %}
	</header>
{% endblock %}
