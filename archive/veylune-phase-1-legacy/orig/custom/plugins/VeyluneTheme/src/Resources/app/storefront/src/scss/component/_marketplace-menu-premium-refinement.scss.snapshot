/* Header continuation: premium mega menu and mobile drawer refinement. */

@media (min-width: 992px) {
    .veylune-header .veylune-mega .veylune-mega__panel {
        top: 174px;
        width: min(calc(100% - 64px), 1310px);
        min-height: 0;
        padding: 28px 32px 32px;
        border: 1px solid rgb(47 43 49 / 12%);
        border-top: 3px solid #7f187f;
        border-radius: 0 0 12px 12px;
        background: #fff;
        box-shadow: 0 22px 54px rgb(36 24 38 / 17%);
    }

    .veylune-header .veylune-mega__scene.veylune-mega__scene--marketplace {
        grid-template-columns: minmax(250px, 1.35fr) repeat(4, minmax(130px, 1fr));
        gap: clamp(22px, 3vw, 44px);
        align-items: stretch;
    }

    .veylune-marketplace-mega__feature {
        position: relative;
        min-height: 270px;
        padding: 28px 26px;
        overflow: hidden;
        border: 0;
        border-radius: 0;
        color: #2f2b31;
        background: #f7f0f7;
    }

    .veylune-marketplace-mega__feature::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: 5px;
        background: #7f187f;
    }

    .veylune-marketplace-mega__feature::after {
        content: "V";
        position: absolute;
        right: -0.08em;
        bottom: -0.22em;
        color: rgb(127 24 127 / 6%);
        font-size: 12rem;
        font-weight: 900;
        line-height: 1;
        pointer-events: none;
    }

    .veylune-marketplace-mega__eyebrow {
        color: #7f187f;
        font-size: 0.66rem;
        font-weight: 850;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .veylune-marketplace-mega__feature h2 {
        position: relative;
        z-index: 1;
        max-width: 300px;
        margin: 18px 0 12px;
        color: #2f2b31;
        font-size: clamp(1.55rem, 2vw, 2.1rem);
        font-weight: 850;
        line-height: 1.02;
        letter-spacing: -0.045em;
    }

    .veylune-marketplace-mega__feature p {
        position: relative;
        z-index: 1;
        max-width: 310px;
        color: rgb(47 43 49 / 67%);
        font-size: 0.84rem;
        line-height: 1.5;
    }

    .veylune-marketplace-mega__feature a {
        position: relative;
        z-index: 1;
        display: inline-flex;
        min-height: 40px;
        align-items: center;
        margin-top: 18px;
        padding: 0 16px;
        border: 1px solid #7f187f;
        border-radius: 999px;
        color: #fff;
        background: #7f187f;
        font-size: 0.78rem;
        font-weight: 800;
        text-decoration: none;
    }

    .veylune-marketplace-mega__column {
        padding-top: 8px;
    }

    .veylune-marketplace-mega__column h3 {
        margin: 0 0 13px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgb(47 43 49 / 13%);
        color: #2f2b31;
        font-size: 0.68rem;
        font-weight: 850;
        letter-spacing: 0.07em;
        text-transform: uppercase;
    }

    .veylune-marketplace-mega__column a,
    .veylune-marketplace-mega__column span {
        position: relative;
        display: flex;
        min-height: 38px;
        align-items: center;
        padding: 5px 0;
        color: #2f2b31;
        font-size: 0.84rem;
        font-weight: 580;
        line-height: 1.25;
        text-decoration: none;
        transition: color 150ms ease, transform 150ms ease;
    }

    .veylune-marketplace-mega__column a::after {
        content: "→";
        margin-left: auto;
        color: #7f187f;
        opacity: 0;
        transform: translateX(-5px);
        transition: opacity 150ms ease, transform 150ms ease;
    }

    .veylune-marketplace-mega__column a:hover,
    .veylune-marketplace-mega__column a:focus-visible {
        color: #7f187f;
        transform: translateX(3px);
    }

    .veylune-marketplace-mega__column a:hover::after,
    .veylune-marketplace-mega__column a:focus-visible::after {
        opacity: 1;
        transform: translateX(0);
    }

    .veylune-mega__close {
        top: 12px;
        right: 12px;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        color: #2f2b31;
        background: #f5f3f5;
    }
}

@media (max-width: 991.98px) {
    .veylune-mobile-nav {
        background: rgb(33 25 34 / 54%);
        backdrop-filter: blur(3px);
    }

    .veylune-mobile-nav__inner {
        width: min(92vw, 390px);
        padding: 72px 20px 28px;
        border-top: 5px solid #7f187f;
        box-shadow: 18px 0 50px rgb(33 25 34 / 22%);
    }

    .veylune-mobile-nav__kicker {
        top: 24px;
        left: 20px;
        color: #7f187f;
        font-size: 1.25rem;
        font-weight: 900;
        letter-spacing: -0.055em;
    }

    .veylune-mobile-nav__close {
        top: 14px;
        right: 14px;
        border-radius: 50%;
        background: #f7f0f7;
    }

    .veylune-mobile-marketplace__search {
        height: 48px;
        margin-bottom: 18px;
        border: 1px solid #2f2b31;
        border-radius: 999px;
    }

    .veylune-mobile-marketplace__search button {
        background: #7f187f;
    }

    .veylune-mobile-marketplace__shortcuts {
        gap: 0;
        margin-bottom: 18px;
        border-top: 1px solid rgb(47 43 49 / 13%);
        border-bottom: 1px solid rgb(47 43 49 / 13%);
    }

    .veylune-mobile-marketplace__shortcuts a {
        min-height: 52px;
        padding: 8px 12px;
        border: 0;
        border-radius: 0;
    }

    .veylune-mobile-marketplace__shortcuts a + a {
        border-left: 1px solid rgb(47 43 49 / 13%);
    }

    .veylune-mobile-marketplace__accordions {
        border-top: 0;
    }

    .veylune-mobile-marketplace details {
        border-color: rgb(47 43 49 / 15%);
    }

    .veylune-mobile-marketplace summary {
        min-height: 58px;
        padding-left: 0;
        font-size: 0.94rem;
        font-weight: 800;
        letter-spacing: -0.015em;
    }

    .veylune-mobile-marketplace details[open] summary {
        color: #7f187f;
    }

    .veylune-mobile-marketplace__panel {
        grid-template-columns: 1fr;
        gap: 0;
        padding: 0 0 14px;
    }

    .veylune-mobile-marketplace__panel a,
    .veylune-mobile-marketplace__panel span {
        min-height: 42px;
        padding: 7px 10px;
        border-radius: 0;
        font-size: 0.86rem;
    }

    .veylune-mobile-marketplace__panel a {
        border-left: 2px solid transparent;
    }

    .veylune-mobile-marketplace__panel a:hover,
    .veylune-mobile-marketplace__panel a:focus-visible {
        border-left-color: #7f187f;
        background: #f7f0f7;
    }
}

@media (prefers-reduced-motion: reduce) {
    .veylune-marketplace-mega__column a,
    .veylune-marketplace-mega__column a::after {
        transition: none;
    }
}
