/* Reference refinement: preserve Wayfair's hierarchy while tightening Veylune execution. */

.veylune-marketplace-utility {
    min-height: 31px;
    color: #fff;
    background: #7f187f;
    border: 0;
    font-size: 0.75rem;
    font-weight: 700;
}

.veylune-marketplace-utility__inner {
    min-height: 31px;
    width: min(calc(100% - 48px), 1310px);
}

.veylune-marketplace-family,
.veylune-marketplace-utility__right,
.veylune-marketplace-utility__links {
    display: flex;
    align-items: center;
}

.veylune-marketplace-family {
    gap: 22px;
}

.veylune-marketplace-family a,
.veylune-marketplace-utility__links a,
.veylune-marketplace-utility__links span,
.veylune-marketplace-utility__shipping {
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
}

.veylune-marketplace-family__primary {
    font-weight: 850;
}

.veylune-marketplace-utility__right,
.veylune-marketplace-utility__links {
    gap: 20px;
}

.veylune-marketplace-utility__shipping {
    padding-left: 20px;
    border-left: 1px solid rgb(255 255 255 / 34%);
}

.veylune-header .veylune-header__bar,
.veylune-header.is-initial .veylune-header__bar,
.veylune-header.is-scrolled .veylune-header__bar {
    background: #fff;
    border-bottom: 1px solid #dedde0;
}

@media (min-width: 992px) {
    .veylune-header .veylune-header__inner {
        grid-template-columns: 220px minmax(460px, 1fr) 300px;
        grid-template-rows: 72px 70px;
        column-gap: 20px;
        min-height: 142px;
    }

    .veylune-header__logo-image {
        width: 180px;
        max-width: 180px;
        max-height: 52px;
    }

    .veylune-header__actions {
        gap: 14px;
    }

    .veylune-header__search-toggle--mobile {
        display: none !important;
    }

    .veylune-marketplace-action {
        min-height: 48px;
        padding: 8px 10px;
        border-radius: 999px;
    }
}

.veylune-marketplace-search__form {
    grid-template-columns: minmax(0, 1fr) 56px;
    height: 48px;
    min-height: 48px;
    overflow: hidden;
    border: 1px solid #2f2b31;
    border-radius: 999px;
    background: #fff;
    box-shadow: none;
}

.veylune-header .veylune-marketplace-search__input {
    height: 46px;
    min-height: 46px;
    padding: 8px 18px;
    font-size: 1rem;
}

.veylune-marketplace-search__submit {
    width: 56px;
    height: 46px;
    min-height: 46px;
    border-radius: 0;
    color: #fff;
    background: #7f187f;
}

.veylune-marketplace-search__form:focus-within {
    border-color: #7f187f;
    box-shadow: 0 0 0 2px rgb(127 24 127 / 18%);
}

.veylune-marketplace-action__count {
    background: #c61d46;
}

/* Two calm nav bands from one semantic list: discovery first, departments second. */
.veylune-header .veylune-header__nav {
    display: flex;
    flex-wrap: wrap;
    align-content: stretch;
    justify-content: center;
    gap: 0;
    height: 70px;
    min-height: 70px;
    overflow: hidden;
    padding: 0;
    border-top: 0;
}

.veylune-header .veylune-header__nav::after {
    content: "";
    order: 2;
    flex-basis: 100%;
    height: 0;
}

.veylune-header__nav-link {
    min-height: 35px;
    padding: 0 9px;
    border: 0;
    border-radius: 0;
    color: #2f2b31;
    background: transparent;
    font-size: 0.75rem;
    font-weight: 650;
    white-space: nowrap;
}

.veylune-header__nav-link:nth-child(-n + 9) {
    order: 1;
}

.veylune-header__nav-link:nth-child(n + 10) {
    order: 3;
    font-weight: 750;
}

.veylune-header__nav-link:hover,
.veylune-header__nav-link:focus-visible {
    color: #7f187f;
    background: transparent;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
}

.veylune-header__nav-link::after,
.veylune-marketplace-header .main-navigation-link::after {
    display: none;
}

@media (max-width: 1199.98px) and (min-width: 992px) {
    .veylune-header .veylune-header__inner {
        grid-template-columns: 170px minmax(380px, 1fr) 250px;
        column-gap: 14px;
    }

    .veylune-header__nav-link {
        padding-inline: 9px;
        font-size: 0.72rem;
    }
}

@media (max-width: 991.98px) {
    .veylune-marketplace-utility {
        display: none;
    }

    .veylune-header .veylune-header__inner {
        grid-template-rows: 56px 48px;
        min-height: 112px;
        row-gap: 0;
        padding: 4px 0;
    }

    .veylune-header .veylune-marketplace-search__input {
        padding-left: 16px;
    }

    .veylune-header .veylune-header__nav {
        display: none;
    }
}
