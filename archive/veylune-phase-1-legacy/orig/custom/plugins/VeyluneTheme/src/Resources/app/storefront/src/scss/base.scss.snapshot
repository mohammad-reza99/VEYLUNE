.header-logo-picture {
    width: clamp(210px, 22vw, 260px);
    min-width: 0;
    max-width: 260px;
}

.header-logo-main-img {
    width: 100%;
    max-height: 72px;
    object-fit: contain;
}

@include media-breakpoint-down(md) {
    .header-logo-picture {
        width: 210px;
        max-width: 210px;
    }

    .header-logo-main-img {
        max-height: 64px;
    }
}

