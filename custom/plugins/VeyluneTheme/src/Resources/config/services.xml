<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
           https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults autowire="true" autoconfigure="true" />

        <service id="VeyluneTheme\Controller\PartnershipController" public="true">
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>

        <service id="VeyluneTheme\Controller\EditionsController" public="true">
            <call method="setContainer">
                <argument type="service" id="service_container" />
            </call>
        </service>

        <service id="VeyluneTheme\Edition\EditionReferenceRegistry" />

        <service id="VeyluneTheme\Publication\PublicationStatePolicy" />

        <service id="VeyluneTheme\Semantic\SemanticRegistry" />

        <service id="VeyluneTheme\Governance\GovernanceAuditService" />

        <service id="VeyluneTheme\Command\SemanticAuditCommand" />

        <service id="VeyluneTheme\Command\SemanticAuthoringAuditCommand" />

        <service id="VeyluneTheme\Command\DistributedRuntimeAuditCommand" />

        <service id="VeyluneTheme\Command\TopologyPressureAuditCommand" />

        <service id="VeyluneTheme\Command\PublicationStateAuditCommand" />

        <service id="VeyluneTheme\Subscriber\EditionMetadataValidationSubscriber" />

        <service id="VeyluneTheme\Subscriber\IdentityIngressAllowlistSubscriber" />
    </services>
</container>
