/* Phase 2.6: five-column marketplace mega menu and action precision. */

.veylune-header__nav-link--button {
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 40px;
    align-items: center;
    gap: 6px;
    padding: 11px 12px;
    border: 0;
    border-radius: 0;
    color: var(--veylune-marketplace-ink);
    background: transparent;
    font-family: var(--veylune-marketplace-font);
    font-size: var(--veylune-marketplace-font-size-500);
    font-weight: 700;
    line-height: 1.25;
    white-space: nowrap;
}

.veylune-header__nav-link--button::after {
    width: 6px;
    height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    content: "";
    transform: translateY(-2px) rotate(45deg);
    transition: transform 150ms ease;
}

.veylune-header__nav-link--button:hover,
.veylune-header__nav-link--button:focus-visible,
.veylune-header__nav-link--button[aria-expanded="true"] {
    color: var(--veylune-marketplace-primary);
    background: var(--veylune-marketplace-primary-soft);
}

.veylune-header__nav-link--button[aria-expanded="true"]::after {
    transform: translateY(2px) rotate(225deg);
}

.veylune-mega__panel {
    top: 166px;
    width: min(calc(100% - 48px), 1600px);
    padding: 24px;
}

.veylune-mega__scene--marketplace {
    grid-template-columns: minmax(280px, 36fr) repeat(4, minmax(140px, 16fr));
    gap: 16px;
    min-height: 320px;
}

.veylune-marketplace-mega__feature {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
    padding: 28px;
    border-radius: var(--veylune-marketplace-radius-lg);
    color: var(--veylune-marketplace-white);
    background: linear-gradient(145deg, var(--veylune-marketplace-primary), #370844);
}

.veylune-marketplace-mega__eyebrow {
    margin-bottom: 8px;
    font-size: var(--veylune-marketplace-font-size-500);
    font-weight: 800;
    text-transform: uppercase;
}

.veylune-marketplace-mega__feature h2 {
    max-width: 420px;
    margin: 0 0 12px;
    color: inherit;
    font-family: var(--veylune-marketplace-font);
    font-size: var(--veylune-marketplace-font-size-3000);
    font-weight: 800;
    line-height: 1.2;
}

.veylune-marketplace-mega__feature p {
    max-width: 440px;
    margin: 0 0 18px;
    color: rgb(255 255 255 / 84%);
    font-family: var(--veylune-marketplace-font);
    font-size: 0.875rem;
    line-height: 1.5;
}

.veylune-marketplace-mega__feature a {
    min-height: 40px;
    padding: 9px 14px;
    border-radius: var(--veylune-marketplace-radius-md);
    color: var(--veylune-marketplace-primary);
    background: var(--veylune-marketplace-white);
    font-size: 0.875rem;
    font-weight: 800;
    text-decoration: none;
}

.veylune-marketplace-mega__column {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
}

.veylune-marketplace-mega__column h3 {
    margin: 0 0 8px;
    color: var(--veylune-marketplace-ink);
    font-family: var(--veylune-marketplace-font);
    font-size: 0.875rem;
    font-weight: 800;
}

.veylune-marketplace-mega__column a,
.veylune-marketplace-mega__column span {
    display: flex;
    min-height: 40px;
    align-items: center;
    padding: 8px;
    border-radius: var(--veylune-marketplace-radius-md);
    color: var(--veylune-marketplace-ink);
    font-size: var(--veylune-marketplace-font-size-500);
    font-weight: 600;
    text-decoration: none;
}

.veylune-marketplace-mega__column a:hover,
.veylune-marketplace-mega__column a:focus-visible {
    color: var(--veylune-marketplace-primary);
    background: var(--veylune-marketplace-primary-soft);
}

.veylune-marketplace-mega__column span {
    color: var(--veylune-marketplace-muted);
}

.veylune-marketplace-action__icon,
.veylune-header__bag-icon,
.veylune-marketplace-action__icon .icon,
.veylune-header__bag-icon .icon {
    width: 24px;
    height: 24px;
}

@media (max-width: 1199.98px) {
    .veylune-mega__scene--marketplace {
        grid-template-columns: minmax(240px, 1.35fr) repeat(4, minmax(120px, 1fr));
    }
}

@media (max-width: 991.98px) {
    .veylune-mega {
        display: none;
    }
}
