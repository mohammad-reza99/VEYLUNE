/*
 * Veylune Marketplace Design System v1
 * Original marketplace primitives informed by common high-conversion commerce patterns.
 */

:root {
    --veylune-marketplace-primary: #6f2da8;
    --veylune-marketplace-primary-hover: #562181;
    --veylune-marketplace-primary-soft: #f1e9f7;
    --veylune-marketplace-focus: #8b5cf6;
    --veylune-marketplace-ink: #2f2b32;
    --veylune-marketplace-muted: #6f6874;
    --veylune-marketplace-border: #d9d5dc;
    --veylune-marketplace-surface: #f7f5f8;
    --veylune-marketplace-white: #fff;
    --veylune-marketplace-promo: #c8244f;
    --veylune-marketplace-success: #18794e;
    --veylune-marketplace-rating: #9a5b00;
    --veylune-marketplace-font: Inter, "Helvetica Neue", Arial, sans-serif;
    --veylune-marketplace-space-1: 4px;
    --veylune-marketplace-space-2: 8px;
    --veylune-marketplace-space-3: 12px;
    --veylune-marketplace-space-4: 16px;
    --veylune-marketplace-space-5: 24px;
    --veylune-marketplace-space-6: 32px;
    --veylune-marketplace-radius-sm: 6px;
    --veylune-marketplace-radius-md: 8px;
    --veylune-marketplace-radius-lg: 12px;
    --veylune-marketplace-radius-pill: 999px;
    --veylune-marketplace-shadow-sm: 0 1px 2px rgb(47 43 50 / 10%);
    --veylune-marketplace-shadow-md: 0 6px 20px rgb(47 43 50 / 12%);
    --veylune-marketplace-control-height: 44px;
}

html,
body {
    color: var(--veylune-marketplace-ink);
    background: var(--veylune-marketplace-white);
    font-family: var(--veylune-marketplace-font);
}

body,
button,
input,
select,
textarea,
.btn,
.form-control,
.form-select {
    font-family: var(--veylune-marketplace-font);
}

a {
    color: var(--veylune-marketplace-primary);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
}

a:hover {
    color: var(--veylune-marketplace-primary-hover);
}

a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
[tabindex]:focus-visible {
    outline: 3px solid rgb(139 92 246 / 45%);
    outline-offset: 2px;
}

.btn,
.veylune-marketplace-button {
    min-height: var(--veylune-marketplace-control-height);
    padding: 10px 18px;
    border: 1px solid transparent;
    border-radius: var(--veylune-marketplace-radius-md);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0;
    text-transform: none;
    box-shadow: none;
    transition: background-color 150ms ease, border-color 150ms ease, color 150ms ease, box-shadow 150ms ease;
}

.btn-primary,
.veylune-marketplace-button--primary {
    border-color: var(--veylune-marketplace-primary);
    color: var(--veylune-marketplace-white);
    background: var(--veylune-marketplace-primary);
}

.btn-primary:hover,
.btn-primary:active,
.veylune-marketplace-button--primary:hover {
    border-color: var(--veylune-marketplace-primary-hover);
    color: var(--veylune-marketplace-white);
    background: var(--veylune-marketplace-primary-hover);
}

.btn-secondary,
.btn-outline-primary,
.veylune-marketplace-button--secondary {
    border-color: var(--veylune-marketplace-primary);
    color: var(--veylune-marketplace-primary);
    background: var(--veylune-marketplace-white);
}

.btn-secondary:hover,
.btn-outline-primary:hover,
.veylune-marketplace-button--secondary:hover {
    border-color: var(--veylune-marketplace-primary-hover);
    color: var(--veylune-marketplace-primary-hover);
    background: var(--veylune-marketplace-primary-soft);
}

.btn-link,
.veylune-marketplace-button--tertiary {
    min-height: auto;
    padding: 6px 4px;
    border-color: transparent;
    color: var(--veylune-marketplace-primary);
    background: transparent;
}

.btn:disabled,
.btn.disabled,
.veylune-marketplace-button:disabled {
    border-color: var(--veylune-marketplace-border);
    color: var(--veylune-marketplace-muted);
    background: var(--veylune-marketplace-surface);
    cursor: not-allowed;
    opacity: 0.7;
}

.form-label,
label {
    color: var(--veylune-marketplace-ink);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: none;
}

.form-control,
.form-select,
input[type="text"],
input[type="email"],
input[type="password"],
input[type="search"],
input[type="tel"],
input[type="number"],
textarea,
select {
    min-height: 48px;
    padding: 10px 12px;
    border: 1px solid var(--veylune-marketplace-border);
    border-radius: var(--veylune-marketplace-radius-md);
    color: var(--veylune-marketplace-ink);
    background-color: var(--veylune-marketplace-white);
    box-shadow: none;
}

.form-control:hover,
.form-select:hover {
    border-color: var(--veylune-marketplace-muted);
}

.form-control:focus,
.form-select:focus,
input:focus,
textarea:focus,
select:focus {
    border-color: var(--veylune-marketplace-primary);
    box-shadow: 0 0 0 3px rgb(139 92 246 / 24%);
}

.veylune-marketplace-icon,
.veylune-marketplace-icon-button .icon,
.header-actions-btn .icon {
    width: 20px;
    height: 20px;
    color: currentColor;
}

.veylune-marketplace-icon-button {
    display: inline-grid;
    width: 44px;
    height: 44px;
    padding: 0;
    place-items: center;
    border: 1px solid transparent;
    border-radius: var(--veylune-marketplace-radius-pill);
    color: var(--veylune-marketplace-ink);
    background: transparent;
}

.veylune-marketplace-icon-button:hover {
    color: var(--veylune-marketplace-primary);
    background: var(--veylune-marketplace-primary-soft);
}

.product-box,
.veylune-marketplace-card {
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--veylune-marketplace-border);
    border-radius: var(--veylune-marketplace-radius-md);
    color: var(--veylune-marketplace-ink);
    background: var(--veylune-marketplace-white);
    box-shadow: var(--veylune-marketplace-shadow-sm);
    transition: border-color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
}

.product-box:hover,
.veylune-marketplace-card:hover {
    border-color: #b8b1bd;
    box-shadow: var(--veylune-marketplace-shadow-md);
    transform: translateY(-1px);
}

.product-box .product-image-wrapper,
.veylune-marketplace-card__media {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--veylune-marketplace-surface);
}

.product-box .product-image,
.veylune-marketplace-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.product-box .product-info,
.veylune-marketplace-card__body {
    padding: var(--veylune-marketplace-space-3);
}

.product-box .product-name,
.veylune-marketplace-card__title {
    color: var(--veylune-marketplace-ink);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.4;
}

.product-box .product-price,
.veylune-marketplace-price {
    color: var(--veylune-marketplace-ink);
    font-size: 1.125rem;
    font-weight: 800;
}

.product-box .list-price-price,
.veylune-marketplace-price--previous {
    color: var(--veylune-marketplace-muted);
    font-size: 0.8125rem;
    font-weight: 500;
}

.product-box .product-price-unit,
.product-box .product-price-reference,
.veylune-marketplace-card__meta {
    color: var(--veylune-marketplace-muted);
    font-size: 0.8125rem;
}

.veylune-marketplace-badge {
    display: inline-flex;
    min-height: 24px;
    align-items: center;
    padding: 3px 8px;
    border-radius: var(--veylune-marketplace-radius-sm);
    color: var(--veylune-marketplace-white);
    background: var(--veylune-marketplace-promo);
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.2;
}

.veylune-marketplace-rating {
    color: var(--veylune-marketplace-rating);
}

.veylune-marketplace-surface {
    border: 1px solid var(--veylune-marketplace-border);
    border-radius: var(--veylune-marketplace-radius-lg);
    background: var(--veylune-marketplace-white);
    box-shadow: var(--veylune-marketplace-shadow-sm);
}

@media (prefers-reduced-motion: reduce) {
    .btn,
    .product-box,
    .veylune-marketplace-card {
        transition: none;
    }
}
