/* Creative Direction 2.1: connective detail across navigation, commerce and footer. */

.veylune-marketplace-header {
    --veylune-detail-line: rgb(79 13 104 / 18%);
}

.veylune-marketplace-header .header-main {
    position: relative;
}

.veylune-marketplace-header .header-main::after {
    content: "";
    position: absolute;
    right: 24px;
    bottom: 0;
    left: 24px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--veylune-detail-line) 12%, var(--veylune-detail-line) 88%, transparent);
}

.veylune-marketplace-header .main-navigation-link,
.veylune-marketplace-header .veylune-marketplace-utility__link {
    position: relative;
}

.veylune-marketplace-header .main-navigation-link::after,
.veylune-marketplace-header .veylune-marketplace-utility__link::after {
    content: "";
    position: absolute;
    right: 12px;
    bottom: 6px;
    left: 12px;
    height: 2px;
    background: var(--veylune-marketplace-primary);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 220ms cubic-bezier(0.2, 0.7, 0.2, 1);
}

.veylune-marketplace-header .main-navigation-link:hover::after,
.veylune-marketplace-header .main-navigation-link:focus-visible::after,
.veylune-marketplace-header .veylune-marketplace-utility__link:hover::after,
.veylune-marketplace-header .veylune-marketplace-utility__link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
}

.veylune-marketplace-header .header-search-form {
    box-shadow: 0 8px 24px rgb(33 30 34 / 5%);
    transition: box-shadow 220ms ease, transform 220ms ease;
}

.veylune-marketplace-header .header-search-form:focus-within {
    box-shadow: 0 12px 34px rgb(79 13 104 / 14%);
    transform: translateY(-1px);
}

/* Product cards: a gallery-like object stage with expressive but useful feedback. */
.veylune-product-slider .veylune-product-card {
    position: relative;
}

.veylune-product-slider .veylune-product-card__media-link {
    position: relative;
    border-radius: 18px 18px 4px 4px;
    background: #f2eef3;
    box-shadow: inset 0 0 0 1px rgb(33 30 34 / 7%);
}

.veylune-product-slider .veylune-product-card__media-link::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    border: 1px solid transparent;
    border-radius: inherit;
    transition: border-color 220ms ease, box-shadow 220ms ease;
    pointer-events: none;
}

.veylune-product-slider .veylune-product-card__image,
.veylune-product-slider .veylune-product-card__media .product-image {
    transition: transform 520ms cubic-bezier(0.2, 0.7, 0.2, 1);
}

.veylune-product-slider .veylune-product-card:hover .veylune-product-card__image,
.veylune-product-slider .veylune-product-card:hover .product-image,
.veylune-product-slider .veylune-product-card:focus-within .veylune-product-card__image,
.veylune-product-slider .veylune-product-card:focus-within .product-image {
    transform: scale(1.035);
}

.veylune-product-slider .veylune-product-card:hover .veylune-product-card__media-link::before,
.veylune-product-slider .veylune-product-card:focus-within .veylune-product-card__media-link::before {
    border-color: rgb(79 13 104 / 28%);
    box-shadow: inset 0 -60px 70px rgb(79 13 104 / 5%);
}

.veylune-product-slider .veylune-product-card__body {
    position: relative;
    padding-top: 16px;
}

.veylune-product-slider .veylune-product-card__body::before {
    content: "";
    width: 34px;
    height: 2px;
    margin-bottom: 2px;
    background: var(--veylune-marketplace-primary);
    transition: width 220ms ease;
}

.veylune-product-slider .veylune-product-card:hover .veylune-product-card__body::before,
.veylune-product-slider .veylune-product-card:focus-within .veylune-product-card__body::before {
    width: 64px;
}

.veylune-product-slider .veylune-product-card__title a {
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
}

.veylune-product-slider .veylune-product-card__title a:hover,
.veylune-product-slider .veylune-product-card__title a:focus-visible {
    text-decoration-line: underline;
}

/* Footer: a deliberate editorial closing field, aligned with the campaign system. */
.veylune-footer {
    color: rgb(255 255 255 / 76%);
    background:
        linear-gradient(90deg, rgb(255 255 255 / 4%) 1px, transparent 1px) 0 0 / 25% 100%,
        radial-gradient(70% 100% at 14% 0%, rgb(152 73 183 / 25%), transparent 68%),
        #24102c;
    border-top: 0;
}

.veylune-footer::before {
    content: "VEYLUNE";
    position: absolute;
    top: -0.1em;
    right: -0.02em;
    color: rgb(255 255 255 / 3.5%);
    font-family: var(--veylune-marketplace-font);
    font-size: clamp(8rem, 22vw, 23rem);
    font-weight: 900;
    line-height: 0.8;
    letter-spacing: -0.08em;
    pointer-events: none;
}

.veylune-footer__inner,
.veylune-footer__bottom {
    position: relative;
    z-index: 1;
}

.veylune-footer__inner {
    grid-template-columns: minmax(300px, 1.45fr) repeat(3, minmax(120px, 0.45fr));
    padding-top: clamp(5rem, 9vw, 8.5rem);
}

.veylune-footer__brand {
    padding-right: clamp(1rem, 5vw, 5rem);
}

.veylune-footer__logo {
    font-family: var(--veylune-marketplace-font);
    font-size: clamp(2.2rem, 5vw, 5.5rem);
    font-weight: 850;
    line-height: 0.9;
    letter-spacing: -0.055em;
}

.veylune-footer__text {
    max-width: 30rem;
    color: rgb(255 255 255 / 66%);
    font-family: var(--veylune-marketplace-font);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    line-height: 1.55;
}

.veylune-footer__title {
    padding-bottom: 10px;
    border-bottom: 1px solid rgb(255 255 255 / 18%);
    color: #fff;
    font-family: var(--veylune-marketplace-font);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
}

.veylune-footer__link {
    width: fit-content;
    color: rgb(255 255 255 / 64%);
    transition: color 180ms ease, transform 180ms ease;
}

.veylune-footer__link:hover,
.veylune-footer__link:focus-visible {
    color: #fff;
    transform: translateX(4px);
}

@media (prefers-reduced-motion: reduce) {
    .veylune-marketplace-header .main-navigation-link::after,
    .veylune-marketplace-header .veylune-marketplace-utility__link::after,
    .veylune-marketplace-header .header-search-form,
    .veylune-product-slider .veylune-product-card__image,
    .veylune-product-slider .veylune-product-card__media .product-image,
    .veylune-product-slider .veylune-product-card__media-link::before,
    .veylune-product-slider .veylune-product-card__body::before,
    .veylune-footer__link {
        transition: none;
    }
}

@media (max-width: 767.98px) {
    .veylune-marketplace-header .header-main::after {
        right: 12px;
        left: 12px;
    }

    .veylune-footer {
        background:
            linear-gradient(90deg, rgb(255 255 255 / 4%) 1px, transparent 1px) 0 0 / 50% 100%,
            radial-gradient(100% 70% at 0% 0%, rgb(152 73 183 / 24%), transparent 70%),
            #24102c;
    }

    .veylune-footer__inner {
        gap: 2.5rem;
        padding-top: 4.5rem;
    }

    .veylune-footer__brand {
        padding-right: 0;
    }
}
