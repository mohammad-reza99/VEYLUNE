{% sw_extends '@Storefront/storefront/page/account/index.html.twig' %}

{% block page_account_overview %}
    <div class="account-overview veylune-account-overview">
        {{ parent() }}
    </div>
{% endblock %}

{% block page_account_overview_welcome %}
    <header class="account-welcome veylune-account-hero">
        <p class="veylune-account-hero__eyebrow">{{ 'veylune.account.privateClientSalon'|trans|sw_sanitize }}</p>
        <h1>{{ 'veylune.account.yourAccount'|trans|sw_sanitize }}</h1>

        {% block page_account_overview_welcome_intro %}
            <p>{{ 'veylune.account.overviewIntro'|trans|sw_sanitize }}</p>
        {% endblock %}
    </header>
{% endblock %}

{% block page_account_overview_profile_title %}
    <h2 class="veylune-account-section-title">{{ 'veylune.account.personalDetails'|trans|sw_sanitize }}</h2>
{% endblock %}

{% block page_account_overview_profile_actions_content %}
    <a href="{{ path('frontend.account.profile.page') }}" class="veylune-button veylune-button--ghost veylune-button--sm">
        {{ 'account.profileLink'|trans|sw_sanitize }}
    </a>
{% endblock %}

{% block page_account_overview_newsletter_title %}
    <h2 class="veylune-account-section-title">{{ 'account.newsletterTitle'|trans|sw_sanitize }}</h2>
{% endblock %}

{% block page_account_overview_newest_order_title %}
    <h2 class="veylune-account-section-title">{{ 'veylune.account.acquisitionArchive'|trans|sw_sanitize }}</h2>
{% endblock %}
