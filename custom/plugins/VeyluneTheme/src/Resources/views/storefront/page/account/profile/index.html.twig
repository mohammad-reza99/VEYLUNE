{% sw_extends '@Storefront/storefront/page/account/profile/index.html.twig' %}

{% set isCanonicalLocalAccount = context.salesChannel.id == '019e3bf9c220717884d2a4eaca77c2d1' and app.request.host == 'veylune-shopware.ddev.site' %}
{% set isLocalTestAccount = context.salesChannel.id == '019f7a00000070008000000000000001' or isCanonicalLocalAccount %}

{% block page_account_profile %}
    <div class="account-profile veylune-account-profile">
        {{ parent() }}
    </div>
{% endblock %}

{% block page_account_profile_personal_welcome %}
    <header class="account-welcome veylune-account-hero">
        {% block page_account_profile_personal_welcome_headline %}
            <p class="veylune-account-hero__eyebrow">{{ isLocalTestAccount ? 'Your Veylune account' : 'veylune.account.privateClientSalon'|trans|sw_sanitize }}</p>
            <h1>{{ 'veylune.account.personalDetails'|trans|sw_sanitize }}</h1>
        {% endblock %}

        {% block page_account_profile_personal_welcome_intro %}
            <p>{{ 'account.profileText'|trans|sw_sanitize }}</p>
        {% endblock %}
    </header>
{% endblock %}

{% block page_account_profile_personal_header %}
    <h2 class="veylune-account-section-title">{{ 'account.profilePersonalTitle'|trans|sw_sanitize }}</h2>
{% endblock %}
