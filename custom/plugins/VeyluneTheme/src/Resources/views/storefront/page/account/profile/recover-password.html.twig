{% sw_extends '@Storefront/storefront/page/account/profile/recover-password.html.twig' %}

{% block page_account_profile_recover_password %}
    <section class="vli-account-recovery"
             aria-labelledby="vli-account-recovery-title"
             data-vli-account-recovery>
        <header class="vli-account-recovery__intro">
            <p class="vli-account-recovery__kicker">Account access / Secure recovery</p>
            <h1 id="vli-account-recovery-title">Return to your saved context.</h1>
            <p>Request a secure reset link without leaving the Veylune account environment.</p>
            <dl class="vli-account-recovery__index">
                <div>
                    <dt>01</dt>
                    <dd>Enter your account email</dd>
                </div>
                <div>
                    <dt>02</dt>
                    <dd>Open the secure message</dd>
                </div>
                <div>
                    <dt>03</dt>
                    <dd>Choose a new password</dd>
                </div>
            </dl>
        </header>

        <div class="vli-account-recovery__form-shell">
            {{ parent() }}
            <p class="vli-account-recovery__boundary">
                For privacy, this page never confirms whether an email address belongs to an account.
            </p>
        </div>
    </section>
{% endblock %}

{% block page_account_profile_recover_password_title %}
    <p class="vli-account-recovery__form-kicker">Password assistance</p>
    <h2 class="card-title">Request a reset link.</h2>
{% endblock %}

{% block page_account_profile_recover_password_info %}
    <div class="card-text account-recover-password-info mb-3">
        Enter the email address used for your account. If it matches an account, a secure recovery message will be sent.
    </div>
{% endblock %}
