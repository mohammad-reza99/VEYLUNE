{% sw_extends '@Storefront/storefront/page/content/product-detail.html.twig' %}

{% block cms_breadcrumb %}
    <div class="cms-breadcrumb container veylune-product-detail__breadcrumb">
        {% if feature('v6.8.0.0') or feature('BREADCRUMB_REWORK') %}
            {% sw_include '@Storefront/storefront/layout/breadcrumb.html.twig' with {
                context: context,
                themeIconConfig: themeIconConfig,
                breadcrumb: page.breadcrumb
            } only %}
        {% else %}
            {% sw_include '@Storefront/storefront/layout/breadcrumb.html.twig' with {
                context: context,
                themeIconConfig: themeIconConfig,
                category: page.product.seoCategory
            } only %}
        {% endif %}
    </div>
{% endblock %}

{% block cms_content %}
    {% set product = page.product %}
    {% set productCustomFields = product.translated.customFields|default(product.customFields|default({})) %}
    {% set commercePosture = productCustomFields.veylune_consultation_mode|default(product.available ? 'direct' : 'consultation') %}
    {% set cmsPageClasses = ('cms-page veylune-product-detail__cms ' ~ page.cmsPage.cssClass|striptags)|trim %}

    <article class="veylune-product-detail" data-veylune-commerce-posture="{{ commercePosture|e('html_attr') }}">
        <div class="veylune-product-detail__frame">
            <div class="{{ cmsPageClasses }}"
                 {% if not feature('JSON_LD_DATA') %}
                 itemscope itemtype="https://schema.org/Product"
                 {% endif %}>
                {% block page_content_blocks %}
                    {% sw_include '@Storefront/storefront/page/content/detail.html.twig' with { cmsPage: page.cmsPage } %}
                {% endblock %}
            </div>
        </div>

        <section class="veylune-product-detail__commerce-state" aria-label="{{ 'veylune.productDetail.availability'|trans|striptags }}">
            <div>
                <span>{{ 'veylune.productDetail.availability'|trans|sw_sanitize }}</span>
                <strong>
                    {% if product.available %}
                        {{ 'veylune.productDetail.available'|trans|sw_sanitize }}
                    {% else %}
                        {{ 'veylune.productDetail.availabilityOnRequest'|trans|sw_sanitize }}
                    {% endif %}
                </strong>
            </div>
            <div>
                <span>{{ 'veylune.productDetail.atelier'|trans|sw_sanitize }}</span>
                <strong>{{ product.manufacturer.translated.name|default('veylune.header.logoText'|trans|sw_sanitize) }}</strong>
            </div>
            <div>
                <span>{{ 'veylune.productDetail.reference'|trans|sw_sanitize }}</span>
                <strong>{{ product.productNumber }}</strong>
            </div>
        </section>

        <section class="veylune-product-detail__studio-note" aria-labelledby="veylune-product-studio-note">
            <div>
                <p class="veylune-product-detail__eyebrow">{{ 'veylune.productDetail.studioNotes'|trans|sw_sanitize }}</p>
                <h2 id="veylune-product-studio-note">{{ 'veylune.productDetail.studioNoteTitle'|trans({ '%name%': product.translated.name })|sw_sanitize }}</h2>
            </div>

            <dl class="veylune-product-detail__facts">
                <div>
                    <dt>{{ 'veylune.productDetail.atelier'|trans|sw_sanitize }}</dt>
                    <dd>{{ product.manufacturer.translated.name|default('veylune.header.logoText'|trans|sw_sanitize) }}</dd>
                </div>

                {% if product.productNumber %}
                    <div>
                        <dt>{{ 'veylune.productDetail.reference'|trans|sw_sanitize }}</dt>
                        <dd>{{ product.productNumber }}</dd>
                    </div>
                {% endif %}

                <div>
                    <dt>{{ 'veylune.productDetail.availability'|trans|sw_sanitize }}</dt>
                    <dd>
                        {% if product.available %}
                            {{ 'veylune.productDetail.available'|trans|sw_sanitize }}
                        {% else %}
                            {{ 'veylune.productDetail.availabilityOnRequest'|trans|sw_sanitize }}
                        {% endif %}
                    </dd>
                </div>

                {% if product.width or product.height or product.length %}
                    <div>
                        <dt>{{ 'veylune.productDetail.dimensions'|trans|sw_sanitize }}</dt>
                        <dd>
                            {% if product.width %}{{ product.width }}{% else %}-{% endif %}
                            x
                            {% if product.height %}{{ product.height }}{% else %}-{% endif %}
                            x
                            {% if product.length %}{{ product.length }}{% else %}-{% endif %}
                            mm
                        </dd>
                    </div>
                {% endif %}
            </dl>
        </section>
    </article>
{% endblock %}
