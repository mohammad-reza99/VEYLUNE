{% sw_extends '@Storefront/storefront/page/content/index.html.twig' %}

{% block base_main_inner %}
	{% import '@VeyluneTheme/storefront/veylune/category-routes.html.twig' as veyluneCategoryRoutes %}
	{% set cmsPage = page.landingPage ? page.landingPage.cmsPage : page.cmsPage|default(null) %}
		{% set activeCategory = page.category|default(page.header.navigation.active|default(null)) %}
	{% set categoryCustomFields = activeCategory.translated.customFields|default(activeCategory.customFields|default({})) %}
	{% set cmsCustomFields = cmsPage.translated.customFields|default(cmsPage.customFields|default({})) %}
		{% set veyluneIdentifier = categoryCustomFields.veylune_page_identifier|default(cmsCustomFields.veylune_page_identifier|default(null)) %}
		{% set veyluneCmsClasses = (cmsPage.cssClass|default(''))|trim|split(' ') %}
		{% set veyluneRouteName = app.request.attributes.get('_route') %}
		{% set isVeyluneCollectionPage = veyluneRouteName == 'frontend.navigation.page' %}
		{% set veyluneCollectionsCategoryId = '019e47255c4f7a8f947adc9f036f367f' %}
		{% set veylunePageType = null %}
	{% set veyluneEcosystemType = null %}
	{% set veyluneLegacyType = null %}
	{% set veyluneDetectedType = categoryCustomFields.veylune_page_type|default(cmsCustomFields.veylune_page_type|default(veyluneIdentifier)) %}
	{% if veyluneDetectedType in ['partnership', 'supplier', 'atelier'] or 'veylune-page-partnership' in veyluneCmsClasses %}
		{% set veylunePageType = 'partnership' %}
	{% elseif veyluneDetectedType in ['legacy', 'mythology'] or 'veylune-page-legacy' in veyluneCmsClasses %}
		{% set veyluneLegacyType = 'legacy' %}
	{% elseif veyluneDetectedType in ['culture', 'cultural'] or 'veylune-page-culture' in veyluneCmsClasses %}
		{% set veyluneLegacyType = 'culture' %}
	{% elseif veyluneDetectedType in ['archive', 'lineage'] or 'veylune-page-archive' in veyluneCmsClasses %}
		{% set veyluneLegacyType = 'archive' %}
	{% elseif veyluneDetectedType in ['exhibitions', 'exhibition', 'showroom'] or 'veylune-page-exhibitions' in veyluneCmsClasses %}
		{% set veyluneLegacyType = 'exhibitions' %}
	{% elseif veyluneDetectedType in ['private', 'private-access', 'members', 'membership'] or 'veylune-page-private-access' in veyluneCmsClasses %}
		{% set veyluneEcosystemType = 'private' %}
	{% elseif veyluneDetectedType in ['collector', 'collectors'] or 'veylune-page-collectors' in veyluneCmsClasses %}
		{% set veyluneEcosystemType = 'collectors' %}
	{% elseif veyluneDetectedType in ['rooms', 'rooms-universe', 'interior-universe'] or 'veylune-page-rooms' in veyluneCmsClasses %}
		{% set veyluneEcosystemType = 'rooms' %}
	{% elseif veyluneDetectedType in ['world', 'ecosystem'] or 'veylune-page-world' in veyluneCmsClasses %}
		{% set veyluneEcosystemType = 'world' %}
	{% elseif veyluneDetectedType in ['consultation', 'inquiry'] or 'veylune-page-consultation' in veyluneCmsClasses %}
		{% set veylunePageType = 'consultation' %}
	{% elseif veyluneDetectedType == 'contact' or 'veylune-page-contact' in veyluneCmsClasses %}
		{% set veylunePageType = 'contact' %}
	{% elseif veyluneDetectedType in ['trade', 'architect', 'designer'] or 'veylune-page-trade' in veyluneCmsClasses %}
		{% set veylunePageType = 'trade' %}
	{% elseif veyluneDetectedType in ['journal', 'editorial'] or 'veylune-page-journal' in veyluneCmsClasses %}
		{% set veylunePageType = 'journal' %}
	{% elseif veyluneDetectedType in ['about', 'story', 'studio'] or 'veylune-page-about' in veyluneCmsClasses %}
		{% set veylunePageType = 'about' %}
	{% endif %}
	{% set veyluneRoutes = {
        shop: veyluneCategoryRoutes.url('furniture'),
        consultation: veyluneCategoryRoutes.url('consultation'),
        editions: path(app.request.locale starts with 'de' ? 'frontend.veylune.editions.page.de' : 'frontend.veylune.editions.page')
    } %}

			{% if app.request.attributes.get('_route') == 'frontend.home.page' %}
                {% set publicSurfaces = veylunePublicSurfaces|default({}) %}
				{% set veyluneProductExposure = page.extensions.veyluneProductExposure|default(null) %}
				{% set veyluneNewArrivalProducts = veyluneProductExposure ? veyluneProductExposure.get('new-arrivals') : [] %}
				{% set veyluneFounderSelectionProducts = veyluneProductExposure ? veyluneProductExposure.get('founder-selection') : [] %}
				{% set veyluneDepartments = [
					{ key: 'furniture', label: 'veylune.home.discovery.categories.furniture', target: veyluneCategoryRoutes.url('furniture') },
					{ key: 'lighting', label: 'veylune.home.discovery.categories.lighting', target: veyluneCategoryRoutes.url('departmentLighting') },
					{ key: 'decor', label: 'veylune.home.discovery.categories.decorObjects', target: veyluneCategoryRoutes.url('departmentDecorObjects') },
					{ key: 'textiles', label: 'veylune.home.discovery.categories.textilesRugs', target: veyluneCategoryRoutes.url('textilesRugs') },
					{ key: 'dining', label: 'veylune.home.discovery.categories.diningKitchen', target: veyluneCategoryRoutes.url('diningKitchen') },
					{ key: 'outdoor', label: 'veylune.home.discovery.categories.outdoor', target: veyluneCategoryRoutes.url('departmentOutdoor') }
				] %}
				{% set veyluneDiscoveryRooms = [
					{ key: 'living-room', label: 'veylune.home.discovery.rooms.livingRoom', target: path('frontend.veylune.discovery.room', { roomKey: 'living-room' }) },
					{ key: 'dining-room', label: 'veylune.home.discovery.rooms.diningRoom', target: path('frontend.veylune.discovery.room', { roomKey: 'dining-room' }) }
				] %}
				<main class="veylune-home" data-veylune-home>
                    {% if publicSurfaces.catalog|default(false) %}
					<nav class="veylune-department-strip" aria-label="{{ 'veylune.home.departmentStripAriaLabel'|trans|striptags }}" data-veylune-registry-scope="homepage-departments">
						<div class="veylune-department-strip__track">
							{% for department in veyluneDepartments %}
								<a href="{{ department.target }}"
								   data-veylune-registry-key="{{ department.key }}"
								   data-veylune-discovery-type="department">
									{{ department.label|trans|sw_sanitize }}
								</a>
							{% endfor %}
						</div>
					</nav>
                    {% endif %}

					<section class="veylune-home__scene veylune-home-hero veylune-home-hero--commerce" data-veylune-reveal>
						<div class="veylune-home-hero__inner">
							<div class="veylune-home-hero__content">
							<p class="veylune-home__eyebrow">{{ 'veylune.home.heroEyebrow'|trans|sw_sanitize }}</p>
							<h1 class="veylune-home-hero__title">{{ 'veylune.home.heroTitle'|trans|sw_sanitize }}</h1>
							<p class="veylune-home-hero__text">
								{{ 'veylune.home.heroText'|trans|sw_sanitize }}
							</p>
							<div class="veylune-home-hero__actions">
                                {% if publicSurfaces['category:furniture']|default(false) %}
                                    <a class="veylune-home__link" href="{{ veyluneRoutes.shop }}">{{ 'veylune.home.exploreCollections'|trans|sw_sanitize }}</a>
                                {% else %}
                                    <a class="veylune-home__link" href="{{ veyluneRoutes.editions }}">{{ 'veylune.header.nav.journal'|trans|sw_sanitize }}</a>
                                {% endif %}
							</div>
						</div>
					</div>
				</section>

                {% if veyluneNewArrivalProducts is not empty or veyluneFounderSelectionProducts is not empty or publicSurfaces.rooms|default(false) %}
				<section class="veylune-home__scene veylune-discovery-foundation" id="veylune-home-discovery" data-veylune-reveal data-veylune-registry-scope="homepage-discovery">
                    {% if veyluneNewArrivalProducts is not empty %}
					<section class="veylune-discovery-module veylune-discovery-module--products veylune-discovery-module--primary" id="veylune-new-arrivals-foundation" aria-labelledby="veylune-new-arrivals-title" data-veylune-registry-entity="new-arrivals">
						<div class="veylune-home__section-head veylune-home__section-head--with-action">
							<div>
							<p class="veylune-home__eyebrow">{{ 'veylune.home.discovery.newArrivals.eyebrow'|trans|sw_sanitize }}</p>
							<h2 id="veylune-new-arrivals-title">{{ 'veylune.home.discovery.newArrivals.title'|trans|sw_sanitize }}</h2>
							</div>
							<a class="veylune-home__link" href="{{ veyluneCategoryRoutes.url('newArrivals') }}">{{ 'veylune.home.viewAll'|trans|sw_sanitize }}</a>
						</div>
						{% if veyluneNewArrivalProducts is not empty %}
							<div class="veylune-product-rail veylune-product-rail--primary"
								 role="region"
								 aria-label="{{ 'veylune.home.discovery.newArrivals.title'|trans|striptags }}"
								 tabindex="0">
							{% for product in veyluneNewArrivalProducts %}
								{% sw_include '@Storefront/storefront/component/product/card/box-standard.html.twig' with {
									product: product,
									layout: 'standard',
									sizes: {
										xs: '82vw',
										sm: '46vw',
										md: '44vw',
										lg: '32vw',
										xl: '32vw'
									}
								} %}
							{% endfor %}
						</div>
						{% endif %}
					</section>
                    {% endif %}

                    {% if veyluneFounderSelectionProducts is not empty %}
					<section class="veylune-discovery-module veylune-discovery-module--products veylune-discovery-module--secondary" aria-labelledby="veylune-founder-selection-title" data-veylune-registry-entity="founder-selection">
						<div class="veylune-home__section-head veylune-home__section-head--with-action">
							<div>
								<p class="veylune-home__eyebrow">{{ 'veylune.home.discovery.founderSelection.eyebrow'|trans|sw_sanitize }}</p>
								<h2 id="veylune-founder-selection-title">{{ 'veylune.home.discovery.founderSelection.title'|trans|sw_sanitize }}</h2>
							</div>
							<a class="veylune-home__link" href="{{ veyluneCategoryRoutes.url('founderSelection') }}">{{ 'veylune.home.viewAll'|trans|sw_sanitize }}</a>
						</div>
						{% if veyluneFounderSelectionProducts is not empty %}
							<div class="veylune-product-rail veylune-product-rail--secondary"
								 role="region"
								 aria-label="{{ 'veylune.home.discovery.founderSelection.title'|trans|striptags }}"
								 tabindex="0">
								{% for product in veyluneFounderSelectionProducts %}
									{% sw_include '@Storefront/storefront/component/product/card/box-standard.html.twig' with {
										product: product,
										layout: 'standard',
										sizes: {
											xs: '82vw',
											sm: '46vw',
											md: '32vw',
											lg: '24vw',
											xl: '24vw'
										}
									} %}
								{% endfor %}
							</div>
						{% endif %}
					</section>
                    {% endif %}

                    {% if publicSurfaces.rooms|default(false) %}
					<section class="veylune-discovery-module veylune-room-strip" id="veylune-discovery-rooms" aria-labelledby="veylune-discovery-rooms-label" data-veylune-registry-entity="rooms">
						<p class="veylune-home__eyebrow" id="veylune-discovery-rooms-label">{{ 'veylune.home.discovery.rooms.eyebrow'|trans|sw_sanitize }}</p>
						<div class="veylune-room-strip__track">
							{% for room in veyluneDiscoveryRooms %}
								<a href="{{ room.target }}"
								   data-veylune-registry-key="{{ room.key }}"
								   data-veylune-discovery-type="room">
									<span>{{ room.label|trans|sw_sanitize }}</span>
									<span aria-hidden="true">→</span>
								</a>
							{% endfor %}
						</div>
					</section>
                    {% endif %}
				</section>
                {% endif %}

			<section class="veylune-home__scene veylune-trade" data-veylune-reveal>
				<div class="veylune-trade__inner">
					<div>
						<p class="veylune-home__eyebrow">{{ 'veylune.home.tradeEyebrow'|trans|sw_sanitize }}</p>
						<h2>{{ 'veylune.home.tradeTitle'|trans|sw_sanitize }}</h2>
					</div>
					<div class="veylune-trade__list">
						<span>{{ 'veylune.home.tradeProgram'|trans|sw_sanitize }}</span>
						<span>{{ 'veylune.home.privateConsultation'|trans|sw_sanitize }}</span>
						<span>{{ 'veylune.home.curatedSourcing'|trans|sw_sanitize }}</span>
						<span>{{ 'veylune.home.designPartnerships'|trans|sw_sanitize }}</span>
					</div>
					<a class="veylune-home__link" href="{{ veyluneRoutes.consultation }}">{{ 'veylune.home.beginPrivateDialogue'|trans|sw_sanitize }}</a>
				</div>
			</section>

		</main>
	{% elseif veyluneLegacyType %}
		{% sw_include '@Storefront/storefront/veylune/legacy.html.twig' with {
            veyluneLegacyType: veyluneLegacyType
        } %}
	{% elseif veyluneEcosystemType %}
		{% sw_include '@Storefront/storefront/veylune/ecosystem.html.twig' with {
            veyluneEcosystemType: veyluneEcosystemType
        } %}
	{% elseif veylunePageType %}
		{% sw_include '@Storefront/storefront/veylune/professional-pages.html.twig' with {
            veylunePageType: veylunePageType
        } %}
	{% elseif isVeyluneCollectionPage %}
		<main class="veylune-collection-page">
				{% set cmsPageClasses = ('cms-page ' ~ cmsPage.cssClass|striptags)|trim %}
				{% set landingPage = page.landingPage ? page.landingPage : {} %}
				{% set activeCategory = page.category|default(page.header.navigation.active) %}

				<section class="veylune-collection-intro">
					<div class="veylune-collection-intro__inner">
						<div>
							<p class="veylune-collection-intro__eyebrow">{{ 'veylune.listing.collectionArchive'|trans|sw_sanitize }}</p>
						<h1>{{ activeCategory.translated.name|default('veylune.listing.curatedCollection'|trans|sw_sanitize) }}</h1>
					</div>
					<p>
						{{ activeCategory.translated.description|striptags|default('veylune.listing.collectionFallbackText'|trans|sw_sanitize) }}
					</p>
					</div>
				</section>

				{% if activeCategory.id == veyluneCollectionsCategoryId %}
					{% set collectionNavigation = page.header.navigation.getChildren(activeCategory.id)|default(null) %}
					{% set collectionChildren = collectionNavigation.tree|default([]) %}

						<section class="veylune-collection-overview" aria-labelledby="veylune-collection-overview-title">
							<div class="veylune-collection-overview__head">
								<div>
									<p class="veylune-collection-intro__eyebrow">{{ 'veylune.listing.overviewEyebrow'|trans|sw_sanitize }}</p>
									<h2 id="veylune-collection-overview-title">{{ 'veylune.listing.overviewTitle'|trans|sw_sanitize }}</h2>
								</div>
								<p>{{ 'veylune.listing.overviewText'|trans|sw_sanitize }}</p>
							</div>

							<div class="veylune-collection-overview__grid">
							{% if collectionChildren|length > 0 %}
									{% for childItem in collectionChildren %}
										{% set childCategory = childItem.category %}
										{% set childName = childCategory.translated.name|default(childCategory.name) %}
										{% set childDescription = childCategory.translated.description|default(childCategory.description)|striptags %}
										{% set childMedia = childCategory.media|default(null) %}
										{% if not childMedia and childCategory.mediaId|default(null) %}
											{% set childMediaCollection = searchMedia([childCategory.mediaId], context.context) %}
											{% set childMedia = childMediaCollection.get(childCategory.mediaId) %}
										{% endif %}

											<a class="veylune-collection-overview-card" href="{{ path('frontend.navigation.page', { navigationId: childCategory.id }) }}">
												<span class="veylune-collection-overview-card__media {% if not childMedia %}is-fallback{% endif %}">
													{% if childMedia %}
														{% sw_thumbnails 'veylune-collection-overview-card' with {
														media: childMedia,
														sizes: {
															default: '560px'
														},
													attributes: {
														class: 'veylune-collection-overview-card__image',
														alt: childName,
														loading: 'lazy'
													}
													} %}
												{% endif %}
											</span>
											<span class="veylune-collection-overview-card__veil" aria-hidden="true"></span>
											<span class="veylune-collection-overview-card__body">
												<span class="veylune-collection-overview-card__meta">
													<span class="veylune-collection-overview-card__index">0{{ loop.index }}</span>
													<span>{{ 'veylune.listing.overviewEyebrow'|trans|sw_sanitize }}</span>
												</span>
												<strong>
													<span>{{ childName }}</span>
												</strong>
												<em>{{ childDescription ?: 'veylune.listing.collectionChildFallbackText'|trans|sw_sanitize }}</em>
												<span class="veylune-collection-overview-card__link">{{ 'veylune.listing.exploreCategory'|trans({'%name%': childName})|sw_sanitize }}</span>
											</span>
									</a>
								{% endfor %}
								{% else %}
									{% set fallbackCollectionChildren = [
										{ name: 'Seating', id: '019e472688de7a4488d2ccaa9f4c1aca', mediaId: '019e4cf2dd9e78d292535317e4db4fdb' },
										{ name: 'Tables', id: '019e4726c20076f092111b3a35ebdc0e', mediaId: '019e51166fea7e76a5e1c3e08c12146d' },
										{ name: 'Lighting', id: '019e4726e79d7edfa7209e2333b29a58', mediaId: '019e4c3ec019755ca6f737ba688a885d' },
										{ name: 'Objects', id: '019e4727472c7ba280e48539675d26f3', mediaId: '019e4c472dad7ed280fcdfd7809ac6a4' }
									] %}

										{% for childCategory in fallbackCollectionChildren %}
											{% set fallbackMedia = null %}
											{% if childCategory.mediaId|default(null) %}
												{% set fallbackMediaCollection = searchMedia([childCategory.mediaId], context.context) %}
												{% set fallbackMedia = fallbackMediaCollection.get(childCategory.mediaId) %}
											{% endif %}
											<a class="veylune-collection-overview-card" href="{{ path('frontend.navigation.page', { navigationId: childCategory.id }) }}">
												<span class="veylune-collection-overview-card__media {% if not fallbackMedia %}is-fallback{% endif %}" aria-hidden="true">
													{% if fallbackMedia %}
														{% sw_thumbnails 'veylune-collection-overview-card' with {
															media: fallbackMedia,
															sizes: {
																default: '560px'
															},
															attributes: {
																class: 'veylune-collection-overview-card__image',
																alt: childCategory.name,
																loading: 'lazy'
															}
														} %}
													{% endif %}
												</span>
												<span class="veylune-collection-overview-card__veil" aria-hidden="true"></span>
											<span class="veylune-collection-overview-card__body">
												<span class="veylune-collection-overview-card__meta">
													<span class="veylune-collection-overview-card__index">0{{ loop.index }}</span>
													<span>{{ 'veylune.listing.overviewEyebrow'|trans|sw_sanitize }}</span>
												</span>
												<strong>
													<span>{{ childCategory.name }}</span>
												</strong>
												<em>{{ 'veylune.listing.collectionChildFallbackText'|trans|sw_sanitize }}</em>
												<span class="veylune-collection-overview-card__link">{{ 'veylune.listing.exploreCategory'|trans({'%name%': childCategory.name})|sw_sanitize }}</span>
											</span>
									</a>
								{% endfor %}
							{% endif %}
						</div>
					</section>
				{% endif %}

				<div class="{{ cmsPageClasses }} veylune-cms-page veylune-cms-page--content veylune-collection-page__cms">
					{% block page_content_blocks %}
						{% sw_include '@Storefront/storefront/page/content/detail.html.twig' with {cmsPage: cmsPage, landingPage: landingPage} %}
				{% endblock %}
			</div>

			<section class="veylune-collection-story">
				<div class="veylune-collection-story__inner">
					<p class="veylune-collection-intro__eyebrow">{{ 'veylune.listing.materialMood'|trans|sw_sanitize }}</p>
					<h2>{{ 'veylune.listing.materialMoodTitle'|trans|sw_sanitize }}</h2>
					<p>
						{{ 'veylune.listing.materialMoodText'|trans|sw_sanitize }}
					</p>
				</div>
			</section>
		</main>
	{% else %}
		{% set cmsPageClasses = ('cms-page ' ~ cmsPage.cssClass|striptags)|trim %}
		{% set landingPage = page.landingPage ? page.landingPage : {} %}

		<main class="veylune-cms-page-main">
			<div class="{{ cmsPageClasses }} veylune-cms-page veylune-cms-page--content">
				{% block veylune_generic_page_content_blocks %}
					{% sw_include '@Storefront/storefront/page/content/detail.html.twig' with {cmsPage: cmsPage, landingPage: landingPage} %}
				{% endblock %}
			</div>
		</main>
	{% endif %}
{% endblock %}
