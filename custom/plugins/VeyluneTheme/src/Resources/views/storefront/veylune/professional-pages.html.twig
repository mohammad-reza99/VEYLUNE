{% set authorityPages = {
    about: {
        label: 'Brand Story',
        title: 'A design house for collectible interiors.',
        text: 'VEYLUNE STUDIO composes sculptural furniture, atmospheric objects, and quiet European interiors with the restraint of a gallery and the warmth of a lived home.',
        accent: 'Studio manifesto'
    },
    trade: {
        label: 'veylune.marketplace.trade.label'|trans|sw_sanitize,
        title: 'veylune.marketplace.trade.title'|trans|sw_sanitize,
        text: 'veylune.marketplace.trade.text'|trans|sw_sanitize,
        accent: 'veylune.marketplace.trade.accent'|trans|sw_sanitize
    },
    partnership: {
        label: 'veylune.partnership.hero.label'|trans|sw_sanitize,
        title: 'veylune.partnership.hero.title'|trans|sw_sanitize,
        text: 'veylune.partnership.hero.text'|trans|sw_sanitize,
        accent: 'veylune.partnership.hero.accent'|trans|sw_sanitize
    },
    consultation: {
        label: 'veylune.marketplace.consultation.label'|trans|sw_sanitize,
        title: 'veylune.marketplace.consultation.title'|trans|sw_sanitize,
        text: 'veylune.marketplace.consultation.text'|trans|sw_sanitize,
        accent: 'veylune.marketplace.consultation.accent'|trans|sw_sanitize
    },
    contact: {
        label: 'Contact Ecosystem',
        title: 'The right conversation, directed with care.',
        text: 'Reach the studio through dedicated channels for private clients, trade professionals, atelier partners, and editorial conversations.',
        accent: 'Communication'
    },
    journal: {
        label: 'Editorial Authority',
        title: 'Notes on atmosphere, material, and sculptural living.',
        text: 'The VEYLUNE journal frames interiors as emotional architecture: studies in light, proportion, object presence, and European design restraint.',
        accent: 'Design journal'
    }
} %}

{% set current = authorityPages[veylunePageType]|default(authorityPages.about) %}
{% set veyluneContactPageId = config('core.basicInformation.contactPage') %}
{% set veyluneInquiryUrl = path('frontend.veylune.contact.page') %}
{% set veyluneRoutes = {
    consultation: path('frontend.veylune.consultation.page'),
    trade: path('frontend.veylune.trade.page'),
    tradeContact: path('frontend.veylune.contact.page', { from: 'trade' }),
    partnership: path('frontend.veylune.partnership.page'),
    contact: veyluneInquiryUrl
} %}
{% set vliProjectHandoff = veyluneProjectHandoff|default({ source: 'consultation', query: '', object: '' }) %}
{% set vliContactParameters = { from: vliProjectHandoff.source|default('consultation') } %}
{% if vliProjectHandoff.query|default('') %}
    {% set vliContactParameters = vliContactParameters|merge({ q: vliProjectHandoff.query }) %}
{% endif %}
{% if vliProjectHandoff.object|default('') %}
    {% set vliContactParameters = vliContactParameters|merge({ object: vliProjectHandoff.object }) %}
{% endif %}
{% set vliAuthorityAxis = veylunePageType == 'partnership' ? 'maker' : (veylunePageType == 'consultation' ? 'project' : null) %}
{% set vliAuthorityAxisLabel = (vliAuthorityAxis == 'maker' ? 'veylune.marketplace.header.axes.maker' : 'veylune.marketplace.header.axes.project')|trans %}
{% set vliAuthorityAsset = vliAuthorityAxis == 'maker' ? 'veylune-room-workspace-v1.webp' : 'veylune-promo-living-room-v1.webp' %}

<div class="veylune-authority veylune-authority--{{ veylunePageType }}{% if vliAuthorityAxis %} vli-axis-page vli-axis-page--{{ vliAuthorityAxis }}{% endif %}"
     data-veylune-authority
     {% if vliAuthorityAxis %}data-veylune-living-index-axis="{{ vliAuthorityAxis }}" data-veylune-registry-scope="living-index-axis" data-veylune-registry-entity="{{ vliAuthorityAxis }}"{% endif %}>
    {% if vliAuthorityAxis %}
        <nav class="vli-axis-page__breadcrumb" aria-label="{{ 'veylune.marketplace.consultation.breadcrumb'|trans|striptags }}">
            <a href="{{ path('frontend.home.page') }}">{{ 'veylune.marketplace.consultation.home'|trans|sw_sanitize }}</a>
            <span aria-hidden="true">/</span>
            <span>{{ 'veylune.marketplace.consultation.livingIndex'|trans|sw_sanitize }}</span>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{{ vliAuthorityAxisLabel }}</span>
        </nav>
    {% endif %}

    <section class="veylune-authority-hero" data-veylune-reveal>
        <div class="veylune-authority-hero__grain" aria-hidden="true"></div>
        <div class="veylune-authority-hero__inner">
            <div class="veylune-authority-hero__content">
                <p class="veylune-authority__eyebrow">{{ current.label }}</p>
                <h1>{{ current.title }}</h1>
                <p>{{ current.text }}</p>
            </div>
            {% if vliAuthorityAxis %}
                <figure class="veylune-authority-hero__visual" data-veylune-parallax>
                    <figcaption>{{ vliAuthorityAxis == 'maker' ? 'Maker / atelier and discipline' : 'veylune.marketplace.consultation.figureCaption'|trans|sw_sanitize }}</figcaption>
                    <img src="{{ asset('assets/' ~ vliAuthorityAsset, 'theme') }}"
                         alt="{{ vliAuthorityAxis == 'maker' ? 'A quiet atelier workspace shaped by material and craft' : 'veylune.marketplace.consultation.figureAlt'|trans|striptags }}"
                         loading="eager"
                         fetchpriority="high">
                </figure>
            {% else %}
                <div class="veylune-authority-hero__visual" data-veylune-parallax aria-hidden="true">
                    <span>{{ current.accent }}</span>
                </div>
            {% endif %}
        </div>
    </section>

    {% if vliAuthorityAxis %}
        {% sw_include '@Storefront/storefront/veylune/living-index-axis-map.html.twig' with {
            veyluneLivingIndexAxis: vliAuthorityAxis
        } %}
    {% endif %}

    {% if veylunePageType == 'about' %}
        <section class="veylune-authority-section veylune-manifesto" data-veylune-reveal>
            <div class="veylune-authority-section__head">
                <p class="veylune-authority__eyebrow">Philosophy</p>
                <h2>We believe rooms should be edited like collections, not filled like inventories.</h2>
            </div>
            <div class="veylune-manifesto__grid">
                {% set principles = [
                    { title: 'Sculptural Forms', text: 'Pieces chosen for silhouette, tension, and the way they hold space.' },
                    { title: 'Atmospheric Interiors', text: 'Light, shadow, texture, and silence treated as part of the composition.' },
                    { title: 'Timeless Materiality', text: 'Stone, wood, bronze, textile, and surface selected for permanence.' },
                    { title: 'Collectible Living', text: 'A slower relationship to objects, shaped by meaning and proportion.' }
                ] %}
                {% for principle in principles %}
                    <article class="veylune-authority-card">
                        <span>0{{ loop.index }}</span>
                        <h3>{{ principle.title }}</h3>
                        <p>{{ principle.text }}</p>
                    </article>
                {% endfor %}
            </div>
        </section>

        <section class="veylune-authority-statement" data-veylune-reveal>
            <p>VEYLUNE is building a design world where sourcing, editorial direction, and collectible furniture become one coherent cultural language.</p>
        </section>
    {% endif %}

    {% if veylunePageType == 'trade' %}
        <section class="veylune-authority-section veylune-trade-program" data-veylune-reveal>
            <div class="veylune-authority-section__head">
                <p class="veylune-authority__eyebrow">{{ 'veylune.marketplace.trade.eyebrow'|trans|sw_sanitize }}</p>
                <h2>{{ 'veylune.marketplace.trade.sectionTitle'|trans|sw_sanitize }}</h2>
            </div>
            <div class="veylune-trade-program__grid">
                {% set benefits = [
                    'veylune.marketplace.trade.benefitOne'|trans,
                    'veylune.marketplace.trade.benefitTwo'|trans,
                    'veylune.marketplace.trade.benefitThree'|trans,
                    'veylune.marketplace.trade.benefitFour'|trans,
                    'veylune.marketplace.trade.benefitFive'|trans,
                    'veylune.marketplace.trade.benefitSix'|trans
                ] %}
                {% for benefit in benefits %}
                    <div class="veylune-authority-card">
                        <span>0{{ loop.index }}</span>
                        <h3>{{ benefit }}</h3>
                    </div>
                {% endfor %}
            </div>
        </section>

    {% endif %}

    {% if veylunePageType == 'partnership' %}
        {% sw_include '@Storefront/storefront/veylune/partnership/content.html.twig' %}
    {% endif %}

    {% if veylunePageType == 'consultation' %}
        <section class="veylune-authority-section vli-project-brief" aria-labelledby="vli-project-brief-title" data-veylune-reveal>
            <header class="vli-axis-section-head">
                <div>
                    <p class="veylune-authority__eyebrow">{{ 'veylune.marketplace.consultation.briefEyebrow'|trans|sw_sanitize }}</p>
                    <h2 id="vli-project-brief-title">{{ 'veylune.marketplace.consultation.briefTitle'|trans|sw_sanitize }}</h2>
                </div>
                <p>{{ 'veylune.marketplace.consultation.briefText'|trans|sw_sanitize }}</p>
            </header>
            <div class="vli-project-brief__grid">
                {% set briefSignals = [
                    { title: 'veylune.marketplace.consultation.space'|trans, text: 'veylune.marketplace.consultation.spaceText'|trans },
                    { title: 'veylune.marketplace.consultation.direction'|trans, text: 'veylune.marketplace.consultation.directionText'|trans },
                    { title: 'veylune.marketplace.consultation.constraints'|trans, text: 'veylune.marketplace.consultation.constraintsText'|trans },
                    { title: 'veylune.marketplace.consultation.review'|trans, text: 'veylune.marketplace.consultation.reviewText'|trans }
                ] %}
                {% for signal in briefSignals %}
                    <article>
                        <span>0{{ loop.index }}</span>
                        <h3>{{ signal.title }}</h3>
                        <p>{{ signal.text }}</p>
                    </article>
                {% endfor %}
            </div>

            {% if vliProjectHandoff.source|default('') == 'selection' %}
                <aside class="vli-project-handoff" data-vli-project-handoff aria-label="{{ 'veylune.marketplace.consultation.selectionAria'|trans|striptags }}">
                    <div>
                        <span class="vli-project-handoff__icon" aria-hidden="true">&#9825;</span>
                        <p><strong>{{ 'veylune.marketplace.consultation.pathsReady'|trans({'%count%': '<span data-vli-selection-count>0</span>', '%label%': '<span data-vli-selection-count-label>paths</span>'})|raw }}</strong></p>
                        <p>{{ 'veylune.marketplace.consultation.selectionText'|trans|sw_sanitize }}</p>
                    </div>
                    <a href="{{ path('frontend.veylune.contact.page', vliContactParameters) }}">{{ 'veylune.marketplace.consultation.buildBrief'|trans|sw_sanitize }} <span aria-hidden="true">&rarr;</span></a>
                </aside>
            {% endif %}

            <ol class="vli-consultation-process" aria-label="{{ 'veylune.marketplace.consultation.processAria'|trans|striptags }}">
                <li>
                    <span>01</span>
                    <div><strong>{{ 'veylune.marketplace.consultation.shareBrief'|trans|sw_sanitize }}</strong><p>{{ 'veylune.marketplace.consultation.shareBriefText'|trans|sw_sanitize }}</p></div>
                </li>
                <li>
                    <span>02</span>
                    <div><strong>{{ 'veylune.marketplace.consultation.studioReview'|trans|sw_sanitize }}</strong><p>{{ 'veylune.marketplace.consultation.studioReviewText'|trans|sw_sanitize }}</p></div>
                </li>
                <li>
                    <span>03</span>
                    <div><strong>{{ 'veylune.marketplace.consultation.agreeDirection'|trans|sw_sanitize }}</strong><p>{{ 'veylune.marketplace.consultation.agreeDirectionText'|trans|sw_sanitize }}</p></div>
                </li>
            </ol>
        </section>
    {% endif %}

    {% if veylunePageType == 'consultation' or veylunePageType == 'trade' %}
        <section class="veylune-authority-section veylune-inquiry" data-veylune-reveal>
            <div class="veylune-inquiry__intro">
                <p class="veylune-authority__eyebrow">{{ 'veylune.professional.privateInquiry'|trans|sw_sanitize }}</p>
                <h2>{{ 'veylune.professional.requestStudioConversation'|trans|sw_sanitize }}</h2>
                <p>{{ 'veylune.professional.inquiryIntro'|trans|sw_sanitize }}</p>
            </div>
            <div class="veylune-inquiry__form" role="group" aria-label="{{ 'veylune.professional.inquiryCtaAriaLabel'|trans|striptags }}">
                <a class="veylune-button veylune-button--primary"
                   href="{{ veylunePageType == 'consultation' ? path('frontend.veylune.contact.page', vliContactParameters) : veyluneRoutes.tradeContact }}"
                   data-vli-project-cta>
                    {{ (veylunePageType == 'consultation' ? 'veylune.professional.contactStudio' : 'veylune.professional.beginPrivateDialogue')|trans|sw_sanitize }}
                </a>
            </div>
        </section>
    {% endif %}

    {% if veylunePageType == 'contact' %}
        <section class="veylune-authority-section veylune-contact-grid" data-veylune-reveal>
            <div class="veylune-authority-section__head">
                <p class="veylune-authority__eyebrow">Contact</p>
                <h2>Each message reaches the right studio conversation.</h2>
            </div>
            {% set contacts = [
                { title: 'Private Clients', email: 'hello@veylune.studio', note: 'Material questions, availability, and reference records.' },
                { title: 'Trade', email: 'trade@veylune.studio', note: 'Designers, architects, hospitality, and procurement.' },
                { title: 'Partnerships', email: 'partnerships@veylune.studio', note: 'Ateliers, suppliers, makers, and collection development.' },
                { title: 'Consultation', email: 'consultation@veylune.studio', note: 'Interior direction, sourcing sessions, and private projects.' }
            ] %}
            <div class="veylune-contact-grid__items">
                {% for contact in contacts %}
                    <a class="veylune-authority-card" href="mailto:{{ contact.email }}">
                        <span>0{{ loop.index }}</span>
                        <h3>{{ contact.title }}</h3>
                        <p>{{ contact.note }}</p>
                        <em>{{ contact.email }}</em>
                    </a>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    {% if veylunePageType == 'journal' %}
        <section class="veylune-authority-section veylune-journal-system" data-veylune-reveal>
            <div class="veylune-authority-section__head">
                <p class="veylune-authority__eyebrow">Editorial System</p>
                <h2>Authority is built through language, material knowledge, and a consistent visual point of view.</h2>
            </div>
            {% set topics = [
                { title: 'Interior Atmosphere', text: 'How light, silence, and proportion shape emotional rooms.' },
                { title: 'Material Studies', text: 'Stone, bronze, wood, textile, and the surface language of permanence.' },
                { title: 'Sculptural Living', text: 'Furniture as form, object, and spatial anchor.' },
                { title: 'European Inspirations', text: 'Gallery restraint, Milanese calm, and architectural domesticity.' }
            ] %}
            <div class="veylune-journal-system__grid">
                {% for topic in topics %}
                    <article class="veylune-journal-card">
                        <div class="veylune-journal-card__media" aria-hidden="true"></div>
                        <span>Journal 0{{ loop.index }}</span>
                        <h3>{{ topic.title }}</h3>
                        <p>{{ topic.text }}</p>
                    </article>
                {% endfor %}
            </div>
        </section>
    {% endif %}

    <section class="veylune-authority-closing" data-veylune-reveal>
        <div>
            <p class="veylune-authority__eyebrow">{{ 'veylune.header.logoText'|trans|sw_sanitize }}</p>
            <h2>{{ 'veylune.professional.closingTitle'|trans|sw_sanitize }}</h2>
        </div>
        <div class="veylune-authority-closing__links">
            <a href="{{ veyluneRoutes.consultation }}">{{ 'veylune.footer.privateConsultation'|trans|sw_sanitize }}</a>
            <a href="{{ veyluneRoutes.partnership }}">{{ 'veylune.footer.atelierPartnerships'|trans|sw_sanitize }}</a>
            <a href="{{ veyluneRoutes.contact }}">{{ 'veylune.professional.contactStudio'|trans|sw_sanitize }}</a>
        </div>
    </section>
</div>
