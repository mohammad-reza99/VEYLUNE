{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_main_inner %}
    {% import '@VeyluneTheme/storefront/veylune/category-routes.html.twig' as veyluneCategoryRoutes %}
    {% set consultationUrl = veyluneCategoryRoutes.url('consultation')|trim %}
    {% set partnershipUrl = path('frontend.veylune.partnership.page') %}

    <main class="veylune-editions" data-veylune-authority>
        <section class="veylune-editions-hero" data-veylune-reveal>
            <div class="veylune-editions-hero__inner">
                <div class="veylune-editions-hero__content">
                    <p class="veylune-editions__eyebrow">{{ 'veylune.editions.hero.eyebrow'|trans|sw_sanitize }}</p>
                    <h1>{{ 'veylune.editions.hero.title'|trans|sw_sanitize }}</h1>
                    <p>{{ 'veylune.editions.hero.text'|trans|sw_sanitize }}</p>
                    {% if consultationUrl and consultationUrl != '#' %}
                        <div class="veylune-editions__actions">
                            <a class="veylune-editions__link" href="{{ consultationUrl }}">{{ 'veylune.editions.cta.privateConsultation'|trans|sw_sanitize }}</a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </section>

        <section class="veylune-editions-section veylune-editions-acquisition" data-veylune-reveal>
            <div>
                <p class="veylune-editions__eyebrow">{{ 'veylune.editions.acquisition.eyebrow'|trans|sw_sanitize }}</p>
                <h2>{{ 'veylune.editions.acquisition.title'|trans|sw_sanitize }}</h2>
            </div>
            <div class="veylune-editions-acquisition__content">
                <p>{{ 'veylune.editions.acquisition.text'|trans|sw_sanitize }}</p>
                {% if consultationUrl and consultationUrl != '#' %}
                    <a class="veylune-editions__link" href="{{ consultationUrl }}">{{ 'veylune.editions.cta.privateConsultation'|trans|sw_sanitize }}</a>
                {% endif %}
            </div>
        </section>
    </main>
{% endblock %}
