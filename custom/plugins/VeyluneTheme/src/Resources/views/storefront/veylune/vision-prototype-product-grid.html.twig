<div class="vlx-product-grid {{ dense|default(false) ? 'vlx-product-grid--dense' : '' }}">
    {% for product in products %}
        <article class="vlx-product-card">
            <a class="vlx-product-card__media" href="{{ path(visionRoute, { surface: 'product' }) }}">
                <img src="{{ asset('assets/products/' ~ product.asset, 'theme') }}" alt="{{ product.name }}">
                <span class="vlx-product-card__badge">Curated</span>
            </a>
            <div class="vlx-product-card__body">
                <p>{{ product.type }} · {{ product.material }}</p>
                <h3><a href="{{ path(visionRoute, { surface: 'product' }) }}">{{ product.name }}</a></h3>
                <span>{{ product.colors }} finishes</span>
                <strong>{{ product.price }}</strong>
            </div>
        </article>
    {% endfor %}
</div>
