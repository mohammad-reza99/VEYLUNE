    {% set veyluneCatalogIsPublic = veyluneCatalogRouteMode|default('preview') == 'public' %}
    {% set veyluneCatalogRouteParams = veyluneCatalogIsPublic ? {} : { token: veylunePreviewToken } %}
    {% set veyluneCatalogCategoryRoute = veyluneCatalogIsPublic ? 'frontend.veylune.catalog.category' : 'frontend.veylune.preview.catalog.category' %}
    {% set veyluneCatalogRoomRoute = veyluneCatalogIsPublic ? 'frontend.veylune.catalog.room' : 'frontend.veylune.preview.catalog.room' %}
    {% set veyluneCatalogCollectionRoute = veyluneCatalogIsPublic ? 'frontend.veylune.catalog.collection' : 'frontend.veylune.preview.catalog.collection' %}
    {% set categoryAssets = {
        furniture: 'furniture', lighting: 'lighting', 'decor-objects': 'decor',
        'textiles-rugs': 'textiles', 'dining-kitchen': 'dining', outdoor: 'outdoor'
    } %}
    {% set categoryNotes = {
        furniture: 'veylune.marketplace.home.categoryNotes.furniture',
        lighting: 'veylune.marketplace.home.categoryNotes.lighting',
        'decor-objects': 'veylune.marketplace.home.categoryNotes.decorObjects',
        'textiles-rugs': 'veylune.marketplace.home.categoryNotes.textilesRugs',
        'dining-kitchen': 'veylune.marketplace.home.categoryNotes.diningKitchen',
        outdoor: 'veylune.marketplace.home.categoryNotes.outdoor'
    } %}
    {% set categoryLabelKeys = {
        furniture: 'veylune.home.discovery.categories.furniture',
        lighting: 'veylune.home.discovery.categories.lighting',
        'decor-objects': 'veylune.home.discovery.categories.decorObjects',
        'textiles-rugs': 'veylune.home.discovery.categories.textilesRugs',
        'dining-kitchen': 'veylune.home.discovery.categories.diningKitchen',
        outdoor: 'veylune.home.discovery.categories.outdoor'
    } %}
    {% set roomLabelKeys = {
        'living-room': 'veylune.home.discovery.rooms.livingRoom',
        'dining-room': 'veylune.home.discovery.rooms.diningRoom',
        bedroom: 'veylune.home.discovery.rooms.bedroom',
        workspace: 'veylune.home.discovery.rooms.workspace',
        hallway: 'veylune.home.discovery.rooms.hallway'
    } %}
    {% set collectionLabelKeys = {
        'new-arrivals': 'veylune.home.discovery.collections.newArrivals',
        'founder-selection': 'veylune.home.discovery.collections.founderSelection'
    } %}
    {% set roomAssets = {
        'living-room': 'living', 'dining-room': 'dining', bedroom: 'bedroom',
        workspace: 'workspace', hallway: 'living'
    } %}
    {% set railTitles = {
        'storefront-test-cohort': 'veylune.marketplace.home.rails.trendingTitle',
        'new-arrivals': 'veylune.marketplace.home.rails.newTitle',
        'founder-selection': 'veylune.marketplace.home.rails.founderTitle',
        'living-room': 'veylune.marketplace.home.rails.livingTitle'
    } %}
    {% set railEyebrows = {
        'storefront-test-cohort': 'veylune.marketplace.home.rails.trendingEyebrow',
        'new-arrivals': veyluneCatalogIsPublic ? 'veylune.marketplace.home.rails.newPublicEyebrow' : 'veylune.marketplace.home.rails.newPrivateEyebrow',
        'founder-selection': 'veylune.marketplace.home.rails.founderEyebrow',
        'living-room': 'veylune.marketplace.home.rails.livingEyebrow'
    } %}
    {% set railTargets = {
        'storefront-test-cohort': path(veyluneCatalogCategoryRoute, veyluneCatalogRouteParams|merge({ categoryKey: 'furniture' })),
        'new-arrivals': path(veyluneCatalogCollectionRoute, veyluneCatalogRouteParams|merge({ collectionKey: 'new-arrivals' })),
        'founder-selection': path(veyluneCatalogCollectionRoute, veyluneCatalogRouteParams|merge({ collectionKey: 'founder-selection' })),
        'living-room': path(veyluneCatalogRoomRoute, veyluneCatalogRouteParams|merge({ roomKey: 'living-room' }))
    } %}

    <div class="veylune-preview-marketplace-home" data-veylune-preview-marketplace-home>
        <div class="veylune-preview-marketplace-home__access" role="note">
            <span>{{ (veyluneCatalogIsPublic ? 'veylune.marketplace.home.catalogPublic' : 'veylune.marketplace.home.catalogPrivate')|trans|sw_sanitize }}</span>
            <p>{{ 'veylune.marketplace.home.catalogText'|trans|sw_sanitize }}</p>
            <a href="{{ path('frontend.account.home.page') }}">{{ 'veylune.marketplace.home.myAccount'|trans|sw_sanitize }}</a>
        </div>

        <section class="veylune-preview-marketplace-hero" aria-labelledby="veylunePreviewMarketplaceTitle">
            <img src="{{ asset('assets/veylune-home-hero-architectural-warm-v1.webp', 'theme') }}"
                 alt="{{ 'veylune.marketplace.home.heroAlt'|trans|striptags }}"
                 width="1536" height="1024" fetchpriority="high" decoding="async">
            <div class="veylune-preview-marketplace-hero__shade" aria-hidden="true"></div>
            <div class="veylune-preview-marketplace-hero__content">
                <p class="veylune-preview-marketplace-home__eyebrow">{{ (veyluneCatalogIsPublic ? 'veylune.marketplace.home.heroPublicEyebrow' : 'veylune.marketplace.home.heroPrivateEyebrow')|trans|sw_sanitize }}</p>
                <h1 id="veylunePreviewMarketplaceTitle">{{ 'veylune.marketplace.home.heroTitle'|trans|sw_sanitize }}</h1>
                <p>{{ 'veylune.marketplace.home.heroText'|trans|sw_sanitize }}</p>
                <div class="veylune-preview-marketplace-hero__actions">
                    <a class="is-primary" href="{{ path(veyluneCatalogCategoryRoute, veyluneCatalogRouteParams|merge({ categoryKey: 'furniture' })) }}">{{ 'veylune.marketplace.home.shopFurniture'|trans|sw_sanitize }}</a>
                    <a href="{{ path(veyluneCatalogCollectionRoute, veyluneCatalogRouteParams|merge({ collectionKey: 'founder-selection' })) }}">{{ 'veylune.marketplace.home.exploreFounder'|trans|sw_sanitize }}</a>
                </div>
            </div>
            <dl class="veylune-preview-marketplace-hero__signals">
                <div><dt>01</dt><dd>{{ 'veylune.marketplace.home.curatedObjects'|trans|sw_sanitize }}</dd></div>
                <div><dt>02</dt><dd>{{ 'veylune.marketplace.home.materialGuidance'|trans|sw_sanitize }}</dd></div>
                <div><dt>03</dt><dd>{{ 'veylune.marketplace.home.studioConsultation'|trans|sw_sanitize }}</dd></div>
            </dl>
        </section>

        <section class="veylune-preview-marketplace-section veylune-preview-marketplace-categories" aria-labelledby="veylunePreviewCategoriesTitle">
            <header class="veylune-preview-marketplace-section__head">
                <div><p class="veylune-preview-marketplace-home__eyebrow">{{ 'veylune.marketplace.home.departmentsEyebrow'|trans|sw_sanitize }}</p><h2 id="veylunePreviewCategoriesTitle">{{ 'veylune.marketplace.home.departmentsTitle'|trans|sw_sanitize }}</h2></div>
                <p>{{ 'veylune.marketplace.home.departmentsText'|trans|sw_sanitize }}</p>
            </header>
            <div class="veylune-preview-marketplace-categories__grid">
                {% for key, label in veylunePreviewCategories %}
                    <a class="veylune-preview-marketplace-category" href="{{ path(veyluneCatalogCategoryRoute, veyluneCatalogRouteParams|merge({ categoryKey: key })) }}">
                        <span class="veylune-preview-marketplace-category__media">
                            <img src="{{ asset('assets/veylune-category-' ~ categoryAssets[key] ~ '-v1.webp', 'theme') }}" alt="" width="1254" height="1254" loading="lazy" decoding="async">
                        </span>
                        <span class="veylune-preview-marketplace-category__content">
                            <strong>{{ categoryLabelKeys[key]|trans|sw_sanitize }}</strong><small>{{ categoryNotes[key]|trans|sw_sanitize }}</small><span>{{ 'veylune.marketplace.home.shopNow'|trans|sw_sanitize }} <span aria-hidden="true">&rarr;</span></span>
                        </span>
                    </a>
                {% endfor %}
            </div>
        </section>

        <section class="veylune-preview-marketplace-section veylune-preview-marketplace-collections" aria-labelledby="veylunePreviewCollectionsTitle">
            <header class="veylune-preview-marketplace-section__head">
                <div><p class="veylune-preview-marketplace-home__eyebrow">{{ 'veylune.marketplace.home.collectionsEyebrow'|trans|sw_sanitize }}</p><h2 id="veylunePreviewCollectionsTitle">{{ 'veylune.marketplace.home.collectionsTitle'|trans|sw_sanitize }}</h2></div>
                <p>{{ 'veylune.marketplace.home.collectionsText'|trans|sw_sanitize }}</p>
            </header>
            <div class="veylune-preview-marketplace-collections__grid">
                {% for key, label in veylunePreviewCollections %}
                    <a class="veylune-preview-marketplace-collection veylune-preview-marketplace-collection--{{ key }}" href="{{ path(veyluneCatalogCollectionRoute, veyluneCatalogRouteParams|merge({ collectionKey: key })) }}">
                        <img src="{{ asset(key == 'founder-selection' ? 'assets/veylune-promo-living-room-v1.webp' : 'assets/veylune-category-furniture-v1.webp', 'theme') }}" alt="" width="1536" height="1024" loading="lazy" decoding="async">
                        <span class="veylune-preview-marketplace-collection__shade" aria-hidden="true"></span>
                        <span class="veylune-preview-marketplace-collection__content">
                            <small>{{ (key == 'founder-selection' ? 'veylune.marketplace.home.signatureEdit' : 'veylune.marketplace.home.recentlyIntroduced')|trans|sw_sanitize }}</small><strong>{{ collectionLabelKeys[key]|trans|sw_sanitize }}</strong><span>{{ 'veylune.marketplace.home.exploreCollection'|trans|sw_sanitize }} <span aria-hidden="true">&rarr;</span></span>
                        </span>
                    </a>
                {% endfor %}
            </div>
        </section>

        {% for railKey, products in veylunePreviewRails %}
            <section class="veylune-preview-marketplace-section veylune-preview-rail" aria-labelledby="preview-rail-{{ railKey }}">
                <header class="veylune-preview-marketplace-section__head veylune-preview-rail__head">
                    <div><p class="veylune-preview-marketplace-home__eyebrow">{{ railEyebrows[railKey]|trans|sw_sanitize }}</p><h2 id="preview-rail-{{ railKey }}">{{ railTitles[railKey]|trans|sw_sanitize }}</h2></div>
                    <a href="{{ railTargets[railKey] }}">{{ 'veylune.marketplace.home.rails.viewAll'|trans({'%count%': products|length})|sw_sanitize }} <span aria-hidden="true">&rarr;</span></a>
                </header>
                <div class="veylune-preview-rail__slider veylune-product-slider" data-veylune-product-slider role="region" aria-roledescription="carousel" aria-labelledby="preview-rail-{{ railKey }}">
                    <button class="veylune-product-slider__control veylune-product-slider__control--previous" type="button" data-veylune-product-slider-previous aria-controls="preview-rail-track-{{ railKey }}" aria-label="{{ 'veylune.marketplace.home.rails.previous'|trans({'%title%': railTitles[railKey]|trans})|striptags }}">&lsaquo;</button>
                    <div class="veylune-preview-rail__track" id="preview-rail-track-{{ railKey }}" data-veylune-product-slider-track tabindex="0">
                        {% for product in products %}
                            {% sw_include '@Storefront/storefront/veylune/catalog-preview-card.html.twig' with { product: product, productIndex: loop.index0 } %}
                        {% endfor %}
                    </div>
                    <button class="veylune-product-slider__control veylune-product-slider__control--next" type="button" data-veylune-product-slider-next aria-controls="preview-rail-track-{{ railKey }}" aria-label="{{ 'veylune.marketplace.home.rails.next'|trans({'%title%': railTitles[railKey]|trans})|striptags }}">&rsaquo;</button>
                </div>
            </section>
        {% endfor %}

        <section class="veylune-preview-marketplace-section veylune-preview-marketplace-rooms" aria-labelledby="veylunePreviewRoomsTitle">
            <header class="veylune-preview-marketplace-section__head">
                <div><p class="veylune-preview-marketplace-home__eyebrow">{{ 'veylune.marketplace.home.roomsEyebrow'|trans|sw_sanitize }}</p><h2 id="veylunePreviewRoomsTitle">{{ 'veylune.marketplace.home.roomsTitle'|trans|sw_sanitize }}</h2></div>
                <p>{{ 'veylune.marketplace.home.roomsText'|trans|sw_sanitize }}</p>
            </header>
            <div class="veylune-preview-marketplace-rooms__slider veylune-product-slider" data-veylune-product-slider>
                <button class="veylune-product-slider__control veylune-product-slider__control--previous" type="button" data-veylune-product-slider-previous aria-controls="veylunePreviewRoomTrack" aria-label="{{ 'veylune.marketplace.home.previousRooms'|trans|striptags }}">&lsaquo;</button>
                <div class="veylune-preview-marketplace-rooms__track" id="veylunePreviewRoomTrack" data-veylune-product-slider-track role="list" aria-roledescription="carousel" aria-label="{{ 'veylune.marketplace.home.roomsAria'|trans|striptags }}" tabindex="0">
                    {% for key, label in veylunePreviewRooms %}
                        <a class="veylune-preview-marketplace-room" role="listitem" href="{{ path(veyluneCatalogRoomRoute, veyluneCatalogRouteParams|merge({ roomKey: key })) }}">
                            <img src="{{ asset('assets/veylune-room-' ~ roomAssets[key] ~ '-v1.webp', 'theme') }}" alt="" width="1024" height="1536" loading="lazy" decoding="async">
                            <span><strong>{{ roomLabelKeys[key]|trans|sw_sanitize }}</strong><small>{{ 'veylune.marketplace.home.exploreRoom'|trans|sw_sanitize }} <span aria-hidden="true">&rarr;</span></small></span>
                        </a>
                    {% endfor %}
                </div>
                <button class="veylune-product-slider__control veylune-product-slider__control--next" type="button" data-veylune-product-slider-next aria-controls="veylunePreviewRoomTrack" aria-label="{{ 'veylune.marketplace.home.nextRooms'|trans|striptags }}">&rsaquo;</button>
            </div>
        </section>

        <section class="veylune-preview-marketplace-services" aria-labelledby="veylunePreviewServicesTitle">
            <div class="veylune-preview-marketplace-services__intro">
                <p class="veylune-preview-marketplace-home__eyebrow">{{ 'veylune.marketplace.home.clientCare'|trans|sw_sanitize }}</p>
                <h2 id="veylunePreviewServicesTitle">{{ 'veylune.marketplace.home.servicesTitle'|trans|sw_sanitize }}</h2>
                <p>{{ (veyluneCatalogIsPublic ? 'veylune.marketplace.home.servicesPublicText' : 'veylune.marketplace.home.servicesPrivateText')|trans|sw_sanitize }}</p>
            </div>
            <div class="veylune-preview-marketplace-services__grid">
                <article><span>01</span><div><h3>{{ 'veylune.marketplace.home.materialServiceTitle'|trans|sw_sanitize }}</h3><p>{{ 'veylune.marketplace.home.materialServiceText'|trans|sw_sanitize }}</p></div></article>
                <article><span>02</span><div><h3>{{ 'veylune.marketplace.home.accessServiceTitle'|trans|sw_sanitize }}</h3><p>{{ 'veylune.marketplace.home.accessServiceText'|trans|sw_sanitize }}</p></div></article>
                <article><span>03</span><div><h3>{{ 'veylune.marketplace.home.projectServiceTitle'|trans|sw_sanitize }}</h3><p>{{ 'veylune.marketplace.home.projectServiceText'|trans|sw_sanitize }}</p></div></article>
            </div>
            <a href="{{ path('frontend.veylune.consultation.page') }}">{{ 'veylune.marketplace.home.consultationCta'|trans|sw_sanitize }} <span aria-hidden="true">&rarr;</span></a>
        </section>
    </div>
