{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_main_inner %}
    {% set brief = veyluneProjectBrief|default({ source: 'direct', query: '', object: '' }) %}
    {% set isTradeBrief = brief.source|default('') == 'trade' %}
    {% set parentRoute = isTradeBrief ? path('frontend.veylune.trade.page') : path('frontend.veylune.consultation.page') %}
    {% set parentLabel = (isTradeBrief ? 'veylune.marketplace.contact.tradeProgram' : 'veylune.marketplace.contact.privateConsultation')|trans %}
    <div class="veylune-contact-page"
         data-veylune-contact-page
         data-vli-project-brief-page
         data-vli-project-source="{{ brief.source|default('direct') }}"
         data-vli-project-query="{{ brief.query|default('') }}"
         data-vli-project-object="{{ brief.object|default('') }}">
        <nav class="veylune-contact-page__breadcrumb" aria-label="{{ 'veylune.marketplace.contact.breadcrumb'|trans|striptags }}">
            <a href="{{ path('frontend.home.page') }}">{{ 'veylune.marketplace.contact.home'|trans|sw_sanitize }}</a>
            <span aria-hidden="true">/</span>
            <a href="{{ parentRoute }}">{{ parentLabel }}</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{{ 'veylune.marketplace.contact.projectBrief'|trans|sw_sanitize }}</span>
        </nav>

        <header class="veylune-contact-page__intro">
            <div>
                <p class="veylune-legal-notice__eyebrow">{{ (isTradeBrief ? 'veylune.marketplace.contact.tradeEyebrow' : 'veylune.marketplace.contact.eyebrow')|trans|sw_sanitize }}</p>
                <h1>{{ (isTradeBrief ? 'veylune.marketplace.contact.tradeTitle' : 'veylune.marketplace.contact.title')|trans|sw_sanitize }}</h1>
                <p>{{ (isTradeBrief ? 'veylune.marketplace.contact.tradeText' : 'veylune.marketplace.contact.text')|trans|sw_sanitize }}</p>
            </div>
            <div class="veylune-contact-page__promise" aria-label="{{ 'veylune.marketplace.contact.boundaryAria'|trans|striptags }}">
                <strong>{{ 'veylune.marketplace.contact.boundaryTitle'|trans|sw_sanitize }}</strong>
                <p>{{ 'veylune.marketplace.contact.boundaryText'|trans|sw_sanitize }}</p>
            </div>
        </header>

        <ol class="veylune-contact-page__steps" aria-label="{{ 'veylune.marketplace.contact.stepsAria'|trans|striptags }}">
            <li aria-current="step"><span>01</span><div><strong>{{ 'veylune.marketplace.contact.stepContext'|trans|sw_sanitize }}</strong><small>{{ 'veylune.marketplace.contact.stepContextText'|trans|sw_sanitize }}</small></div></li>
            <li><span>02</span><div><strong>{{ 'veylune.marketplace.contact.stepDetails'|trans|sw_sanitize }}</strong><small>{{ 'veylune.marketplace.contact.stepDetailsText'|trans|sw_sanitize }}</small></div></li>
            <li><span>03</span><div><strong>{{ 'veylune.marketplace.contact.stepReview'|trans|sw_sanitize }}</strong><small>{{ 'veylune.marketplace.contact.stepReviewText'|trans|sw_sanitize }}</small></div></li>
        </ol>

        <section class="veylune-contact-page__form" aria-label="{{ 'veylune.marketplace.contact.formAria'|trans|striptags }}">
            {% sw_include '@Storefront/storefront/page/content/detail.html.twig' with { cmsPage: cmsPage } %}
        </section>

        <aside class="veylune-contact-page__aside" aria-label="{{ 'veylune.marketplace.contact.beforeAria'|trans|striptags }}">
            <p class="veylune-contact-page__aside-kicker">{{ 'veylune.marketplace.contact.before'|trans|sw_sanitize }}</p>
            <h2>{{ 'veylune.marketplace.contact.usefulTitle'|trans|sw_sanitize }}</h2>
            <p>{{ 'veylune.marketplace.contact.usefulText'|trans|sw_sanitize }}</p>
            <ul>
                <li>{{ 'veylune.marketplace.contact.boundaryOne'|trans|sw_sanitize }}</li>
                <li>{{ 'veylune.marketplace.contact.boundaryTwo'|trans|sw_sanitize }}</li>
                <li>{{ 'veylune.marketplace.contact.boundaryThree'|trans|sw_sanitize }}</li>
            </ul>
            {% if brief.source|default('') == 'selection' %}
                <a class="veylune-contact-page__selection-link" href="{{ path('frontend.checkout.cart.page') }}">{{ 'veylune.marketplace.contact.reviewCart'|trans|sw_sanitize }}</a>
            {% elseif isTradeBrief %}
                <a href="{{ path('frontend.veylune.trade.page') }}">{{ 'veylune.marketplace.contact.tradeHow'|trans|sw_sanitize }}</a>
            {% else %}
                <a href="{{ path('frontend.veylune.consultation.page') }}">{{ 'veylune.marketplace.contact.consultationHow'|trans|sw_sanitize }}</a>
            {% endif %}
        </aside>
    </div>
{% endblock %}
