{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_main_inner %}
    {% set legalSnippetBase = 'veylune.marketplace.legal.' ~ veyluneLegalDocument %}
    <div class="veylune-legal-notice" data-veylune-legal-page="{{ veyluneLegalDocument }}">
        <p class="veylune-legal-notice__eyebrow">{{ 'veylune.marketplace.legal.eyebrow'|trans|sw_sanitize }}</p>
        <h1>{{ (legalSnippetBase ~ '.title')|trans|sw_sanitize }}</h1>
        <p>{{ (legalSnippetBase ~ '.one')|trans|sw_sanitize }}</p>
        <p>{{ (legalSnippetBase ~ '.two')|trans|sw_sanitize }}</p>
        <p><a href="{{ path('frontend.veylune.consultation.page') }}">{{ 'veylune.marketplace.legal.contact'|trans|sw_sanitize }}</a></p>
    </div>
{% endblock %}
