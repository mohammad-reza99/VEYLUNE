<article class="veylune-preview-card"
         data-preview-record="{{ product.recordId }}"
         data-plp-card
         data-plp-type="{{ product.productType }}"
         data-plp-material="{{ product.material }}"
         data-plp-price="{{ product.targetPrice }}"
         data-plp-name="{{ product.name }}">
    <div class="veylune-preview-card__visual veylune-preview-card__visual--{{ product.material|replace({'_': '-'}) }}" role="img" aria-label="{{ product.name }} placeholder study">
        <span class="veylune-preview-card__status">{{ product.status }}</span>
        <span class="veylune-preview-card__object veylune-preview-card__object--{{ product.productType|replace({'_': '-'}) }}" aria-hidden="true"></span>
        <span class="veylune-preview-card__material">{{ product.materialLabel }}</span>
    </div>
    <div class="veylune-preview-card__body">
        <p class="veylune-preview-card__type">{{ product.productType|replace({'_': ' '})|title }}</p>
        <h3>{{ product.name }}</h3>
        <div class="veylune-preview-card__commerce">
            <span>Target price</span>
            <strong>€{{ product.targetPrice|number_format(0, '.', ',') }}</strong>
        </div>
    </div>
</article>
