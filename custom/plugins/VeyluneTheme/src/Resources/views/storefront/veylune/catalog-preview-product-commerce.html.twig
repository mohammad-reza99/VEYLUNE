<section class="veylune-pdp-commerce-options" aria-label="{{ 'veylune.marketplace.pdp.configuration'|trans|striptags }}"
         data-commerce-mode="{{ veylunePdpPresentation.commerce.mode }}"
         data-commerce-state="{{ veylunePdpPresentation.commerce.state }}">
    <div class="veylune-pdp-variants">
        <div class="veylune-pdp-commerce-options__label"><span>{{ 'veylune.marketplace.pdp.materialDirection'|trans|sw_sanitize }}</span><strong data-pdp-variant-label>{{ product.materialLabel }}</strong></div>
        <div class="veylune-pdp-variants__grid" role="group" aria-label="{{ 'veylune.marketplace.pdp.chooseMaterial'|trans|striptags }}">
            <button type="button" data-pdp-variant="{{ product.material }}" data-pdp-variant-name="{{ product.materialLabel }}" aria-pressed="true"><span></span>{{ product.materialLabel }}</button>
            {% for material in product.materials %}
                {% if material != product.material %}
                    <button type="button" data-pdp-variant="{{ material }}" data-pdp-variant-name="{{ material|replace({'_': ' '})|title }}" aria-pressed="false"><span></span>{{ material|replace({'_': ' '})|title }}</button>
                {% endif %}
            {% endfor %}
        </div>
        <p>{{ 'veylune.marketplace.pdp.materialDisclosure'|trans|sw_sanitize }}</p>
    </div>

    <form class="veylune-pdp-delivery" data-pdp-delivery-form novalidate>
        <div><strong>{{ 'veylune.marketplace.pdp.deliveryDestination'|trans|sw_sanitize }}</strong><span>{{ 'veylune.marketplace.pdp.deliveryReadiness'|trans|sw_sanitize }}</span></div>
        <label for="veylunePdpPostalCode">{{ 'veylune.marketplace.pdp.postalCode'|trans|sw_sanitize }}</label>
        <div class="veylune-pdp-delivery__control"><input id="veylunePdpPostalCode" name="postalCode" inputmode="text" autocomplete="postal-code" minlength="4" maxlength="10" required aria-describedby="veylunePdpDeliveryStatus"><button type="submit" aria-controls="veylunePdpDeliveryStatus">{{ 'veylune.marketplace.pdp.check'|trans|sw_sanitize }}</button></div>
        <p id="veylunePdpDeliveryStatus" data-pdp-delivery-status aria-live="polite">{{ 'veylune.marketplace.pdp.deliveryDisclosure'|trans|sw_sanitize }}</p>
    </form>

    {% if veyluneNativeProductId %}
    <form id="veylunePdpBuyForm"
          class="veylune-pdp-purchase"
          action="{{ path('frontend.checkout.line-item.add') }}"
          method="post"
          data-add-to-cart="true"
          aria-label="{{ 'veylune.marketplace.pdp.nativeCartAria'|trans|striptags }}">
        <input type="hidden" name="redirectTo" value="frontend.checkout.cart.page">
        <input type="hidden" name="lineItems[{{ veyluneNativeProductId }}][id]" value="{{ veyluneNativeProductId }}">
        <input type="hidden" name="lineItems[{{ veyluneNativeProductId }}][type]" value="product">
        <input type="hidden" name="lineItems[{{ veyluneNativeProductId }}][referencedId]" value="{{ veyluneNativeProductId }}">
        <input type="hidden" name="lineItems[{{ veyluneNativeProductId }}][stackable]" value="1">
        <input type="hidden" name="lineItems[{{ veyluneNativeProductId }}][removable]" value="1">
        <div>
            <strong>{{ 'veylune.marketplace.pdp.quantity'|trans|default('Quantity') }}</strong>
            <div class="veylune-pdp-quantity">
                <input type="number"
                       name="lineItems[{{ veyluneNativeProductId }}][quantity]"
                       min="1"
                       step="1"
                       value="1"
                       aria-label="{{ 'veylune.marketplace.pdp.quantity'|trans|default('Quantity') }}">
            </div>
        </div>
        <button class="veylune-pdp-purchase__add" type="submit">{{ veylunePdpPresentation.commerce.primaryLabel }}</button>
        <p data-pdp-add-status aria-live="polite">{{ veylunePdpPresentation.commerce.disclosure }}</p>
    </form>
    {% else %}
    <div class="veylune-pdp-purchase" aria-label="Project quantity">
        <div>
            <strong>Quantity</strong>
            <div class="veylune-pdp-quantity" data-pdp-quantity>
                <button type="button" data-pdp-quantity-decrease aria-label="Decrease quantity">−</button>
                <input type="text" inputmode="numeric" value="1" data-pdp-quantity-input aria-label="Desired quantity" aria-live="polite">
                <button type="button" data-pdp-quantity-increase aria-label="Increase quantity">+</button>
            </div>
        </div>
        <button class="veylune-pdp-purchase__add" type="button" data-pdp-add-selection>{{ veylunePdpPresentation.commerce.primaryLabel }}</button>
        <p data-pdp-add-status aria-live="polite">{{ veylunePdpPresentation.commerce.disclosure }}</p>
    </div>
    {% endif %}

    <fieldset class="veylune-pdp-services" data-pdp-services>
        <legend>{{ 'veylune.marketplace.pdp.services'|trans|sw_sanitize }}</legend>
        <label><input type="radio" name="veylunePdpService" value="studio" checked><span><strong>{{ 'veylune.marketplace.pdp.studioConsultation'|trans|sw_sanitize }}</strong><small>{{ 'veylune.marketplace.pdp.studioIncluded'|trans|sw_sanitize }}</small></span></label>
        <label><input type="radio" name="veylunePdpService" value="delivery"><span><strong>{{ 'veylune.marketplace.pdp.deliveryPlanning'|trans|sw_sanitize }}</strong><small>{{ 'veylune.marketplace.pdp.deliveryPlanningText'|trans|sw_sanitize }}</small></span></label>
        <label><input type="radio" name="veylunePdpService" value="care"><span><strong>{{ 'veylune.marketplace.pdp.careReview'|trans|sw_sanitize }}</strong><small>{{ 'veylune.marketplace.pdp.careReviewText'|trans|sw_sanitize }}</small></span></label>
        <p data-pdp-service-status aria-live="polite">{{ 'veylune.marketplace.pdp.studioSelected'|trans|sw_sanitize }}</p>
    </fieldset>
</section>
