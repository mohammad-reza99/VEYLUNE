{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% set axisLabel = veylunePreviewType == 'category'
    ? 'Departments'
    : (veylunePreviewType == 'room' ? 'Rooms' : 'Collections') %}

{% block base_content %}
    <div class="veylune-preview veylune-preview--destination veylune-preview-marketplace-destination"
         data-veylune-plp
         data-preview-destination
         data-preview-destination-type="{{ veylunePreviewType }}"
         data-preview-destination-key="{{ veylunePreviewKey }}">
        <nav class="veylune-preview-marketplace-destination__breadcrumb" aria-label="Breadcrumb">
            <a href="{{ path('frontend.veylune.preview.catalog.home', { token: veylunePreviewToken }) }}">Private catalog</a>
            <span aria-hidden="true">/</span>
            <span>{{ axisLabel }}</span>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{{ veylunePreviewTitle }}</span>
        </nav>

        <header class="veylune-preview-marketplace-destination__hero">
            <div class="veylune-preview-marketplace-destination__hero-copy">
                <p class="veylune-preview-marketplace-destination__eyebrow">{{ veylunePreviewDestination.eyebrow }}</p>
                <h1>{{ veylunePreviewTitle }}</h1>
                <p class="veylune-preview-marketplace-destination__summary">{{ veylunePreviewDestination.summary }}</p>
                <div class="veylune-preview-marketplace-destination__hero-actions">
                    <a class="is-primary" href="#veyluneProductGrid">Browse {{ veylunePreviewProducts|length }} products</a>
                    <a href="{{ path('frontend.veylune.preview.catalog.home', { token: veylunePreviewToken }) }}">Return to catalog</a>
                </div>
            </div>
            <figure class="veylune-preview-marketplace-destination__hero-media">
                <img src="{{ asset('assets/' ~ veylunePreviewDestination.heroAsset, 'theme') }}"
                     alt="{{ veylunePreviewDestination.heroAlt }}"
                     width="1536"
                     height="1024"
                     loading="eager"
                     fetchpriority="high"
                     decoding="async">
                <figcaption>{{ veylunePreviewTitle }} / Private catalog edit</figcaption>
            </figure>
        </header>

        <section class="veylune-preview-marketplace-destination__signals" aria-label="Catalog service signals">
            <div><small>Assortment</small><strong>{{ veylunePreviewProducts|length }} products</strong></div>
            <div><small>Product families</small><strong>{{ veylunePreviewTypeChips|length }} represented</strong></div>
            <div><small>Review path</small><strong>Material and delivery check</strong></div>
        </section>

        <nav class="veylune-preview-marketplace-destination__peer-nav" aria-label="Browse {{ axisLabel }}">
            <div>
                <p class="veylune-preview-marketplace-destination__eyebrow">Explore {{ axisLabel|lower }}</p>
                <strong>Move across the private catalog</strong>
            </div>
            <div class="veylune-preview-marketplace-destination__peer-links">
                {% for key, label in veylunePreviewPeers %}
                    <a class="{{ key == veylunePreviewKey ? 'is-current' : '' }}"
                       href="{{ veylunePreviewType == 'category'
                           ? path('frontend.veylune.preview.catalog.category', { categoryKey: key, token: veylunePreviewToken })
                           : (veylunePreviewType == 'room'
                               ? path('frontend.veylune.preview.catalog.room', { roomKey: key, token: veylunePreviewToken })
                               : path('frontend.veylune.preview.catalog.collection', { collectionKey: key, token: veylunePreviewToken })) }}"
                       {% if key == veylunePreviewKey %}aria-current="page"{% endif %}>{{ label }}</a>
                {% endfor %}
            </div>
        </nav>

        <section class="veylune-preview-marketplace-destination__catalog" aria-labelledby="veyluneDestinationProductsTitle">
            <header class="veylune-preview-marketplace-destination__catalog-head">
                <div>
                    <p class="veylune-preview-marketplace-destination__eyebrow">Shop the edit</p>
                    <h2 id="veyluneDestinationProductsTitle">{{ veylunePreviewTitle }} products</h2>
                </div>
                <p>Filter by product family, material, price or availability.</p>
            </header>

            <nav class="veylune-plp-shortcuts veylune-preview-marketplace-destination__type-strip" aria-label="Product families in {{ veylunePreviewTitle }}">
                <button class="veylune-plp-chip is-active" type="button" data-plp-type="all" aria-pressed="true">All products</button>
                {% for key, label in veylunePreviewTypeChips %}
                    <button class="veylune-plp-chip" type="button" data-plp-type="{{ key|replace({'_': '-'}) }}" aria-pressed="false">{{ label }}</button>
                {% endfor %}
            </nav>

            <div class="veylune-plp-marketplace-layout">
                <aside class="veylune-plp-filter-rail" aria-label="Filter products">
                    <div class="veylune-plp-filter-rail__heading">
                        <strong>Filter products</strong>
                        <span>Only relevant options are shown</span>
                    </div>
                    {% sw_include '@Storefront/storefront/veylune/catalog-preview-filters.html.twig' %}
                    <button class="veylune-plp-filter-clear" type="button" data-plp-filter-clear disabled>Clear all</button>
                </aside>

                <div class="veylune-plp-results">
                    <div class="veylune-plp-toolbar">
                        <p class="veylune-plp-toolbar__count" aria-live="polite"><strong data-plp-count>{{ veylunePreviewProducts|length }}</strong> products</p>
                        <div class="veylune-plp-toolbar__actions" aria-label="Listing controls">
                            <div class="veylune-plp-menu">
                                <button class="veylune-plp-control" type="button" data-plp-filter-toggle aria-expanded="false" aria-haspopup="true" aria-controls="veylunePlpFilters">Filter</button>
                                <div class="veylune-plp-popover" id="veylunePlpFilters" data-plp-filter-panel role="region" aria-label="Product filters" hidden>
                                    {% sw_include '@Storefront/storefront/veylune/catalog-preview-filters.html.twig' %}
                                    <button class="veylune-plp-filter-clear" type="button" data-plp-filter-clear disabled>Clear filters</button>
                                </div>
                            </div>
                            <div class="veylune-plp-menu">
                                <button class="veylune-plp-control" type="button" data-plp-sort-toggle aria-expanded="false" aria-haspopup="menu" aria-controls="veylunePlpSort">Sort: Featured</button>
                                <div class="veylune-plp-popover veylune-plp-popover--sort" id="veylunePlpSort" data-plp-sort-panel role="menu" hidden>
                                    <button type="button" role="menuitemradio" aria-checked="true" data-plp-sort="featured">Featured</button>
                                    <button type="button" role="menuitemradio" aria-checked="false" data-plp-sort="price-low">Price: Low to high</button>
                                    <button type="button" role="menuitemradio" aria-checked="false" data-plp-sort="price-high">Price: High to low</button>
                                    <button type="button" role="menuitemradio" aria-checked="false" data-plp-sort="name">Name</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="veylune-plp-active-filters" data-plp-active-filters aria-label="Active filters" hidden></div>
                    <p class="visually-hidden" data-plp-status role="status" aria-live="polite" aria-atomic="true"></p>

                    <div class="veylune-preview-grid" id="veyluneProductGrid" data-plp-grid aria-live="polite" aria-atomic="false" aria-busy="false" aria-label="{{ veylunePreviewTitle }} private catalog products">
                        {% for product in veylunePreviewProducts %}
                            {% sw_include '@Storefront/storefront/veylune/catalog-preview-card.html.twig' with { product: product, productIndex: loop.index0 } %}
                        {% else %}
                            <p class="veylune-preview__empty">No products are assigned to this destination yet.</p>
                        {% endfor %}
                        <p class="veylune-plp-empty" data-plp-empty role="status" hidden>No products match these filters.</p>
                    </div>

                    <div class="veylune-plp-progress">
                        <p>Showing <strong data-plp-showing>{{ veylunePreviewProducts|length > 12 ? 12 : veylunePreviewProducts|length }}</strong> of <strong data-plp-matched-count>{{ veylunePreviewProducts|length }}</strong> matching products</p>
                        <div class="veylune-plp-progress__bar" aria-hidden="true"><span></span></div>
                        <button class="veylune-plp-load-more" type="button" data-plp-load-more aria-controls="veyluneProductGrid">Load more</button>
                    </div>
                </div>
            </div>
        </section>

        <section class="veylune-preview-marketplace-destination__guide" aria-labelledby="veyluneDestinationGuideTitle">
            <div>
                <p class="veylune-preview-marketplace-destination__eyebrow">Planning guide</p>
                <h2 id="veyluneDestinationGuideTitle">{{ veylunePreviewDestination.guideTitle }}</h2>
            </div>
            <div class="veylune-preview-marketplace-destination__guide-copy">
                <p>{{ veylunePreviewDestination.guideLead }}</p>
                <p>Review dimensions, finish, care and access requirements before confirming a selection. The studio can compare shortlisted products inside the context of a complete room.</p>
            </div>
        </section>

        <section class="veylune-preview-marketplace-destination__service" aria-labelledby="veyluneDestinationServiceTitle">
            <div>
                <p class="veylune-preview-marketplace-destination__eyebrow">Veylune client care</p>
                <h2 id="veyluneDestinationServiceTitle">Need help connecting the pieces?</h2>
            </div>
            <div>
                <p>Bring a room plan, shortlist or sourcing brief to the studio for material direction and project planning.</p>
                <a href="{{ path('frontend.veylune.consultation.page') }}">Begin a private dialogue <span aria-hidden="true">&rarr;</span></a>
            </div>
        </section>
    </div>
{% endblock %}
