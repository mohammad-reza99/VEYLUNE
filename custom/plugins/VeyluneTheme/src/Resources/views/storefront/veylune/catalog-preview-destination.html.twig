{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% set axisLabel = veylunePreviewType == 'category'
    ? 'Departments'
    : (veylunePreviewType == 'room' ? 'Rooms' : 'Collections') %}
{% set veyluneCatalogIsPublic = veyluneCatalogRouteMode|default('preview') == 'public' %}
{% set veyluneCatalogRouteParams = veyluneCatalogIsPublic ? {} : { token: veylunePreviewToken } %}
{% set veyluneCatalogHomeRoute = veyluneCatalogIsPublic ? 'frontend.veylune.catalog.home' : 'frontend.veylune.preview.catalog.home' %}
{% set veyluneCatalogCategoryRoute = veyluneCatalogIsPublic ? 'frontend.veylune.catalog.category' : 'frontend.veylune.preview.catalog.category' %}
{% set veyluneCatalogRoomRoute = veyluneCatalogIsPublic ? 'frontend.veylune.catalog.room' : 'frontend.veylune.preview.catalog.room' %}
{% set veyluneCatalogCollectionRoute = veyluneCatalogIsPublic ? 'frontend.veylune.catalog.collection' : 'frontend.veylune.preview.catalog.collection' %}
{% set veyluneDestinationListingId = veyluneCatalogIsPublic ? 'veyluneCatalogListing' : 'veylunePrivateListing' %}

{% block base_content %}
    <div class="veylune-preview veylune-preview--destination veylune-preview-marketplace-destination"
         data-preview-destination
         data-preview-destination-type="{{ veylunePreviewType }}"
         data-preview-destination-key="{{ veylunePreviewKey }}">
        <nav class="veylune-preview-marketplace-destination__breadcrumb" aria-label="Breadcrumb">
            <a href="{{ path(veyluneCatalogHomeRoute, veyluneCatalogRouteParams) }}">Catalog</a>
            <span aria-hidden="true">/</span>
            <span>{{ axisLabel }}</span>
            <span aria-hidden="true">/</span>
            <span aria-current="page">{{ veylunePreviewTitle }}</span>
        </nav>

        <header class="veylune-preview-marketplace-destination__hero">
            <div class="veylune-preview-marketplace-destination__hero-copy">
                <p class="veylune-preview-marketplace-destination__eyebrow">{{ veylunePreviewDestination.eyebrow }}</p>
                <h1>{{ veylunePreviewTitle }}</h1>
                <p class="veylune-preview-marketplace-destination__summary">{{ veylunePreviewDestination.summary }}</p>
                <div class="veylune-preview-marketplace-destination__hero-actions">
                    <a class="is-primary" href="#{{ veyluneDestinationListingId }}">Browse {{ veylunePreviewProducts|length }} products</a>
                    <a href="{{ path(veyluneCatalogHomeRoute, veyluneCatalogRouteParams) }}">Return to catalog</a>
                </div>
            </div>
            <figure class="veylune-preview-marketplace-destination__hero-media">
                <img src="{{ veylunePreviewDestination.heroUrl }}"
                     alt="{{ veylunePreviewDestination.heroAlt }}"
                     width="{{ veylunePreviewDestination.heroWidth }}"
                     height="{{ veylunePreviewDestination.heroHeight }}"
                     loading="eager"
                     fetchpriority="high"
                     decoding="async">
                <figcaption>{{ veylunePreviewTitle }} / {{ veyluneCatalogIsPublic ? 'Catalog edit' : 'Private catalog edit' }}</figcaption>
            </figure>
        </header>

        <section class="veylune-preview-marketplace-destination__signals" aria-label="Catalog service signals">
            <div><small>Assortment</small><strong>{{ veylunePreviewProducts|length }} products</strong></div>
            <div><small>Product families</small><strong>{{ veylunePreviewTypeChips|length }} represented</strong></div>
            <div><small>Review path</small><strong>Material and delivery check</strong></div>
        </section>

        <nav class="veylune-preview-marketplace-destination__peer-nav" aria-label="Browse {{ axisLabel }}">
            <div>
                <p class="veylune-preview-marketplace-destination__eyebrow">Explore {{ axisLabel|lower }}</p>
                <strong>{{ veyluneCatalogIsPublic ? 'Move across the catalog' : 'Move across the private catalog' }}</strong>
            </div>
            <div class="veylune-preview-marketplace-destination__peer-links">
                {% for key, label in veylunePreviewPeers %}
                    <a class="{{ key == veylunePreviewKey ? 'is-current' : '' }}"
                       href="{{ veylunePreviewType == 'category'
                           ? path(veyluneCatalogCategoryRoute, veyluneCatalogRouteParams|merge({ categoryKey: key }))
                           : (veylunePreviewType == 'room'
                               ? path(veyluneCatalogRoomRoute, veyluneCatalogRouteParams|merge({ roomKey: key }))
                               : path(veyluneCatalogCollectionRoute, veyluneCatalogRouteParams|merge({ collectionKey: key }))) }}"
                       {% if key == veylunePreviewKey %}aria-current="page"{% endif %}>{{ label }}</a>
                {% endfor %}
            </div>
        </nav>

        {% sw_include '@Storefront/storefront/veylune/discovery-listing.html.twig' with {
            discoveryListingId: veyluneDestinationListingId,
            discoveryListingScope: veyluneCatalogIsPublic ? 'public' : 'private',
            discoveryListingTitle: veylunePreviewTitle ~ ' products',
            discoveryListingLabel: veylunePreviewTitle ~ (veyluneCatalogIsPublic ? ' catalog products' : ' private catalog products'),
            discoveryProducts: veylunePreviewProducts, discoveryTypeChips: veylunePreviewTypeChips,
            discoveryFilterOptions: veylunePreviewFilterOptions,
            discoveryCardTemplate: '@Storefront/storefront/veylune/catalog-preview-card.html.twig',
            discoveryEmptyTitle: 'No products match these filters.',
            discoveryEmptyText: veyluneCatalogIsPublic ? 'Clear the active filters or return to the catalog.' : 'Clear the active filters or return to the private catalog.'
        } %}

        <section class="veylune-preview-marketplace-destination__guide" aria-labelledby="veyluneDestinationGuideTitle">
            <div>
                <p class="veylune-preview-marketplace-destination__eyebrow">Planning guide</p>
                <h2 id="veyluneDestinationGuideTitle">{{ veylunePreviewDestination.guideTitle }}</h2>
            </div>
            <div class="veylune-preview-marketplace-destination__guide-copy">
                <p>{{ veylunePreviewDestination.guideLead }}</p>
                <p>Review dimensions, finish, care and access requirements before confirming a selection. The studio can compare shortlisted products inside the context of a complete room.</p>
            </div>
        </section>

        <section class="veylune-preview-marketplace-destination__service" aria-labelledby="veyluneDestinationServiceTitle">
            <div>
                <p class="veylune-preview-marketplace-destination__eyebrow">Veylune client care</p>
                <h2 id="veyluneDestinationServiceTitle">Need help connecting the pieces?</h2>
            </div>
            <div>
                <p>Bring a room plan, shortlist or sourcing brief to the studio for material direction and project planning.</p>
                <a href="{{ path('frontend.veylune.consultation.page') }}">Begin a private dialogue <span aria-hidden="true">&rarr;</span></a>
            </div>
        </section>
    </div>
{% endblock %}
