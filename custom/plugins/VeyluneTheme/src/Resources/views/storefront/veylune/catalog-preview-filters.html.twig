{% set filterOptions = veylunePreviewFilterOptions|default({ materials: {}, prices: {}, statuses: {} }) %}

{% if filterOptions.materials is not empty %}
    <fieldset>
        <legend>Material</legend>
        {% for value, label in filterOptions.materials %}
            <label><input type="checkbox" value="{{ value }}" data-plp-material> <span>{{ label }}</span></label>
        {% endfor %}
    </fieldset>
{% endif %}

{% if filterOptions.prices is not empty %}
    <fieldset>
        <legend>Price</legend>
        {% for value, label in filterOptions.prices %}
            <label><input type="checkbox" value="{{ value }}" data-plp-price-range> <span>{{ label }}</span></label>
        {% endfor %}
    </fieldset>
{% endif %}

{% if filterOptions.statuses is not empty %}
    <fieldset>
        <legend>Availability</legend>
        {% for value, label in filterOptions.statuses %}
            <label><input type="checkbox" value="{{ value }}" data-plp-status-filter> <span>{{ label }}</span></label>
        {% endfor %}
    </fieldset>
{% endif %}
