{% set listingId = discoveryListingId|default('veyluneDiscoveryListing') %}
{% set listingProducts = discoveryProducts|default([]) %}
{% set listingTypes = discoveryTypeChips|default({}) %}
{% set listingFilters = discoveryFilterOptions|default({ materials: {}, prices: {}, statuses: {} }) %}
{% set listingLabel = discoveryListingLabel|default('Veylune products') %}

<section class="veylune-discovery-listing veylune-preview-marketplace-destination__catalog"
         id="{{ listingId }}"
         data-veylune-plp
         data-discovery-listing
         data-discovery-listing-scope="{{ discoveryListingScope|default('public') }}"
         aria-labelledby="{{ listingId }}Title">
    <header class="veylune-preview-marketplace-destination__catalog-head vli-discovery__section-head">
        <div><p class="veylune-preview-marketplace-destination__eyebrow">{{ discoveryListingEyebrow|default('Shop the edit') }}</p><h2 id="{{ listingId }}Title">{{ discoveryListingTitle }}</h2></div>
        <p>{{ discoveryListingDescription|default('Filter by product family, material, price or availability.') }}</p>
    </header>

    {% if listingTypes is not empty %}
        <nav class="veylune-plp-shortcuts veylune-preview-marketplace-destination__type-strip" aria-label="Product families">
            <button class="veylune-plp-chip is-active" type="button" data-plp-type="all" aria-pressed="true">All products</button>
            {% for key, label in listingTypes %}<button class="veylune-plp-chip" type="button" data-plp-type="{{ key|replace({'_': '-'}) }}" aria-pressed="false">{{ label }}</button>{% endfor %}
        </nav>
    {% endif %}

    <div class="veylune-plp-marketplace-layout">
        <aside class="veylune-plp-filter-rail" aria-label="Filter products">
            <div class="veylune-plp-filter-rail__heading"><strong>Filter products</strong><span>Only relevant options are shown</span></div>
            {% sw_include '@Storefront/storefront/veylune/catalog-preview-filters.html.twig' with { discoveryFilterOptions: listingFilters } %}
            <button class="veylune-plp-filter-clear" type="button" data-plp-filter-clear disabled>Clear all</button>
        </aside>

        <div class="veylune-plp-results">
            <div class="veylune-plp-toolbar">
                <p class="veylune-plp-toolbar__count" aria-live="polite"><strong data-plp-count>{{ listingProducts|length }}</strong> products</p>
                <div class="veylune-plp-toolbar__actions" aria-label="Listing controls">
                    <div class="veylune-plp-menu">
                        <button class="veylune-plp-control" type="button" data-plp-filter-toggle aria-expanded="false" aria-haspopup="dialog" aria-controls="{{ listingId }}Filters">Filter</button>
                        <div class="veylune-plp-popover" id="{{ listingId }}Filters" data-plp-filter-panel role="dialog" aria-modal="false" aria-label="Product filters" hidden>
                            {% sw_include '@Storefront/storefront/veylune/catalog-preview-filters.html.twig' with { discoveryFilterOptions: listingFilters } %}
                            <button class="veylune-plp-filter-clear" type="button" data-plp-filter-clear disabled>Clear filters</button>
                        </div>
                    </div>
                    <div class="veylune-plp-menu">
                        <button class="veylune-plp-control" type="button" data-plp-sort-toggle aria-expanded="false" aria-haspopup="menu" aria-controls="{{ listingId }}Sort">Sort: Featured</button>
                        <div class="veylune-plp-popover veylune-plp-popover--sort" id="{{ listingId }}Sort" data-plp-sort-panel role="menu" hidden>
                            <button type="button" role="menuitemradio" aria-checked="true" data-plp-sort="featured">Featured</button>
                            <button type="button" role="menuitemradio" aria-checked="false" data-plp-sort="price-low">Price: Low to high</button>
                            <button type="button" role="menuitemradio" aria-checked="false" data-plp-sort="price-high">Price: High to low</button>
                            <button type="button" role="menuitemradio" aria-checked="false" data-plp-sort="name">Name</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="veylune-plp-active-filters" data-plp-active-filters aria-label="Active filters" hidden></div>
            <p class="visually-hidden" data-plp-status role="status" aria-live="polite" aria-atomic="true"></p>
            <div class="veylune-preview-grid vli-index__grid" id="{{ listingId }}Grid" data-plp-grid aria-live="polite" aria-atomic="false" aria-busy="false" aria-label="{{ listingLabel }}">
                {% for product in listingProducts %}
                    {% sw_include discoveryCardTemplate with { product: product, productIndex: loop.index0 } %}
                {% endfor %}
                <div class="veylune-plp-empty vli-index__empty" data-plp-empty role="status"{% if listingProducts is not empty %} hidden{% endif %}>
                    <span class="vli-index__empty-mark" aria-hidden="true">00</span>
                    <div><h3>{{ discoveryEmptyTitle|default('No products match these filters.') }}</h3><p>{{ discoveryEmptyText|default('Clear the active filters or explore another discovery path.') }}</p>
                        {% if discoveryEmptyPrimaryUrl|default('') %}<div class="vli-index__empty-actions"><a class="vli-button vli-button--primary" href="{{ discoveryEmptyPrimaryUrl }}">{{ discoveryEmptyPrimaryLabel|default('Explore Discover') }}</a>{% if discoveryEmptySecondaryUrl|default('') %}<a class="vli-button" href="{{ discoveryEmptySecondaryUrl }}">{{ discoveryEmptySecondaryLabel|default('Contact the studio') }}</a>{% endif %}</div>{% endif %}
                    </div>
                </div>
            </div>
            <div class="veylune-plp-progress">
                <p>Showing <strong data-plp-showing>{{ listingProducts|length > 12 ? 12 : listingProducts|length }}</strong> of <strong data-plp-matched-count>{{ listingProducts|length }}</strong> matching products</p>
                <div class="veylune-plp-progress__bar" aria-hidden="true"><span></span></div>
                <button class="veylune-plp-load-more" type="button" data-plp-load-more aria-controls="{{ listingId }}Grid">Load more</button>
            </div>
        </div>
    </div>
</section>
