<section class="veylune-pdp-information" aria-label="{{ 'veylune.marketplace.pdp.productInfo'|trans|striptags }}">
    <section class="veylune-pdp-glance" aria-labelledby="veylunePdpGlanceTitle">
        <h2 id="veylunePdpGlanceTitle">{{ 'veylune.marketplace.pdp.atGlance'|trans|sw_sanitize }}</h2>
        <div class="veylune-pdp-glance__grid">
            <div><span aria-hidden="true">01</span><strong>{{ product.materialLabel }}</strong><small>{{ 'veylune.marketplace.pdp.primaryMaterial'|trans|sw_sanitize }}</small></div>
            <div><span aria-hidden="true">02</span><strong>{{ veylunePdpPresentation.familyLabel }}</strong><small>{{ 'veylune.marketplace.pdp.productFamily'|trans|sw_sanitize }}</small></div>
            <div><span aria-hidden="true">03</span><strong>{{ 'veylune.marketplace.pdp.approvedViews'|trans({'%count%': veylunePdpPresentation.gallery.count})|sw_sanitize }}</strong><small>{{ 'veylune.marketplace.pdp.galleryEvidence'|trans|sw_sanitize }}</small></div>
            <div><span aria-hidden="true">04</span><strong>{{ (veyluneCatalogIsPublic|default(false) ? 'veylune.marketplace.pdp.studioSpecification' : 'veylune.marketplace.pdp.privateSpecification')|trans|sw_sanitize }}</strong><small>{{ 'veylune.marketplace.pdp.nonBindingPath'|trans|sw_sanitize }}</small></div>
        </div>
    </section>

    <section class="veylune-pdp-description" aria-labelledby="veylunePdpDescriptionTitle">
        <div class="veylune-pdp-information__heading">
            <p>{{ 'veylune.marketplace.pdp.description'|trans|sw_sanitize }}</p>
            <h2 id="veylunePdpDescriptionTitle">{{ 'veylune.marketplace.pdp.about'|trans|sw_sanitize }}</h2>
        </div>
        <div class="veylune-pdp-description__body">
            {% if product.description %}
                <div>{{ product.description|raw }}</div>
            {% else %}
                <p>{{ 'veylune.marketplace.pdp.fallbackDescription'|trans({'%name%': product.name, '%type%': product.productType|replace({'_': ' '})})|sw_sanitize }}</p>
            {% endif %}
            <p>{{ veylunePdpPresentation.focus }}</p>
        </div>
    </section>

    {% sw_include '@Storefront/storefront/veylune/pdp-semantic-information.html.twig' with {
        veylunePdpPresentation: veylunePdpPresentation,
        veylunePdpSectionId: 'veylunePrivatePdpSemantic'
    } %}

    <section class="veylune-pdp-reviews" aria-labelledby="veylunePdpReviewsTitle">
        <div class="veylune-pdp-information__heading"><p>{{ 'veylune.marketplace.pdp.reviews'|trans|sw_sanitize }}</p><h2 id="veylunePdpReviewsTitle">{{ 'veylune.marketplace.pdp.newToEdit'|trans|sw_sanitize }}</h2></div>
        <div class="veylune-pdp-reviews__summary">
            <div><strong>0.0</strong><span aria-hidden="true">☆☆☆☆☆</span><small>{{ 'veylune.marketplace.pdp.noReviews'|trans|sw_sanitize }}</small></div>
            <div class="veylune-pdp-reviews__bars" aria-label="{{ 'veylune.marketplace.pdp.noRatings'|trans|striptags }}">
                {% for rating in 5..1 %}<div><span>{{ rating }}</span><i><b style="width: 0"></b></i><small>0</small></div>{% endfor %}
            </div>
            <p>{{ 'veylune.marketplace.pdp.reviewsDisclosure'|trans|sw_sanitize }}</p>
        </div>
    </section>
</section>
