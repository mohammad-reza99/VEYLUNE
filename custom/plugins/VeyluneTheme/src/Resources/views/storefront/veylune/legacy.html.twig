{% set legacyPages = {
    legacy: {
        label: 'Digital Legacy',
        title: 'A house language designed to remain recognizable for decades.',
        text: 'VEYLUNE is shaped as a lasting cultural presence: a disciplined visual identity, a collectible design archive, and an emotional world that carries memory beyond individual objects.',
        accent: 'Eternal Form'
    },
    culture: {
        label: 'Cultural Position',
        title: 'A design culture platform for architecture, interiors, and collectible living.',
        text: 'The VEYLUNE world connects furniture to architectural rhythm, material philosophy, collector dialogue, and the future of artistic domestic life.',
        accent: 'Culture House'
    },
    archive: {
        label: 'Design Archive',
        title: 'Lineage, provenance, and the long memory of evolving collections.',
        text: 'The archive frames collections as chapters in a continuing language: origin notes, material studies, atelier records, and objects that gather emotional value over time.',
        accent: 'Archive Index'
    },
    exhibitions: {
        label: 'Future Showrooms',
        title: 'Digital exhibitions and private environments for the next era of luxury.',
        text: 'VEYLUNE prepares for virtual showrooms, collector rooms, AI-assisted curation, and immersive exhibitions without losing the restraint of the house.',
        accent: 'Future Rooms'
    }
} %}

{% set current = legacyPages[veyluneLegacyType]|default(legacyPages.legacy) %}

<div class="veylune-legacy veylune-legacy--{{ veyluneLegacyType }}" data-veylune-legacy>
    <section class="veylune-legacy-hero" data-veylune-reveal data-veylune-atmosphere-zone="limestone">
        <div class="veylune-legacy-hero__ambient" aria-hidden="true"></div>
        <div class="veylune-legacy-hero__inner">
            <div class="veylune-legacy-hero__content">
                <p class="veylune-legacy__eyebrow">{{ current.label }}</p>
                <h1>{{ current.title }}</h1>
                <p>{{ current.text }}</p>
            </div>
            <aside class="veylune-legacy-seal" aria-label="VEYLUNE identity seal">
                <span>{{ current.accent }}</span>
                <strong>VEYLUNE</strong>
                <em>Presence · Memory · Form</em>
            </aside>
        </div>
    </section>

    <section class="veylune-legacy-section veylune-identity-system" data-veylune-reveal data-veylune-atmosphere-zone="bronze">
        <div class="veylune-legacy-section__head">
            <p class="veylune-legacy__eyebrow">Global Identity System</p>
            <h2>A recognizable house grammar for typography, silence, pacing, and spatial composition.</h2>
        </div>
        <div class="veylune-legacy-index">
            {% set identity = [
                { title: 'Typographic Signature', text: 'Serif scale, measured labels, and quiet editorial hierarchy across every future surface.' },
                { title: 'Spatial Rhythm', text: 'Large fields of pause, architectural grids, and deliberate negative space that make the brand identifiable.' },
                { title: 'Transition Cadence', text: 'Slow arrival, soft disclosure, and restrained overlays that feel unmistakably VEYLUNE.' },
                { title: 'Visual Restraint', text: 'Material warmth, controlled contrast, and atmospheric depth without decorative excess.' }
            ] %}
            {% for item in identity %}
                <article class="veylune-legacy-index__item">
                    <span>Identity 0{{ loop.index }}</span>
                    <h3>{{ item.title }}</h3>
                    <p>{{ item.text }}</p>
                </article>
            {% endfor %}
        </div>
    </section>

    <section class="veylune-legacy-section veylune-cultural-platform" data-veylune-reveal data-veylune-atmosphere-zone="charcoal">
        <div class="veylune-cultural-platform__intro">
            <p class="veylune-legacy__eyebrow">Cultural Architecture</p>
            <h2>Commerce becomes secondary to a lasting design culture.</h2>
        </div>
        <div class="veylune-cultural-platform__grid">
            {% set stories = [
                { title: 'Architecture Narratives', text: 'Essays on proportion, room rhythm, interior silence, and sculptural domesticity.' },
                { title: 'Collector Dialogues', text: 'Private interviews around rarity, permanence, and emotional relationships with objects.' },
                { title: 'Material Documentaries', text: 'Stone, bronze, wood, textile, and surface explored as memory-bearing matter.' },
                { title: 'Atelier Records', text: 'Notes from makers, prototypes, finishes, and the discipline behind lasting forms.' },
                { title: 'Future Living Concepts', text: 'Slow luxury, intelligent curation, and immersive environments for the next home.' },
                { title: 'Editorial Editions', text: 'Seasonless publications that build authority through taste and restraint.' }
            ] %}
            {% for story in stories %}
                <article class="veylune-cultural-story">
                    <span>Culture 0{{ loop.index }}</span>
                    <h3>{{ story.title }}</h3>
                    <p>{{ story.text }}</p>
                </article>
            {% endfor %}
        </div>
    </section>

    <section class="veylune-legacy-section veylune-lineage" data-veylune-reveal data-veylune-atmosphere-zone="limestone">
        <div class="veylune-legacy-section__head">
            <p class="veylune-legacy__eyebrow">Legacy Storytelling</p>
            <h2>The brand records origin, evolution, and future intent as part of the experience.</h2>
        </div>
        <div class="veylune-lineage__timeline">
            {% set lineage = [
                { era: 'Origin', title: 'The edited room', text: 'The house begins with a belief that interiors should be composed with gallery restraint.' },
                { era: 'Language', title: 'The recurring silhouette', text: 'Collections build shared proportions, tones, materials, and emotional pacing.' },
                { era: 'Archive', title: 'The object gains memory', text: 'Selected pieces are preserved as chapters with provenance, material notes, and context.' },
                { era: 'Future', title: 'The digital legacy expands', text: 'Exhibitions, private rooms, intelligent curation, and collector environments extend the world.' }
            ] %}
            {% for item in lineage %}
                <article>
                    <span>{{ item.era }}</span>
                    <h3>{{ item.title }}</h3>
                    <p>{{ item.text }}</p>
                </article>
            {% endfor %}
        </div>
    </section>

    <section class="veylune-legacy-section veylune-future-framework" data-veylune-reveal data-veylune-atmosphere-zone="bronze">
        <div class="veylune-future-framework__panel">
            <p class="veylune-legacy__eyebrow">Future-Proof Architecture</p>
            <h2>A scalable framework for flagship collections, exhibitions, archives, collector spaces, and assisted curation.</h2>
        </div>
        <div class="veylune-future-framework__systems">
            <span>Flagship collections</span>
            <span>Digital exhibitions</span>
            <span>Virtual showrooms</span>
            <span>Collector environments</span>
            <span>Design archive experiences</span>
            <span>Luxury digital publications</span>
            <span>Atelier timelines</span>
            <span>AI-assisted curation</span>
        </div>
    </section>

    <section class="veylune-legacy-section veylune-mythology" data-veylune-reveal>
        <p class="veylune-legacy__eyebrow">Brand Mythology</p>
        <blockquote>
            VEYLUNE exists where restraint becomes memory, where objects become atmosphere, and where a room begins to feel inevitable.
        </blockquote>
        <div class="veylune-mythology__signals" aria-label="VEYLUNE mythology signals">
            <span>Taste</span>
            <span>Rarity</span>
            <span>Intelligence</span>
            <span>Permanence</span>
            <span>Silence</span>
            <span>Elegance</span>
        </div>
    </section>
</div>
