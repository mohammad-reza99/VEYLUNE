{% sw_extends '@Storefront/storefront/element/cms-element-form.html.twig' %}

{% block element_form %}
    {% set config = element.fieldConfig.elements %}
    {% set formType = element.config.type.value %}

    <div class="cms-element-{{ element.type }} veylune-inquiry veylune-inquiry--{{ formType }}">
        <div class="row justify-content-center">
            <div class="col-lg-12">

                {% set formViolations = app.request.get('errors') %}

                <div class="veylune-inquiry__card">
                    <div class="veylune-inquiry__body">
                        {% block element_form_wrapper %}
                            {% if formType is same as('contact') %}
                                {% block element_form_contact_form_title %}
                                    <div class="veylune-inquiry__header">
                                        <p class="veylune-inquiry__eyebrow">{{ 'veylune.inquiry.contactEyebrow'|trans|sw_sanitize }}</p>
                                        <h2 class="veylune-inquiry__title">
                                            {% if element.config.title.value %}
                                                {{ element.config.title.value|sw_sanitize }}
                                            {% else %}
                                                {{ 'veylune.inquiry.contactTitle'|trans|sw_sanitize }}
                                            {% endif %}
                                        </h2>
                                        <p class="veylune-inquiry__intro">{{ 'veylune.inquiry.contactIntro'|trans|sw_sanitize }}</p>
                                    </div>
                                {% endblock %}

                                {% block element_form_contact_form_form %}
                                    {% sw_include '@Storefront/storefront/element/cms-element-form/form-types/contact-form.html.twig'
                                        with {
                                            action: 'frontend.form.contact.send',
                                            submitText: 'veylune.inquiry.contactSubmit'
                                        }
                                    %}
                                {% endblock %}
                            {% elseif formType is same as('newsletter') %}
                                {% block element_form_newsletter_form_title %}
                                    <div class="veylune-inquiry__header">
                                        <p class="veylune-inquiry__eyebrow">{{ 'veylune.inquiry.newsletterEyebrow'|trans|sw_sanitize }}</p>
                                        <h2 class="veylune-inquiry__title">
                                            {% if element.config.title.value %}
                                                {{ element.config.title.value|sw_sanitize }}
                                            {% else %}
                                                {{ 'veylune.inquiry.newsletterTitle'|trans|sw_sanitize }}
                                            {% endif %}
                                        </h2>
                                        <p class="veylune-inquiry__intro">{{ 'veylune.inquiry.newsletterIntro'|trans|sw_sanitize }}</p>
                                    </div>
                                {% endblock %}

                                {% block element_form_newsletter_form_form %}
                                    {% sw_include '@Storefront/storefront/element/cms-element-form/form-types/newsletter-form.html.twig'
                                        with {
                                            action: 'frontend.form.newsletter.register.handle',
                                            submitText: 'veylune.inquiry.newsletterSubmit'
                                        }
                                    %}
                                {% endblock %}
                            {% elseif formType is same as('revocationRequest') %}
                                {{ parent() }}
                            {% endif %}
                        {% endblock %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
