{% sw_extends '@Storefront/storefront/element/cms-element-form/form-types/contact-form.html.twig' %}

{% block cms_form_contact %}
    {% set formPrefix = 'cms-form-contact-' ~ element.id %}
    <form action="{{ path(action) }}"
          method="post"
          data-form-handler="true"
          data-form-cms-handler="true"
          data-form-preserver="true"
          id="{{ formPrefix }}"
          class="veylune-inquiry__form veylune-inquiry__form--contact"
          aria-label="{{ element.config.title.value ? element.config.title.value : 'veylune.inquiry.contactTitle'|trans }}">
        <div class="form-content veylune-inquiry__content">
            {% if veyluneProjectBrief is defined %}
                <div class="vli-inquiry-status"
                     data-vli-inquiry-status
                     tabindex="-1"
                     aria-live="polite"
                     hidden></div>
            {% endif %}

            {% if veyluneProjectBrief is defined %}
                <section class="vli-project-intake" data-vli-project-intake aria-labelledby="{{ formPrefix }}-project-title">
                    <header class="vli-project-intake__header">
                        <span>01</span>
                        <div>
                            <p>{{ 'veylune.marketplace.contact.stepContext'|trans|sw_sanitize }}</p>
                            <h3 id="{{ formPrefix }}-project-title">{{ 'veylune.marketplace.contact.form.shapeTitle'|trans|sw_sanitize }}</h3>
                            <small>{{ 'veylune.marketplace.contact.form.shapeText'|trans|sw_sanitize }}</small>
                        </div>
                    </header>

                    <div class="vli-project-intake__grid">
                        <label for="{{ formPrefix }}-project-intent">
                            <span>{{ 'veylune.marketplace.contact.form.helpWith'|trans|sw_sanitize }}</span>
                            <select id="{{ formPrefix }}-project-intent" name="veyluneBriefIntent" data-vli-brief-field="intent">
                                <option value="Private project direction">{{ 'veylune.marketplace.contact.form.privateDirection'|trans|sw_sanitize }}</option>
                                <option value="One-room planning">{{ 'veylune.marketplace.contact.form.oneRoom'|trans|sw_sanitize }}</option>
                                <option value="Furniture sourcing">{{ 'veylune.marketplace.contact.form.furnitureSourcing'|trans|sw_sanitize }}</option>
                                <option value="Material and finish direction">{{ 'veylune.marketplace.contact.form.materialDirection'|trans|sw_sanitize }}</option>
                                <option value="Trade project support">{{ 'veylune.marketplace.contact.form.tradeSupport'|trans|sw_sanitize }}</option>
                                <option value="General studio inquiry">{{ 'veylune.marketplace.contact.form.generalInquiry'|trans|sw_sanitize }}</option>
                            </select>
                        </label>

                        <label for="{{ formPrefix }}-project-space">
                            <span>{{ 'veylune.marketplace.contact.form.primarySpace'|trans|sw_sanitize }}</span>
                            <select id="{{ formPrefix }}-project-space" name="veyluneBriefSpace" data-vli-brief-field="space">
                                <option value="Not decided">{{ 'veylune.marketplace.contact.form.notDecided'|trans|sw_sanitize }}</option>
                                <option value="Living room">{{ 'veylune.marketplace.contact.form.livingRoom'|trans|sw_sanitize }}</option>
                                <option value="Dining room">{{ 'veylune.marketplace.contact.form.diningRoom'|trans|sw_sanitize }}</option>
                                <option value="Bedroom">{{ 'veylune.marketplace.contact.form.bedroom'|trans|sw_sanitize }}</option>
                                <option value="Home office">{{ 'veylune.marketplace.contact.form.homeOffice'|trans|sw_sanitize }}</option>
                                <option value="Whole home">{{ 'veylune.marketplace.contact.form.wholeHome'|trans|sw_sanitize }}</option>
                                <option value="Hospitality or commercial">{{ 'veylune.marketplace.contact.form.hospitality'|trans|sw_sanitize }}</option>
                                <option value="Multiple spaces">{{ 'veylune.marketplace.contact.form.multipleSpaces'|trans|sw_sanitize }}</option>
                                <option value="Other">{{ 'veylune.marketplace.contact.form.other'|trans|sw_sanitize }}</option>
                            </select>
                        </label>

                        <label for="{{ formPrefix }}-project-stage">
                            <span>{{ 'veylune.marketplace.contact.form.projectStage'|trans|sw_sanitize }}</span>
                            <select id="{{ formPrefix }}-project-stage" name="veyluneBriefStage" data-vli-brief-field="stage">
                                <option value="Exploring possibilities">{{ 'veylune.marketplace.contact.form.exploring'|trans|sw_sanitize }}</option>
                                <option value="Planning the room">{{ 'veylune.marketplace.contact.form.planning'|trans|sw_sanitize }}</option>
                                <option value="Actively sourcing">{{ 'veylune.marketplace.contact.form.sourcing'|trans|sw_sanitize }}</option>
                                <option value="Ready to specify">{{ 'veylune.marketplace.contact.form.ready'|trans|sw_sanitize }}</option>
                                <option value="Ongoing project">{{ 'veylune.marketplace.contact.form.ongoing'|trans|sw_sanitize }}</option>
                            </select>
                        </label>

                        <label for="{{ formPrefix }}-project-timing">
                            <span>{{ 'veylune.marketplace.contact.form.timing'|trans|sw_sanitize }}</span>
                            <select id="{{ formPrefix }}-project-timing" name="veyluneBriefTiming" data-vli-brief-field="timing">
                                <option value="Flexible">{{ 'veylune.marketplace.contact.form.flexible'|trans|sw_sanitize }}</option>
                                <option value="Within 3 months">{{ 'veylune.marketplace.contact.form.withinThree'|trans|sw_sanitize }}</option>
                                <option value="3 to 6 months">{{ 'veylune.marketplace.contact.form.threeSix'|trans|sw_sanitize }}</option>
                                <option value="6 to 12 months">{{ 'veylune.marketplace.contact.form.sixTwelve'|trans|sw_sanitize }}</option>
                                <option value="More than 12 months">{{ 'veylune.marketplace.contact.form.overTwelve'|trans|sw_sanitize }}</option>
                            </select>
                        </label>

                        <label for="{{ formPrefix }}-project-location">
                            <span>{{ 'veylune.marketplace.contact.form.location'|trans|sw_sanitize }} <small>{{ 'veylune.marketplace.contact.form.optional'|trans|sw_sanitize }}</small></span>
                            <input id="{{ formPrefix }}-project-location" name="veyluneBriefLocation" type="text" maxlength="100" autocomplete="address-level2" placeholder="{{ 'veylune.marketplace.contact.form.locationPlaceholder'|trans|striptags }}" data-vli-brief-field="location">
                        </label>

                        <label for="{{ formPrefix }}-project-investment">
                            <span>{{ 'veylune.marketplace.contact.form.investment'|trans|sw_sanitize }} <small>{{ 'veylune.marketplace.contact.form.optional'|trans|sw_sanitize }}</small></span>
                            <select id="{{ formPrefix }}-project-investment" name="veyluneBriefInvestment" data-vli-brief-field="investment">
                                <option value="Not defined">{{ 'veylune.marketplace.contact.form.notDefined'|trans|sw_sanitize }}</option>
                                <option value="Under EUR 10,000">{{ 'veylune.marketplace.contact.form.underTen'|trans|sw_sanitize }}</option>
                                <option value="EUR 10,000 to 25,000">{{ 'veylune.marketplace.contact.form.tenTwentyFive'|trans|sw_sanitize }}</option>
                                <option value="EUR 25,000 to 50,000">{{ 'veylune.marketplace.contact.form.twentyFiveFifty'|trans|sw_sanitize }}</option>
                                <option value="EUR 50,000 to 100,000">{{ 'veylune.marketplace.contact.form.fiftyHundred'|trans|sw_sanitize }}</option>
                                <option value="Above EUR 100,000">{{ 'veylune.marketplace.contact.form.aboveHundred'|trans|sw_sanitize }}</option>
                            </select>
                        </label>
                    </div>

                    <section class="vli-project-intake__selection" data-vli-brief-selection hidden aria-labelledby="{{ formPrefix }}-selection-title">
                        <div>
                            <p>{{ 'veylune.marketplace.contact.form.savedSelection'|trans|sw_sanitize }}</p>
                            <h4 id="{{ formPrefix }}-selection-title">{{ 'veylune.marketplace.contact.form.savedFound'|trans({'%count%': '<span data-vli-brief-selection-count>0</span>'})|raw }}</h4>
                            <small>{{ 'veylune.marketplace.contact.form.savedReview'|trans|sw_sanitize }}</small>
                        </div>
                        <ul data-vli-brief-selection-list></ul>
                        <label class="vli-project-intake__consent">
                            <input type="checkbox" name="veyluneBriefIncludeSelection" value="1" data-vli-brief-include-selection>
                            <span>{{ 'veylune.marketplace.contact.form.includeSaved'|trans|sw_sanitize }}</span>
                        </label>
                    </section>

                    <section class="vli-project-intake__preview" aria-labelledby="{{ formPrefix }}-preview-title">
                        <div>
                            <p>{{ 'veylune.marketplace.contact.form.preview'|trans|sw_sanitize }}</p>
                            <h4 id="{{ formPrefix }}-preview-title">{{ 'veylune.marketplace.contact.form.studioReceive'|trans|sw_sanitize }}</h4>
                        </div>
                        <dl data-vli-brief-preview></dl>
                    </section>
                </section>

                <div class="vli-project-intake__contact-head">
                    <span>02</span>
                    <div><strong>{{ 'veylune.marketplace.contact.form.detailsTitle'|trans|sw_sanitize }}</strong><small>{{ 'veylune.marketplace.contact.form.detailsText'|trans|sw_sanitize }}</small></div>
                </div>
            {% endif %}

            <div class="row g-3">
                {% block cms_form_contact_select_salutation %}
                    {% sw_include '@Storefront/storefront/element/cms-element-form/form-components/cms-element-form-select-salutation.html.twig'
                        with {
                        additionalClass: 'col-md-4 veylune-inquiry__field',
                        required: true
                    }
                    %}
                {% endblock %}

                {% block cms_form_contact_input_first_name %}
                    {% set firstNameFieldRequired = config('core.basicInformation.firstNameFieldRequired') == true %}
                    {% sw_include '@Storefront/storefront/element/cms-element-form/form-components/cms-element-form-input.html.twig'
                        with {
                        fieldName: 'firstName',
                        autocomplete: 'section-personal given-name',
                        required: firstNameFieldRequired,
                        additionalClass: 'col-md-4',
                        label: 'account.personalFirstNameLabel',
                        placeholder: 'account.personalFirstNamePlaceholder'
                    }
                    %}
                {% endblock %}

                {% block cms_form_contact_input_last_name %}
                    {% set lastNameFieldRequired = config('core.basicInformation.lastNameFieldRequired') == true %}
                    {% sw_include '@Storefront/storefront/element/cms-element-form/form-components/cms-element-form-input.html.twig'
                        with {
                        fieldName: 'lastName',
                        autocomplete: 'section-personal family-name',
                        required: lastNameFieldRequired,
                        additionalClass: 'col-md-4',
                        label: 'account.personalLastNameLabel',
                        placeholder: 'account.personalLastNamePlaceholder'
                    }
                    %}
                {% endblock %}
            </div>

            <div class="row g-3">
                {% block cms_form_contact_input_email %}
                    {% sw_include '@Storefront/storefront/element/cms-element-form/form-components/cms-element-form-input.html.twig'
                        with {
                        fieldName: 'email',
                        autocomplete: 'email',
                        type: 'email',
                        required: true,
                        additionalClass: 'col-md-6',
                        label: 'account.loginMailLabel',
                        placeholder: 'account.loginMailPlaceholder'
                    }
                    %}
                {% endblock %}

                {% block cms_form_contact_input_phone %}
                    {% set phoneNumberFieldRequired = config('core.basicInformation.phoneNumberFieldRequired') == true %}
                    {% sw_include '@Storefront/storefront/element/cms-element-form/form-components/cms-element-form-input.html.twig'
                        with {
                        fieldName: 'phone',
                        autocomplete: 'tel',
                        required: phoneNumberFieldRequired,
                        additionalClass: 'col-md-6',
                        label: 'account.personalPhoneLabel',
                        placeholder: 'account.personalPhonePlaceholder'
                    }
                    %}
                {% endblock %}
            </div>

            <div class="row g-3">
                {% block cms_form_contact_input_subject %}
                    {% sw_include '@Storefront/storefront/element/cms-element-form/form-components/cms-element-form-input.html.twig'
                        with {
                        required: true,
                        fieldName: 'subject',
                        additionalClass: 'col-12',
                        label: veyluneProjectBrief is defined ? 'Inquiry title' : 'contact.subjectLabel',
                        placeholder: veyluneProjectBrief is defined ? 'A short title for this project' : 'contact.subjectPlaceholder'
                    }
                    %}
                {% endblock %}
            </div>

            <div class="row g-3">
                {% block cms_form_contact_comment_textarea %}
                    {% sw_include '@Storefront/storefront/element/cms-element-form/form-components/cms-element-form-textarea.html.twig'
                        with {
                        rows: veyluneProjectBrief is defined ? 10 : 6,
                        required: true,
                        fieldName: 'comment',
                        additionalClass: 'col-12',
                        label: veyluneProjectBrief is defined ? 'Project brief and notes' : 'contact.commentLabel',
                        placeholder: veyluneProjectBrief is defined ? 'Add approximate dimensions, existing pieces, access constraints, questions, or references.' : 'contact.commentPlaceholder'
                    }
                    %}
                {% endblock %}
            </div>

            {% block cms_form_contact_captcha %}
                <div class="veylune-inquiry__captcha">
                    {% sw_include '@Storefront/storefront/component/captcha/base.html.twig' with { additionalClass : 'col-md-12' } %}
                </div>
            {% endblock %}

            {% block cms_form_contact_privacy %}
                {% sw_include '@Storefront/storefront/element/cms-element-form/form-components/cms-element-form-privacy.html.twig' %}
            {% endblock %}

            {% if veyluneProjectBrief is defined %}
                <div class="vli-project-intake__boundary">
                    <span>03</span>
                    <p><strong>Review before sending.</strong> Saved paths are included only when selected above. Sending this form requests a studio review; scope, availability, pricing, delivery, and installation remain unconfirmed until agreed separately.</p>
                </div>
            {% endif %}

            {% block cms_form_contact_required_fields_info %}
                <div class="veylune-inquiry__required">
                    {% sw_include '@Storefront/storefront/element/cms-element-form/form-components/cms-element-form-info-required.html.twig' %}
                </div>
            {% endblock %}

            {% block cms_form_contact_submit %}
                {% sw_include '@Storefront/storefront/element/cms-element-form/form-components/cms-element-form-submit.html.twig' with {
                    submitText: veyluneProjectBrief is defined ? 'Send project brief' : submitText
                } %}
            {% endblock %}
        </div>

        {% block cms_form_contact_hidden_fields %}
            <div class="form-hidden-fields">
                {% if page.navigationId and page.entityName %}
                    <input type="hidden" id="{{ formPrefix }}-navigationId" name="navigationId" value="{{ page.navigationId }}">
                    <input type="hidden" id="{{ formPrefix }}-entityName" name="entityName" value="{{ page.entityName }}">
                {% else %}
                    <input type="hidden" id="{{ formPrefix }}-navigationId" name="navigationId" value="{{ shopware.navigation.id }}">
                {% endif %}

                <input type="hidden" id="{{ formPrefix }}-slotId" name="slotId" value="{{ element.id }}">

                <input type="submit" class="submit--hidden d-none">
            </div>
        {% endblock %}
    </form>
{% endblock %}
