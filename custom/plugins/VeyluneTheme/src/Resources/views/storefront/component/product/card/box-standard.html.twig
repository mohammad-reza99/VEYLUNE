{% block component_product_box %}
    {% if product %}
        {% set name = product.translated.name %}
        {% set price = product.calculatedPrice %}
        {% set routeArguments = product.childCount > 0 and page.searchTerm ? { productId: product.id, search: page.searchTerm } : { productId: product.id } %}
        {% if referrerCategoryId %}{% set routeArguments = routeArguments|merge({ referrerCategoryId: referrerCategoryId }) %}{% endif %}
        {% set productUrl = veyluneUseLivingIndexObjectRoute|default(false) ? path('frontend.veylune.object.page', { productNumber: product.productNumber }) : seoUrl('frontend.detail.page', routeArguments) %}
        {% set productCustomFields = product.translated.customFields|default(product.customFields|default({})) %}
        {% set commercePosture = productCustomFields.veylune_consultation_mode|default(product.available ? 'direct' : 'consultation') %}
        {% set materialLabels = [] %}{% set materialKeys = [] %}
        {% for property in product.properties|default([]) %}
            {% set groupName = property.group.translated.name|default(property.group.name|default('')) %}
            {% if groupName == 'Material' %}
                {% set materialName = property.translated.name|default(property.name) %}
                {% set materialLabels = materialLabels|merge([materialName]) %}
                {% set materialKeys = materialKeys|merge([materialName|lower|replace({' ': '-', '/': '-'})]) %}
            {% endif %}
        {% endfor %}
        {% set categoryName = product.categories.first.translated.name|default('Veylune object') %}
        {% set cover = product.cover.media|default(null) %}
        {% set discoveryCard = {
            scope: 'public', id: product.id, recordId: product.productNumber, name: name, productType: categoryName,
            materials: materialKeys, materialLabel: materialLabels is not empty ? materialLabels|join(' / ') : categoryName,
            status: product.available ? 'Available' : 'Availability on request', statusKey: product.available ? 'available' : 'on_request',
            price: price.unitPrice|default(null), priceNote: commercePosture == 'direct' ? 'Current price' : 'Final terms confirmed before order',
            availability: product.available ? 'Available to order' : 'Studio availability check', coverUrl: cover.url|default(''), coverAlt: cover.translated.alt|default(name)
        } %}
        {% sw_include '@Storefront/storefront/veylune/discovery-product-card.html.twig' with { discoveryCard: discoveryCard, productUrl: productUrl, publicProduct: product, productIndex: productIndex|default(loop.index0|default(0)) } %}
    {% endif %}
{% endblock %}
