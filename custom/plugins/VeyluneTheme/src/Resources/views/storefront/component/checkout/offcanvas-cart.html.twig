{% sw_extends '@Storefront/storefront/component/checkout/offcanvas-cart.html.twig' %}

{% set isCanonicalLocalCheckout = context.salesChannel.id == '019e3bf9c220717884d2a4eaca77c2d1' and app.request.host == 'veylune-shopware.ddev.site' %}

{% block utilities_offcanvas_close_text %}
    {{ context.salesChannel.id == '019f7a00000070008000000000000001' ? 'Continue shopping' : 'veylune.cart.continueExploring'|trans|sw_sanitize }}
{% endblock %}

{% block component_offcanvas_cart_header %}
    <div class="row align-items-start offcanvas-cart-header veylune-offcanvas-cart__header">
        <div class="col">
            <p class="veylune-offcanvas-cart__eyebrow">{{ context.salesChannel.id == '019f7a00000070008000000000000001' ? 'Local commerce test' : 'Shopping cart' }}</p>
            <h4 data-id="off-canvas-headline">
                Your cart
            </h4>
        </div>

        {% set checkoutItemCounter = page.cart.lineItems|length %}

        {% block component_offcanvas_cart_header_item_counter %}
            {% if isCartNotEmpty %}
                <div class="col-auto">
                    <small class="offcanvas-cart-header-count h4">
                        {{ 'checkout.itemCounter'|trans({'%count%': checkoutItemCounter})|sw_sanitize }}
                    </small>
                </div>
            {% endif %}
        {% endblock %}
    </div>
{% endblock %}

{% block component_offcanvas_cart_empty %}
    <div class="veylune-offcanvas-cart__empty" role="status">
        <p class="veylune-offcanvas-cart__eyebrow">{{ context.salesChannel.id == '019f7a00000070008000000000000001' ? 'Local commerce test' : 'Shopping cart' }}</p>
        <h4>{{ context.salesChannel.id in ['019e3bf9c220717884d2a4eaca77c2d1', '019f7a00000070008000000000000001'] ? 'Your cart is empty' : 'veylune.cart.emptyTitle'|trans|sw_sanitize }}</h4>
        <p>{{ context.salesChannel.id in ['019e3bf9c220717884d2a4eaca77c2d1', '019f7a00000070008000000000000001'] ? 'Explore the catalog and add a product to begin your order.' : 'veylune.cart.emptyText'|trans|sw_sanitize }}</p>
    </div>
{% endblock %}

{% block component_offcanvas_cart_actions_checkout %}
    {% if context.salesChannel.id == '019f7a00000070008000000000000001' or isCanonicalLocalCheckout %}
        {{ parent() }}
    {% else %}
    <div class="d-grid">
        <a {% if isCartNotEmpty %}href="{{ path('frontend.veylune.consultation.page', { source: 'cart' }) }}"{% else %}aria-disabled="true" tabindex="-1"{% endif %}
           class="btn begin-checkout-btn{% if isCartNotEmpty %} veylune-button{% else %} btn-light disabled{% endif %}"
           title="{{ 'veylune.cart.requestAcquisition'|trans|striptags }}">
            {{ 'veylune.cart.requestAcquisition'|trans|sw_sanitize }}
        </a>
    </div>
    {% endif %}
{% endblock %}

{% block component_offcanvas_cart_actions_cart %}
    <div class="d-grid">
        <a href="{{ path('frontend.checkout.cart.page') }}"
           class="btn btn-link"
           title="{{ 'veylune.cart.viewSelection'|trans|striptags }}">
            {{ context.salesChannel.id in ['019e3bf9c220717884d2a4eaca77c2d1', '019f7a00000070008000000000000001'] ? 'View cart' : 'veylune.cart.viewSelection'|trans|sw_sanitize }}
        </a>
    </div>
{% endblock %}
