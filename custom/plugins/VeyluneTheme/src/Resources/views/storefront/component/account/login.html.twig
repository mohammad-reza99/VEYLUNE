{% sw_extends '@Storefront/storefront/component/account/login.html.twig' %}

{% set isCanonicalLocalSurface = context.salesChannel.id == '019e3bf9c220717884d2a4eaca77c2d1' and app.request.host == 'veylune-shopware.ddev.site' %}
{% set isLocalTestSurface = context.salesChannel.id == '019f7a00000070008000000000000001' or isCanonicalLocalSurface %}
{% set isCheckoutSurface = app.request.pathInfo starts with '/checkout/' %}

{% block component_account_login_header %}
    <p class="veylune-account-auth__eyebrow">{{ isLocalTestSurface ? (isCheckoutSurface ? 'Returning client' : 'Account access') : 'veylune.account.privateClientSalon'|trans|sw_sanitize }}</p>
    {% if cardTitle %}
        <h2 class="veylune-account-section-title">{{ cardTitle }}</h2>
    {% else %}
        <h2 class="veylune-account-section-title">{{ 'account.loginHeader'|trans|sw_sanitize }}</h2>
    {% endif %}
{% endblock %}

{% block component_account_login_form_description %}
    <p class="login-form-description">
        {{ isLocalTestSurface ? 'Access saved addresses, local test orders and checkout history.' : 'veylune.account.loginIntro'|trans|sw_sanitize }}
    </p>
{% endblock %}
