{% import '@VeyluneTheme/storefront/veylune/category-routes.html.twig' as veyluneCategoryRoutes %}
{% set veyluneMobileDrawerPreviewToken = veyluneHeaderPreviewToken|default(veylunePreviewToken|default(null)) %}
<div class="veylune-mobile-marketplace" data-veylune-mobile-marketplace data-veylune-nav-surface="mobile">
    <form class="veylune-mobile-marketplace__search"
          action="{{ path('frontend.veylune.living_index.search') }}"
          method="get"
          role="search"
          aria-label="Search Veylune"
          data-veylune-mobile-search-form>
        <label class="visually-hidden" for="veyluneMobileMarketplaceSearch">{{ 'header.searchPlaceholder'|trans|striptags }}</label>
        <input id="veyluneMobileMarketplaceSearch" type="search" name="q" placeholder="Search objects, rooms, materials..." autocomplete="off" data-veylune-mobile-search-input>
        <button type="submit" aria-label="Search Veylune" data-veylune-mobile-search-submit>{% sw_icon 'search' %}</button>
    </form>

    <div class="veylune-mobile-marketplace__shortcuts">
        {% if veyluneMobileDrawerPreviewToken %}
            <a href="{{ path('frontend.veylune.preview.account', { token: veyluneMobileDrawerPreviewToken }) }}" data-veylune-preview-mobile-account>
                <span aria-hidden="true">{% sw_icon 'avatar' %}</span>
                <strong>Sign In</strong>
            </a>
            <a href="{{ path('frontend.veylune.preview.cart', { token: veyluneMobileDrawerPreviewToken }) }}" data-veylune-preview-mobile-cart>
                <span aria-hidden="true">{% sw_icon 'basket' %}</span>
                <strong>Cart</strong>
            </a>
        {% else %}
            <a href="{{ path('frontend.account.home.page') }}">
                <span aria-hidden="true">{% sw_icon 'avatar' %}</span>
                <strong>Sign In</strong>
            </a>
            <a href="{{ path('frontend.checkout.cart.page') }}">
                <span aria-hidden="true">{% sw_icon 'basket' %}</span>
                <strong>Cart</strong>
            </a>
        {% endif %}
    </div>

    <div class="veylune-mobile-marketplace__accordions">
        <details name="veylune-mobile-departments" data-veylune-mobile-accordion open>
            <summary id="veyluneMobileFeatured" aria-controls="veyluneMobileFeaturedPanel" aria-expanded="true">Featured</summary>
            <div class="veylune-mobile-marketplace__panel" id="veyluneMobileFeaturedPanel" role="region" aria-labelledby="veyluneMobileFeatured">
                <a href="{{ isPrivatePreview ? path('frontend.veylune.preview.catalog.home', { token: veyluneMobileDrawerPreviewToken }) : veyluneRoutes.editions }}">Veylune Edit</a>
                {% if isPrivatePreview %}<a href="{{ path('frontend.veylune.preview.catalog.collection', { collectionKey: 'new-arrivals', token: veyluneMobileDrawerPreviewToken }) }}">New Arrivals</a>{% else %}<a href="{{ veyluneCategoryRoutes.url('newArrivals') }}">New Arrivals</a>{% endif %}
                <a href="{{ veyluneCategoryRoutes.url('bestSellers') }}">Best Sellers</a>
                <a href="{{ veyluneRoutes.editions }}">Trending</a>
                <a href="{{ veyluneRoutes.partnership }}">Collaborations</a>
            </div>
        </details>

        <details name="veylune-mobile-departments" data-veylune-mobile-accordion>
            <summary id="veyluneMobileDepartments" aria-controls="veyluneMobileDepartmentsPanel" aria-expanded="false">Departments</summary>
            <div class="veylune-mobile-marketplace__panel" id="veyluneMobileDepartmentsPanel" role="region" aria-labelledby="veyluneMobileDepartments">
                <a href="{{ veyluneRoutes.shop }}" data-veylune-page-transition>Furniture</a>
                {% if isPrivatePreview %}<a href="{{ path('frontend.veylune.preview.catalog.category', { categoryKey: 'outdoor', token: veyluneMobileDrawerPreviewToken }) }}">Outdoor</a>{% else %}<a href="{{ veyluneCategoryRoutes.url('departmentOutdoor') }}">Outdoor</a>{% endif %}
                <a href="{{ veyluneCategoryRoutes.url('beddingBath') }}">Bedding &amp; Bath</a>
                <a href="{{ veyluneCategoryRoutes.url('mattresses') }}">Mattresses</a>
                <a href="{{ veyluneCategoryRoutes.url('rugs') }}">Rugs</a>
                <a href="{{ veyluneCategoryRoutes.url('departmentDecorObjects') }}">Decor &amp; Pillows</a>
                {% if isPrivatePreview %}<a href="{{ path('frontend.veylune.preview.catalog.category', { categoryKey: 'lighting', token: veyluneMobileDrawerPreviewToken }) }}">Lighting</a>{% else %}<a href="{{ veyluneCategoryRoutes.url('departmentLighting') }}">Lighting</a>{% endif %}
                <a href="{{ veyluneCategoryRoutes.url('organization') }}">Organization</a>
                <a href="{{ veyluneCategoryRoutes.url('sale') }}">Sale</a>
            </div>
        </details>

        <details name="veylune-mobile-departments" data-veylune-mobile-accordion>
            <summary id="veyluneMobileRooms" aria-controls="veyluneMobileRoomsPanel" aria-expanded="false">Shop by Room</summary>
            <div class="veylune-mobile-marketplace__panel" id="veyluneMobileRoomsPanel" role="region" aria-labelledby="veyluneMobileRooms">
                <a href="{{ veyluneRoutes.rooms }}" data-veylune-page-transition>Living Room</a>
                {% if isPrivatePreview %}
                    <a href="{{ path('frontend.veylune.preview.catalog.room', { roomKey: 'bedroom', token: veyluneMobileDrawerPreviewToken }) }}">Bedroom</a>
                    <a href="{{ path('frontend.veylune.preview.catalog.room', { roomKey: 'dining-room', token: veyluneMobileDrawerPreviewToken }) }}">Dining Room</a>
                    <a href="{{ path('frontend.veylune.preview.catalog.room', { roomKey: 'workspace', token: veyluneMobileDrawerPreviewToken }) }}">Home Office</a>
                {% else %}
                    <a href="{{ veyluneCategoryRoutes.url('bedroom') }}">Bedroom</a>
                    <a href="{{ veyluneCategoryRoutes.url('diningRoom') }}">Dining Room</a>
                    <a href="{{ veyluneCategoryRoutes.url('workspace') }}">Home Office</a>
                {% endif %}
                <a href="{{ veyluneCategoryRoutes.url('outdoorRoom') }}">Outdoor</a>
            </div>
        </details>

        <details name="veylune-mobile-departments" data-veylune-mobile-accordion>
            <summary id="veyluneMobileServices" aria-controls="veyluneMobileServicesPanel" aria-expanded="false">Services &amp; Inspiration</summary>
            <div class="veylune-mobile-marketplace__panel" id="veyluneMobileServicesPanel" role="region" aria-labelledby="veyluneMobileServices">
                <a href="{{ veyluneRoutes.consultation }}" data-veylune-page-transition>Design Consultation</a>
                <a href="{{ veyluneRoutes.editions }}" data-veylune-page-transition>Journal</a>
                <a href="{{ path('frontend.veylune.legal.page', { document: 'payment-delivery' }) }}">Payment &amp; Delivery</a>
                <a href="{{ veyluneRoutes.trade }}" data-veylune-page-transition>Trade Program</a>
            </div>
        </details>
    </div>
</div>
