{% sw_extends '@Storefront/storefront/layout/footer/footer.html.twig' %}

{% block layout_footer_inner_container %}
	{% import '@VeyluneTheme/storefront/veylune/category-routes.html.twig' as veyluneCategoryRoutes %}
	{% set veyluneContactPageId = config('core.basicInformation.contactPage') %}
	{% set veyluneInquiryUrl = path('frontend.veylune.contact.page') %}
	{% set veyluneRoutes = {
        partnership: path('frontend.veylune.partnership.page'),
        consultation: veyluneCategoryRoutes.url('consultation'),
        trade: path('frontend.veylune.trade.page'),
        contact: veyluneInquiryUrl
    } %}

	<footer class="veylune-footer" aria-label="{{ 'veylune.footer.ariaLabel'|trans|striptags }}">
		<div class="veylune-footer__inner">
			<div class="veylune-footer__brand">
				<div class="veylune-footer__logo">VEYLUNE</div>
				<p class="veylune-footer__text">
					{{ 'veylune.footer.brandText'|trans|sw_sanitize }}
				</p>
			</div>

			<div class="veylune-footer__column">
				<div class="veylune-footer__title">{{ 'veylune.footer.studio'|trans|sw_sanitize }}</div>
				<a class="veylune-footer__link" href="{{ path('frontend.home.page') }}#veylune-material-context">{{ 'veylune.header.nav.materialContext'|trans|sw_sanitize }}</a>
				<a class="veylune-footer__link" href="{{ path(app.request.locale starts with 'de' ? 'frontend.veylune.editions.page.de' : 'frontend.veylune.editions.page') }}">{{ 'veylune.header.nav.editions'|trans|sw_sanitize }}</a>
			</div>

			<div class="veylune-footer__column">
				<div class="veylune-footer__title">{{ 'veylune.footer.services'|trans|sw_sanitize }}</div>
				<a class="veylune-footer__link" href="{{ veyluneRoutes.consultation }}">{{ 'veylune.footer.privateConsultation'|trans|sw_sanitize }}</a>
				<a class="veylune-footer__link" href="{{ veyluneRoutes.trade }}">{{ 'veylune.footer.tradeProgram'|trans|sw_sanitize }}</a>
				<a class="veylune-footer__link" href="{{ veyluneRoutes.partnership }}">{{ 'veylune.footer.atelierPartnerships'|trans|sw_sanitize }}</a>
				<a class="veylune-footer__link" href="{{ veyluneRoutes.contact }}">{{ 'veylune.footer.contactStudio'|trans|sw_sanitize }}</a>
			</div>

			<div class="veylune-footer__column">
				<div class="veylune-footer__title">{{ 'veylune.footer.clientCare'|trans|sw_sanitize }}</div>
				<span class="veylune-footer__text">{{ 'veylune.footer.clientCareText'|trans|sw_sanitize }}</span>
			</div>
		</div>

		<div class="veylune-footer__bottom">
			<span>{{ 'veylune.footer.bottomBrand'|trans|sw_sanitize }}</span>
			<nav class="veylune-footer__legal" aria-label="{{ 'veylune.footer.legalAria'|trans|striptags }}">
				<a href="{{ path('frontend.veylune.legal.page', { document: 'privacy' }) }}">{{ 'veylune.footer.privacy'|trans|sw_sanitize }}</a>
				<a href="{{ path('frontend.veylune.legal.page', { document: 'imprint' }) }}">{{ 'veylune.footer.imprint'|trans|sw_sanitize }}</a>
				<a href="{{ path('frontend.veylune.legal.page', { document: 'terms' }) }}">{{ 'veylune.footer.terms'|trans|sw_sanitize }}</a>
				<a href="{{ path('frontend.veylune.legal.page', { document: 'payment-delivery' }) }}">{{ 'veylune.footer.paymentDelivery'|trans|sw_sanitize }}</a>
				<a href="{{ path('frontend.veylune.legal.page', { document: 'cancellation' }) }}">{{ 'veylune.footer.cancellation'|trans|sw_sanitize }}</a>
			</nav>
			<span>{{ "now"|date("Y") }} {{ 'veylune.footer.bottomHouse'|trans|sw_sanitize }}</span>
		</div>
	</footer>
{% endblock %}
