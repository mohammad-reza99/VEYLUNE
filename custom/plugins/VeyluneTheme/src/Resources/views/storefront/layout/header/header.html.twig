{% sw_extends '@Storefront/storefront/layout/header/header.html.twig' %}

{% block layout_header %}
    {% if context.salesChannel.id == '019f7a00000070008000000000000001' %}
        <div class="alert alert-info mb-0" role="status" data-local-commerce-banner>
            {{ 'veylune.marketplace.header.testBanner'|trans|sw_sanitize }}
            <a href="{{ path('frontend.veylune.local_commerce') }}">{{ 'veylune.marketplace.header.testCatalog'|trans|sw_sanitize }}</a>
            <a href="{{ path('frontend.checkout.cart.page') }}">{{ 'veylune.marketplace.header.testCart'|trans|sw_sanitize }}</a>
            <a href="{{ path('frontend.account.home.page') }}">{{ 'veylune.marketplace.header.myAccount'|trans|sw_sanitize }}</a>
        </div>
    {% endif %}
	{% import '@VeyluneTheme/storefront/veylune/category-routes.html.twig' as veyluneCategoryRoutes %}
    {% set publicSurfaces = veylunePublicSurfaces|default({}) %}
	{% set veyluneHeaderPreviewToken = veylunePreviewToken|default(
        app.request.pathInfo starts with '/__veylune-preview/' ? app.request.query.get('token') : null
    ) %}
    {% set isPrivatePreview = veyluneHeaderPreviewToken is not empty %}
    {% set isCanonicalCatalog = not isPrivatePreview %}
	{% set isNativeCartSurface = context.salesChannel.id in ['019e3bf9c220717884d2a4eaca77c2d1', '019f7a00000070008000000000000001'] %}
	{% set veyluneHeaderSearchRoute = 'frontend.veylune.catalog.search' %}
	{% set veyluneRoutes = {
        shop: isPrivatePreview ? path('frontend.veylune.preview.catalog.category', { categoryKey: 'furniture', token: veyluneHeaderPreviewToken }) : (isCanonicalCatalog ? path('frontend.veylune.catalog.category', { categoryKey: 'furniture' }) : veyluneCategoryRoutes.url('furniture')),
        rooms: isPrivatePreview ? path('frontend.veylune.preview.catalog.room', { roomKey: 'living-room', token: veyluneHeaderPreviewToken }) : (isCanonicalCatalog ? path('frontend.veylune.catalog.room', { roomKey: 'living-room' }) : veyluneCategoryRoutes.url('livingRoom')),
        collections: isPrivatePreview ? path('frontend.veylune.preview.catalog.collection', { collectionKey: 'founder-selection', token: veyluneHeaderPreviewToken }) : (isCanonicalCatalog ? path('frontend.veylune.catalog.collection', { collectionKey: 'founder-selection' }) : veyluneCategoryRoutes.url('founderSelection')),
        editions: path(app.request.locale starts with 'de' ? 'frontend.veylune.editions.page.de' : 'frontend.veylune.editions.page'),
        consultation: veyluneCategoryRoutes.url('consultation'),
        trade: path('frontend.veylune.trade.page'),
        partnership: path('frontend.veylune.partnership.page')
    } %}
    {% set veyluneNavigationRegistry = [
        {
            key: 'shop',
            label: 'veylune.header.nav.shop',
            url: veyluneRoutes.shop,
            mega: 'shop',
            desktop: true,
            mobile: true
        },
        {
            key: 'rooms',
            label: 'veylune.header.nav.rooms',
            url: veyluneRoutes.rooms,
            mega: 'rooms',
            desktop: true,
            mobile: true
        },
        {
            key: 'collections',
            label: 'veylune.header.nav.collections',
            url: veyluneRoutes.collections,
            mega: 'collections',
            desktop: true,
            mobile: true
        },
        {
            key: 'editions',
            label: 'veylune.header.nav.journal',
            url: veyluneRoutes.editions,
            mega: null,
            desktop: true,
            mobile: true
        },
        {
            key: 'consultation',
            label: 'veylune.header.nav.consultation',
            url: veyluneRoutes.consultation,
            mega: null,
            desktop: true,
            mobile: true
        }
    ] %}
    {% if isPrivatePreview %}
        {% set veyluneMegaCategories = [
            { key: 'furniture', label: 'veylune.home.discovery.categories.furniture', url: veyluneRoutes.shop, available: true }
        ] %}
        {% set veyluneMegaRooms = [
            { key: 'living-room', label: 'veylune.home.discovery.rooms.livingRoom', url: veyluneRoutes.rooms, available: true },
            { key: 'dining-room', label: 'veylune.home.discovery.rooms.diningRoom', url: path('frontend.veylune.preview.catalog.room', { roomKey: 'dining-room', token: veyluneHeaderPreviewToken }), available: true }
        ] %}
        {% set veyluneMegaCollections = [
            { key: 'founder-selection', label: 'veylune.home.discovery.collections.founderSelection', url: veyluneRoutes.collections, available: true },
            { key: 'new-arrivals', label: 'veylune.home.discovery.collections.newArrivals', url: path('frontend.veylune.preview.catalog.collection', { collectionKey: 'new-arrivals', token: veyluneHeaderPreviewToken }), available: true }
        ] %}
    {% elseif isCanonicalCatalog %}
        {% set veyluneMegaCategories = [
            { key: 'furniture', label: 'veylune.home.discovery.categories.furniture', url: path('frontend.veylune.catalog.category', { categoryKey: 'furniture' }), available: true },
            { key: 'lighting', label: 'veylune.home.discovery.categories.lighting', url: path('frontend.veylune.catalog.category', { categoryKey: 'lighting' }), available: true },
            { key: 'decor-objects', label: 'veylune.marketplace.header.departments.decorObjects', url: path('frontend.veylune.catalog.category', { categoryKey: 'decor-objects' }), available: true },
            { key: 'textiles-rugs', label: 'veylune.home.discovery.categories.textilesRugs', url: path('frontend.veylune.catalog.category', { categoryKey: 'textiles-rugs' }), available: true },
            { key: 'dining-kitchen', label: 'veylune.marketplace.header.departments.diningKitchen', url: path('frontend.veylune.catalog.category', { categoryKey: 'dining-kitchen' }), available: true },
            { key: 'outdoor', label: 'veylune.marketplace.header.departments.outdoor', url: path('frontend.veylune.catalog.category', { categoryKey: 'outdoor' }), available: true }
        ] %}
        {% set veyluneMegaRooms = [
            { key: 'living-room', label: 'veylune.home.discovery.rooms.livingRoom', url: path('frontend.veylune.catalog.room', { roomKey: 'living-room' }), available: true },
            { key: 'dining-room', label: 'veylune.home.discovery.rooms.diningRoom', url: path('frontend.veylune.catalog.room', { roomKey: 'dining-room' }), available: true },
            { key: 'bedroom', label: 'veylune.home.discovery.rooms.bedroom', url: path('frontend.veylune.catalog.room', { roomKey: 'bedroom' }), available: true },
            { key: 'workspace', label: 'veylune.home.discovery.rooms.workspace', url: path('frontend.veylune.catalog.room', { roomKey: 'workspace' }), available: true },
            { key: 'hallway', label: 'veylune.home.discovery.rooms.hallway', url: path('frontend.veylune.catalog.room', { roomKey: 'hallway' }), available: true }
        ] %}
        {% set veyluneMegaCollections = [
            { key: 'founder-selection', label: 'veylune.home.discovery.collections.founderSelection', url: path('frontend.veylune.catalog.collection', { collectionKey: 'founder-selection' }), available: true },
            { key: 'new-arrivals', label: 'veylune.home.discovery.collections.newArrivals', url: path('frontend.veylune.catalog.collection', { collectionKey: 'new-arrivals' }), available: true }
        ] %}
    {% else %}
        {# These destinations are governed public Living Index routes. Keep the menu
           independent from the legacy catalog-readiness registry so an open mega
           menu can never degrade into an empty interaction surface. #}
        {% set veyluneMegaCategories = [
            { key: 'furniture', label: 'veylune.home.discovery.categories.furniture', url: veyluneCategoryRoutes.url('furniture'), available: true },
            { key: 'outdoor', label: 'veylune.marketplace.header.departments.outdoor', url: veyluneCategoryRoutes.url('departmentOutdoor'), available: true },
            { key: 'bedding-bath', label: 'veylune.marketplace.header.departments.beddingBath', url: veyluneCategoryRoutes.url('beddingBath'), available: true },
            { key: 'mattresses', label: 'veylune.marketplace.header.departments.mattresses', url: veyluneCategoryRoutes.url('mattresses'), available: true },
            { key: 'rugs', label: 'veylune.marketplace.header.departments.rugs', url: veyluneCategoryRoutes.url('rugs'), available: true },
            { key: 'decor-objects', label: 'veylune.marketplace.header.departments.decorObjects', url: veyluneCategoryRoutes.url('departmentDecorObjects'), available: true },
            { key: 'lighting', label: 'veylune.home.discovery.categories.lighting', url: veyluneCategoryRoutes.url('departmentLighting'), available: true },
            { key: 'textiles-rugs', label: 'veylune.home.discovery.categories.textilesRugs', url: veyluneCategoryRoutes.url('textilesRugs'), available: true },
            { key: 'organization', label: 'veylune.marketplace.header.departments.organization', url: veyluneCategoryRoutes.url('organization'), available: true },
            { key: 'dining-kitchen', label: 'veylune.marketplace.header.departments.diningKitchen', url: veyluneCategoryRoutes.url('diningKitchen'), available: true },
            { key: 'sale', label: 'veylune.marketplace.header.departments.sale', url: veyluneCategoryRoutes.url('sale'), available: true }
        ] %}
        {% set veyluneMegaRooms = [
            { key: 'living-room', label: 'veylune.home.discovery.rooms.livingRoom', url: veyluneCategoryRoutes.url('livingRoom'), available: true },
            { key: 'dining-room', label: 'veylune.home.discovery.rooms.diningRoom', url: veyluneCategoryRoutes.url('diningRoom'), available: true },
            { key: 'bedroom', label: 'veylune.home.discovery.rooms.bedroom', url: veyluneCategoryRoutes.url('bedroom'), available: true },
            { key: 'workspace', label: 'veylune.home.discovery.rooms.workspace', url: veyluneCategoryRoutes.url('workspace'), available: true },
            { key: 'outdoor', label: 'veylune.home.discovery.rooms.outdoor', url: veyluneCategoryRoutes.url('outdoorRoom'), available: true }
        ] %}
        {% set veyluneMegaCollections = [
            { key: 'founder-selection', label: 'veylune.home.discovery.collections.founderSelection', url: veyluneCategoryRoutes.url('founderSelection'), available: true },
            { key: 'new-arrivals', label: 'veylune.home.discovery.collections.newArrivals', url: veyluneCategoryRoutes.url('newArrivals'), available: true },
            { key: 'best-sellers', label: 'veylune.marketplace.header.mobile.bestSellers', url: veyluneCategoryRoutes.url('bestSellers'), available: true },
            { key: 'sale', label: 'veylune.marketplace.header.departments.sale', url: veyluneCategoryRoutes.url('sale'), available: true }
        ] %}
    {% endif %}
    {% set veyluneDepartmentRail = (isPrivatePreview or isCanonicalCatalog) ? [] : [
        { key: 'furniture', label: 'veylune.marketplace.header.departments.furniture', url: veyluneCategoryRoutes.url('furniture') },
        { key: 'outdoor', label: 'veylune.marketplace.header.departments.outdoor', url: veyluneCategoryRoutes.url('departmentOutdoor') },
        { key: 'bedding-bath', label: 'veylune.marketplace.header.departments.beddingBath', url: veyluneCategoryRoutes.url('beddingBath') },
        { key: 'mattresses', label: 'veylune.marketplace.header.departments.mattresses', url: veyluneCategoryRoutes.url('mattresses') },
        { key: 'rugs', label: 'veylune.marketplace.header.departments.rugs', url: veyluneCategoryRoutes.url('rugs') },
        { key: 'decor-objects', label: 'veylune.marketplace.header.departments.decorObjects', url: veyluneCategoryRoutes.url('departmentDecorObjects') },
        { key: 'lighting', label: 'veylune.marketplace.header.departments.lighting', url: veyluneCategoryRoutes.url('departmentLighting') },
        { key: 'organization', label: 'veylune.marketplace.header.departments.organization', url: veyluneCategoryRoutes.url('organization') },
        { key: 'dining-kitchen', label: 'veylune.marketplace.header.departments.diningKitchen', url: veyluneCategoryRoutes.url('diningKitchen') },
        { key: 'sale', label: 'veylune.marketplace.header.departments.sale', url: veyluneCategoryRoutes.url('sale'), sale: true }
    ] %}
    {% set veyluneLivingIndexAxes = [
        { key: 'object', label: 'veylune.marketplace.header.axes.object', url: veyluneRoutes.shop, mega: 'shop' },
        { key: 'room', label: 'veylune.marketplace.header.axes.room', url: veyluneRoutes.rooms, mega: 'rooms' },
        { key: 'material', label: 'veylune.marketplace.header.axes.material', url: veyluneRoutes.editions, mega: null },
        { key: 'style', label: 'veylune.marketplace.header.axes.style', url: veyluneRoutes.collections, mega: 'collections' },
        { key: 'maker', label: 'veylune.marketplace.header.axes.maker', url: veyluneRoutes.partnership, mega: null },
        { key: 'project', label: 'veylune.marketplace.header.axes.project', url: veyluneRoutes.consultation, mega: null },
        { key: 'sale', label: 'veylune.marketplace.header.axes.sale', url: veyluneCategoryRoutes.url('sale'), mega: null }
    ] %}
    {% set veyluneHeaderPopularSearches = isCanonicalCatalog ? [
        { label: 'veylune.marketplace.header.searchLabels.livingRoom', query: 'living room', terms: 'living room sofa seating' },
        { label: 'veylune.marketplace.header.searchLabels.sofas', query: 'sofa', terms: 'sofa seating upholstery' },
        { label: 'veylune.marketplace.header.searchLabels.oakFurniture', query: 'oak furniture', terms: 'oak wood furniture table' },
        { label: 'veylune.marketplace.header.searchLabels.sculpturalLighting', query: 'lighting', terms: 'light lighting lamp sculptural' },
        { label: 'veylune.marketplace.header.searchLabels.travertine', query: 'travertine', terms: 'travertine stone table object' }
    ] : [
        { label: 'veylune.marketplace.header.searchLabels.livingRoom', query: 'living room', terms: 'living room sofa seating' },
        { label: 'veylune.marketplace.header.searchLabels.quietContrast', query: 'quiet contrast', terms: 'quiet contrast style restraint' },
        { label: 'veylune.marketplace.header.searchLabels.oakFurniture', query: 'oak furniture', terms: 'oak wood furniture table' },
        { label: 'veylune.marketplace.header.searchLabels.sculpturalLighting', query: 'sculptural lighting', terms: 'light lighting lamp sculptural' },
        { label: 'veylune.marketplace.header.searchLabels.privateProject', query: 'private project', terms: 'project design service consultation' }
    ] %}
    {% set veyluneHeaderProductSearches = [
        { label: 'veylune.marketplace.header.searchLabels.furniture', query: 'furniture' },
        { label: 'veylune.marketplace.header.searchLabels.lighting', query: 'lighting' },
        { label: 'veylune.marketplace.header.searchLabels.vessels', query: 'vessels' },
        { label: 'veylune.marketplace.header.searchLabels.seating', query: 'chair' },
        { label: 'veylune.marketplace.header.searchLabels.tables', query: 'table' },
        { label: 'veylune.marketplace.header.searchLabels.outdoor', query: 'outdoor' }
    ] %}

	<header class="veylune-header veylune-header--living-index" data-veylune-header data-veylune-living-index-header>
		{% block layout_header_navigation %}
            <div class="veylune-marketplace-utility" aria-label="{{ 'veylune.marketplace.header.storeServices'|trans|striptags }}">
                <div class="veylune-marketplace-utility__inner">
                    <div class="veylune-marketplace-family" aria-label="{{ 'veylune.marketplace.header.family'|trans|striptags }}">
                        <a class="veylune-marketplace-family__primary" href="{{ path('frontend.home.page') }}">Veylune</a>
                        <a href="{{ veyluneRoutes.rooms }}">{{ 'veylune.marketplace.header.rooms'|trans|sw_sanitize }}</a>
                        <a href="{{ veyluneRoutes.editions }}">{{ 'veylune.marketplace.header.materialIndex'|trans|sw_sanitize }}</a>
                    </div>
                    <a class="veylune-marketplace-utility__announcement"
                       href="{{ veyluneRoutes.consultation }}">
                        {{ 'veylune.marketplace.header.appointment'|trans|sw_sanitize }}
                    </a>
                    <div class="veylune-marketplace-utility__right">
                        <nav class="veylune-marketplace-utility__links" aria-label="{{ 'veylune.marketplace.header.programs'|trans|striptags }}">
                            <a href="{{ veyluneRoutes.partnership }}">{{ 'veylune.marketplace.header.partnerships'|trans|sw_sanitize }}</a>
                            <a href="{{ veyluneRoutes.consultation }}">{{ 'veylune.marketplace.header.designService'|trans|sw_sanitize }}</a>
                            {% set activeLocaleParts = context.languageInfo.localeCode|upper|split('-') %}
                            <div class="veylune-marketplace-locale dropdown" data-veylune-locale-switcher>
                                <button class="veylune-marketplace-locale__trigger"
                                        type="button"
                                        id="veyluneLocaleDropdown"
                                        data-bs-toggle="dropdown"
                                        data-bs-auto-close="outside"
                                        aria-haspopup="true"
                                        aria-expanded="false"
                                        aria-label="{{ 'veylune.marketplace.header.localeAria'|trans({'%language%': context.languageInfo.name, '%currency%': context.currency.translated.name})|striptags }}"
                                        data-veylune-locale-trigger>
                                    <span>{{ activeLocaleParts[0] }} / {{ context.currency.isoCode }}</span>
                                    <span class="veylune-marketplace-locale__chevron" aria-hidden="true"></span>
                                </button>
                                <div class="veylune-marketplace-locale__menu dropdown-menu dropdown-menu-end"
                                     aria-labelledby="veyluneLocaleDropdown"
                                     data-veylune-locale-menu>
                                    {% if header.languages.count > 1 %}
                                        <section class="veylune-marketplace-locale__section" aria-labelledby="veyluneLocaleLanguageLabel">
                                            <p class="veylune-marketplace-locale__label" id="veyluneLocaleLanguageLabel">{{ 'veylune.marketplace.header.language'|trans|sw_sanitize }}</p>
                                            <form method="post"
                                                  action="{{ path('frontend.checkout.switch-language') }}"
                                                  class="veylune-marketplace-locale__options language-form"
                                                  data-form-add-dynamic-redirect="true">
                                                {% for language in header.languages %}
                                                    {% set isActiveLanguage = language.id is same as(context.context.languageId) %}
                                                    {% set localeParts = language.translationCode.code|upper|split('-') %}
                                                    <button class="veylune-marketplace-locale__option{{ isActiveLanguage ? ' is-active' : '' }}"
                                                            type="submit"
                                                            name="languageId"
                                                            value="{{ language.id }}"
                                                            data-veylune-locale-language="{{ language.translationCode.code }}"
                                                            {% if isActiveLanguage %}aria-current="true"{% endif %}>
                                                        <span>{{ localeParts[0] }}</span>
                                                        <strong>{{ language.name }}</strong>
                                                    </button>
                                                    {% if app.request.attributes.get('_route_params')['_locale'] %}
                                                        <input type="hidden" name="languageCode_{{ language.id }}" value="{{ language.translationCode.code }}">
                                                    {% endif %}
                                                {% endfor %}
                                            </form>
                                        </section>
                                    {% endif %}
                                    {% if header.currencies.count > 1 %}
                                        <section class="veylune-marketplace-locale__section" aria-labelledby="veyluneLocaleCurrencyLabel">
                                            <p class="veylune-marketplace-locale__label" id="veyluneLocaleCurrencyLabel">{{ 'veylune.marketplace.header.currency'|trans|sw_sanitize }}</p>
                                            <form method="post"
                                                  action="{{ path('frontend.checkout.configure') }}"
                                                  class="veylune-marketplace-locale__options currency-form"
                                                  data-form-add-dynamic-redirect="true">
                                                {% for currency in header.currencies %}
                                                    {% set isActiveCurrency = currency.id is same as(context.currency.id) %}
                                                    <button class="veylune-marketplace-locale__option{{ isActiveCurrency ? ' is-active' : '' }}"
                                                            type="submit"
                                                            name="currencyId"
                                                            value="{{ currency.id }}"
                                                            data-veylune-locale-currency="{{ currency.isoCode }}"
                                                            {% if isActiveCurrency %}aria-current="true"{% endif %}>
                                                        <span>{{ currency.isoCode }}</span>
                                                        <strong>{{ currency.symbol }} {{ currency.translated.name }}</strong>
                                                    </button>
                                                {% endfor %}
                                            </form>
                                        </section>
                                    {% endif %}
                                </div>
                            </div>
                        </nav>
                    </div>
                </div>
            </div>
			<div class="veylune-header__bar">
				<div class="veylune-header__inner">

					<div class="veylune-header__mobile-toggle">
						{% block layout_header_navigation_toggle %}
							<button class="veylune-header__icon-button nav-main-toggle-btn header-actions-btn" type="button" data-veylune-mobile-toggle aria-expanded="false" aria-controls="veyluneMobileNav" aria-label="{{ 'general.menuLink'|trans|striptags }}">
								{% sw_icon 'stack' %}
							</button>
						{% endblock %}
					</div>

					{% block layout_header_logo %}
						<a class="veylune-header__logo" href="{{ path('frontend.home.page') }}" aria-label="{{ 'header.logoLink'|trans|striptags }}">
							<span class="veylune-header__logo-main">
								veylune
							</span>
						</a>
					{% endblock %}

                    <div class="veylune-marketplace-search" data-veylune-header-search>
                        <form class="veylune-marketplace-search__form" action="{{ path(veyluneHeaderSearchRoute) }}" method="get" role="search" data-veylune-header-search-form>
                            <label class="visually-hidden" for="veyluneMarketplaceSearch">{{ 'header.searchPlaceholder'|trans|striptags }}</label>
                            <input id="veyluneMarketplaceSearch"
                                   class="veylune-marketplace-search__input"
                                   type="search"
                                   role="combobox"
                                   name="q"
                                   value="{{ app.request.attributes.get('_route') == 'frontend.veylune.catalog.search' ? app.request.query.get('q')|default('') : '' }}"
                                   autocomplete="off"
                                   placeholder="{{ 'veylune.marketplace.header.searchPlaceholder'|trans|striptags }}"
                                   aria-autocomplete="list"
                                   aria-controls="veyluneMarketplaceSuggestions"
                                   aria-expanded="false"
                                   data-vli-header-search-input
                                   aria-label="{{ 'header.searchPlaceholder'|trans|striptags }}">
                            <button class="veylune-marketplace-search__submit" type="submit">{{ 'veylune.marketplace.header.search'|trans|sw_sanitize }}</button>
                        </form>
                        <section class="vli-header-suggest"
                                 id="veyluneMarketplaceSuggestions"
                                 aria-label="{{ 'veylune.marketplace.header.searchSuggestions'|trans|striptags }}"
                                 aria-live="polite"
                                 data-vli-header-suggest
                                 hidden>
                            <a class="vli-header-suggest__query"
                               href="{{ path(veyluneHeaderSearchRoute) }}"
                               data-vli-header-query-link
                               hidden>
                                <span>{{ 'veylune.marketplace.header.searchFor'|trans|sw_sanitize }}</span>
                                <strong data-vli-header-query-label></strong>
                                <b aria-hidden="true">&rarr;</b>
                            </a>
                            <div class="vli-header-suggest__grid">
                                <div>
                                    <p>{{ 'veylune.marketplace.header.popularSearches'|trans|sw_sanitize }}</p>
                                    {% for suggestion in veyluneHeaderPopularSearches %}
                                        <a href="{{ path(veyluneHeaderSearchRoute, { q: suggestion.query }) }}"
                                           data-vli-header-suggestion
                                           data-search-terms="{{ suggestion.terms }}">{{ suggestion.label|trans|sw_sanitize }}</a>
                                    {% endfor %}
                                </div>
                                <div>
                                    <p>{{ (isCanonicalCatalog ? 'veylune.marketplace.header.exploreProducts' : 'veylune.marketplace.header.exploreByType')|trans|sw_sanitize }}</p>
                                    {% if isCanonicalCatalog %}
                                        {% for suggestion in veyluneHeaderProductSearches %}
                                            <a href="{{ path(veyluneHeaderSearchRoute, { q: suggestion.query }) }}"
                                               data-vli-header-suggestion
                                               data-search-terms="{{ suggestion.query }} {{ suggestion.label|trans|lower }}">{{ suggestion.label|trans|sw_sanitize }}</a>
                                        {% endfor %}
                                    {% else %}
                                        {% for axis in veyluneLivingIndexAxes %}
                                            {% if axis.key != 'sale' %}
                                                <a href="{{ path(veyluneHeaderSearchRoute, { axis: axis.key }) }}"
                                                   data-vli-header-suggestion
                                                   data-search-terms="{{ axis.key }} {{ axis.label|lower }}">{{ axis.label }}</a>
                                            {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                </div>
                            </div>
                            <small data-vli-header-search-scope>{{ (isCanonicalCatalog ? 'veylune.marketplace.header.catalogScope' : 'veylune.marketplace.header.livingScope')|trans|sw_sanitize }}</small>
                        </section>
                    </div>
					<nav class="veylune-header__nav" id="veylunePrimaryNavigation" aria-label="{{ 'veylune.header.primaryNavAriaLabel'|trans|striptags }}" data-veylune-nav-surface="primary">
                        {% for axis in veyluneLivingIndexAxes %}
                                <a class="veylune-header__nav-link{% if axis.key == 'sale' %} veylune-header__nav-link--sale{% endif %}"
                                   href="{{ axis.url }}"
                                   id="veyluneNavTrigger-{{ axis.mega|default(axis.key) }}"
                                   data-veylune-nav-key="{{ axis.key }}"
                                   {% if axis.mega %}data-veylune-mega-trigger="{{ axis.mega }}" aria-haspopup="true" aria-expanded="false" aria-controls="veyluneMegaPanel-{{ axis.mega }}"{% endif %}
                                   data-veylune-page-transition>
                                    {{ axis.label|trans|sw_sanitize }}
                                </a>
                        {% endfor %}
					</nav>

					<div class="veylune-header__actions">
						{% block layout_header_search %}
                            <a class="veylune-header__search-toggle veylune-header__search-toggle--mobile" href="#veyluneMarketplaceSearch" aria-label="{{ 'header.searchButton'|trans|striptags }}">
                                <span class="veylune-header__search-toggle-icon" aria-hidden="true">{% sw_icon 'search' %}</span>
                            </a>
                        {% endblock %}

                        {% block layout_header_actions_account %}
                            {% if isPrivatePreview %}
                                <a class="veylune-marketplace-action" href="{{ path('frontend.veylune.preview.account', { token: veyluneHeaderPreviewToken }) }}" aria-label="{{ 'veylune.marketplace.header.privateAccount'|trans|striptags }}" data-veylune-preview-account data-veylune-header-account>
                                    <span class="veylune-marketplace-action__icon" aria-hidden="true">{% sw_icon 'avatar' %}</span>
                                    <span class="veylune-marketplace-action__label">{{ 'veylune.marketplace.header.signIn'|trans|sw_sanitize }}</span>
                                </a>
                            {% else %}
                                <a class="veylune-marketplace-action" href="{{ path('frontend.account.home.page') }}" aria-label="{{ 'account.myAccount'|trans|striptags }}" data-veylune-header-account>
                                    <span class="veylune-marketplace-action__icon" aria-hidden="true">{% sw_icon 'avatar' %}</span>
                                    <span class="veylune-marketplace-action__label">{{ (context.salesChannel.id == '019f7a00000070008000000000000001' and context.customer and not context.customer.guest ? 'veylune.marketplace.header.myAccount' : 'veylune.marketplace.header.signIn')|trans|sw_sanitize }}</span>
                                </a>
                            {% endif %}
                        {% endblock %}

						{% block layout_header_actions_cart %}
                            {% if isPrivatePreview %}
                                <a class="veylune-header__bag veylune-marketplace-action" href="{{ path('frontend.veylune.preview.cart', { token: veyluneHeaderPreviewToken }) }}" aria-label="{{ 'veylune.marketplace.header.cartAria'|trans({'%count%': 0})|striptags }}" data-veylune-preview-cart data-veylune-header-cart>
                                    <span class="veylune-header__bag-icon" aria-hidden="true">{% sw_icon 'basket' %}</span>
                                    <span class="veylune-header__bag-label veylune-marketplace-action__label">{{ 'veylune.marketplace.header.cart'|trans|sw_sanitize }} <span class="veylune-marketplace-action__count">0</span></span>
                                </a>
                            {% else %}
                                <a class="veylune-header__bag veylune-marketplace-action" href="{{ path('frontend.checkout.cart.page') }}" aria-label="{{ 'checkout.cartTitle'|trans|striptags }}" data-veylune-header-cart {% if isNativeCartSurface %}data-off-canvas-cart="true"{% endif %}>
                                    {% if isNativeCartSurface %}
                                        <span data-cart-widget>
                                            {% sw_include '@Storefront/storefront/layout/header/actions/cart-widget.html.twig' %}
                                        </span>
                                    {% else %}
                                        <span class="veylune-header__bag-icon" aria-hidden="true">{% sw_icon 'basket' %}</span>
                                        <span class="veylune-header__bag-label veylune-marketplace-action__label">{{ 'veylune.marketplace.header.cart'|trans|sw_sanitize }} <span class="veylune-marketplace-action__count">{{ page.cart.lineItems|length }}</span></span>
                                    {% endif %}
                                </a>
                            {% endif %}
                        {% endblock %}
					</div>
				</div>
			</div>

            {% if not isPrivatePreview %}
                <nav class="veylune-marketplace-department-rail"
                    aria-label="{{ 'veylune.marketplace.header.shopDepartments'|trans|striptags }}"
                     data-veylune-nav-surface="departments"
                     data-vli-visual-baseline="department-rail">
                    <div class="veylune-marketplace-department-rail__inner">
                        {% for department in veyluneDepartmentRail %}
                            <a{% if department.sale|default(false) %} class="veylune-marketplace-department-rail__sale"{% endif %}
                               href="{{ department.url }}"
                               data-veylune-nav-key="{{ department.key }}"
                               data-veylune-page-transition>{{ department.label|trans|sw_sanitize }}</a>
                        {% endfor %}
                    </div>
                </nav>
            {% endif %}

            <div class="veylune-mega" data-veylune-mega aria-hidden="true">
                <div class="veylune-mega__backdrop" aria-hidden="true"></div>
                <div class="veylune-mega__panel" role="region" aria-label="{{ 'veylune.header.mega.ariaLabel'|trans|striptags }}" data-veylune-nav-surface="mega">
                    <button class="veylune-mega__close" type="button" data-veylune-mega-close aria-label="{{ 'veylune.marketplace.header.closeMenu'|trans|striptags }}">
                        {% sw_icon 'x' %}
                    </button>
                    {% for item in veyluneNavigationRegistry %}
                        {% if item.mega and item.desktop %}
                            <section class="veylune-mega__scene"
                                     id="veyluneMegaPanel-{{ item.mega }}"
                                     data-veylune-mega-panel="{{ item.mega }}"
                                     aria-labelledby="veyluneNavTrigger-{{ item.key }}"
                                     aria-label="{{ item.label|trans|striptags }}"
                                     aria-hidden="true">
                                {% if item.mega == 'shop' %}
                                    <div class="veylune-mega__group" data-veylune-registry-scope="mega-shop" data-veylune-registry-entity="departments">
                                        <h3>{{ 'veylune.header.mega.groups.categories'|trans|sw_sanitize }}</h3>
                                        <div class="veylune-mega__links">
                                            {% for category in veyluneMegaCategories %}
                                                {% if category.available %}
                                                <a href="{{ category.url }}" data-veylune-registry-key="{{ category.key }}" data-veylune-page-transition>{{ category.label|trans|sw_sanitize }}</a>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>
                                    <div class="veylune-mega__group" data-veylune-registry-scope="mega-shop" data-veylune-registry-entity="rooms">
                                        <h3>{{ 'veylune.header.mega.groups.rooms'|trans|sw_sanitize }}</h3>
                                        <div class="veylune-mega__links">
                                            {% for room in veyluneMegaRooms %}
                                                {% if room.available %}
                                                <a href="{{ room.url }}" data-veylune-registry-key="{{ room.key }}" data-veylune-page-transition>{{ room.label|trans|sw_sanitize }}</a>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>
                                    <div class="veylune-mega__group" data-veylune-registry-scope="mega-shop" data-veylune-registry-entity="collections">
                                        <h3>{{ 'veylune.header.mega.groups.collections'|trans|sw_sanitize }}</h3>
                                        <div class="veylune-mega__links">
                                            {% for collection in veyluneMegaCollections %}
                                                {% if collection.available %}
                                                <a href="{{ collection.url }}" data-veylune-registry-key="{{ collection.key }}" data-veylune-page-transition>{{ collection.label|trans|sw_sanitize }}</a>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% elseif item.mega == 'rooms' %}
                                    <div class="veylune-mega__group veylune-mega__group--wide" data-veylune-registry-scope="mega-rooms" data-veylune-registry-entity="rooms">
                                        <h3>{{ 'veylune.header.mega.groups.rooms'|trans|sw_sanitize }}</h3>
                                        <div class="veylune-mega__links veylune-mega__links--columns">
                                            {% for room in veyluneMegaRooms %}
                                                {% if room.available %}
                                                <a href="{{ room.url }}" data-veylune-registry-key="{{ room.key }}" data-veylune-page-transition>{{ room.label|trans|sw_sanitize }}</a>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% elseif item.mega == 'collections' %}
                                    <div class="veylune-mega__group veylune-mega__group--wide" data-veylune-registry-scope="mega-collections" data-veylune-registry-entity="collections">
                                        <h3>{{ 'veylune.header.mega.groups.collections'|trans|sw_sanitize }}</h3>
                                        <div class="veylune-mega__links">
                                            {% for collection in veyluneMegaCollections %}
                                                {% if collection.available %}
                                                <a href="{{ collection.url }}" data-veylune-registry-key="{{ collection.key }}" data-veylune-page-transition>{{ collection.label|trans|sw_sanitize }}</a>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% endif %}
                                <div class="veylune-mega__group" data-veylune-registry-scope="mega-{{ item.mega }}" data-veylune-registry-entity="services">
                                    <h3>{{ 'veylune.marketplace.header.servicesTitle'|trans|sw_sanitize }}</h3>
                                    <div class="veylune-mega__links">
                                        <a href="{{ veyluneRoutes.consultation }}" data-veylune-registry-key="consultation" data-veylune-page-transition>{{ 'veylune.marketplace.header.designConsultation'|trans|sw_sanitize }}</a>
                                        <a href="{{ veyluneRoutes.editions }}" data-veylune-registry-key="journal" data-veylune-page-transition>{{ 'veylune.marketplace.header.journalMaterial'|trans|sw_sanitize }}</a>
                                        <a href="{{ veyluneRoutes.trade }}" data-veylune-registry-key="trade" data-veylune-page-transition>{{ 'veylune.marketplace.header.tradeProgram'|trans|sw_sanitize }}</a>
                                    </div>
                                </div>
                            </section>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

			<div class="veylune-mobile-nav" id="veyluneMobileNav" data-veylune-mobile-nav role="dialog" aria-modal="true" aria-label="{{ 'veylune.header.mobile.navAriaLabel'|trans|striptags }}" aria-hidden="true">
				<div class="veylune-mobile-nav__inner">
					<button class="veylune-mobile-nav__close" type="button" data-veylune-mobile-close aria-label="{{ 'veylune.header.mobile.closeAriaLabel'|trans|striptags }}">
						{% sw_icon 'x' %}
					</button>
                    <span class="veylune-mobile-nav__kicker">{{ 'veylune.marketplace.header.browse'|trans|sw_sanitize }}</span>
                    {% sw_include '@VeyluneTheme/storefront/layout/header/mobile-navigation.html.twig' %}
				</div>
			</div>
		{% endblock %}
	</header>
{% endblock %}
