{% sw_extends '@Storefront/storefront/layout/header/header.html.twig' %}

{% block layout_header %}
	{% import '@VeyluneTheme/storefront/veylune/category-routes.html.twig' as veyluneCategoryRoutes %}
    {% set publicSurfaces = veylunePublicSurfaces|default({}) %}
	{% set veyluneHeaderPreviewToken = veylunePreviewToken|default(
        app.request.pathInfo starts with '/__veylune-preview/' ? app.request.query.get('token') : null
    ) %}
	{% set isPrivatePreview = veyluneHeaderPreviewToken is not empty %}
	{% set veyluneRoutes = {
        shop: isPrivatePreview ? path('frontend.veylune.preview.catalog.category', { categoryKey: 'furniture', token: veyluneHeaderPreviewToken }) : veyluneCategoryRoutes.url('furniture'),
        rooms: isPrivatePreview ? path('frontend.veylune.preview.catalog.room', { roomKey: 'living-room', token: veyluneHeaderPreviewToken }) : veyluneCategoryRoutes.url('livingRoom'),
        collections: isPrivatePreview ? path('frontend.veylune.preview.catalog.collection', { collectionKey: 'founder-selection', token: veyluneHeaderPreviewToken }) : veyluneCategoryRoutes.url('founderSelection'),
        editions: path(app.request.locale starts with 'de' ? 'frontend.veylune.editions.page.de' : 'frontend.veylune.editions.page'),
        consultation: veyluneCategoryRoutes.url('consultation'),
        trade: path('frontend.veylune.trade.page'),
        partnership: path('frontend.veylune.partnership.page')
    } %}
    {% set veyluneNavigationRegistry = [
        {
            key: 'shop',
            label: 'veylune.header.nav.shop',
            url: veyluneRoutes.shop,
            mega: 'shop',
            desktop: true,
            mobile: true
        },
        {
            key: 'rooms',
            label: 'veylune.header.nav.rooms',
            url: veyluneRoutes.rooms,
            mega: 'rooms',
            desktop: true,
            mobile: true
        },
        {
            key: 'collections',
            label: 'veylune.header.nav.collections',
            url: veyluneRoutes.collections,
            mega: 'collections',
            desktop: true,
            mobile: true
        },
        {
            key: 'editions',
            label: 'veylune.header.nav.journal',
            url: veyluneRoutes.editions,
            mega: null,
            desktop: true,
            mobile: true
        },
        {
            key: 'consultation',
            label: 'veylune.header.nav.consultation',
            url: veyluneRoutes.consultation,
            mega: null,
            desktop: true,
            mobile: true
        }
    ] %}
    {% if isPrivatePreview %}
        {% set veyluneMegaCategories = [
            { key: 'furniture', label: 'veylune.home.discovery.categories.furniture', url: veyluneRoutes.shop, available: true }
        ] %}
        {% set veyluneMegaRooms = [
            { key: 'living-room', label: 'veylune.home.discovery.rooms.livingRoom', url: veyluneRoutes.rooms, available: true },
            { key: 'dining-room', label: 'veylune.home.discovery.rooms.diningRoom', url: path('frontend.veylune.preview.catalog.room', { roomKey: 'dining-room', token: veyluneHeaderPreviewToken }), available: true }
        ] %}
        {% set veyluneMegaCollections = [
            { key: 'founder-selection', label: 'veylune.home.discovery.collections.founderSelection', url: veyluneRoutes.collections, available: true },
            { key: 'new-arrivals', label: 'veylune.home.discovery.collections.newArrivals', url: path('frontend.veylune.preview.catalog.collection', { collectionKey: 'new-arrivals', token: veyluneHeaderPreviewToken }), available: true }
        ] %}
    {% else %}
        {# These destinations are governed public Living Index routes. Keep the menu
           independent from the legacy catalog-readiness registry so an open mega
           menu can never degrade into an empty interaction surface. #}
        {% set veyluneMegaCategories = [
            { key: 'furniture', label: 'veylune.home.discovery.categories.furniture', url: veyluneCategoryRoutes.url('furniture'), available: true },
            { key: 'outdoor', label: 'Outdoor', url: veyluneCategoryRoutes.url('departmentOutdoor'), available: true },
            { key: 'bedding-bath', label: 'Bedding & Bath', url: veyluneCategoryRoutes.url('beddingBath'), available: true },
            { key: 'mattresses', label: 'Mattresses', url: veyluneCategoryRoutes.url('mattresses'), available: true },
            { key: 'rugs', label: 'Rugs', url: veyluneCategoryRoutes.url('rugs'), available: true },
            { key: 'decor-objects', label: 'Decor & Objects', url: veyluneCategoryRoutes.url('departmentDecorObjects'), available: true },
            { key: 'lighting', label: 'veylune.home.discovery.categories.lighting', url: veyluneCategoryRoutes.url('departmentLighting'), available: true },
            { key: 'textiles-rugs', label: 'veylune.home.discovery.categories.textilesRugs', url: veyluneCategoryRoutes.url('textilesRugs'), available: true },
            { key: 'organization', label: 'Organization', url: veyluneCategoryRoutes.url('organization'), available: true },
            { key: 'dining-kitchen', label: 'Dining & Kitchen', url: veyluneCategoryRoutes.url('diningKitchen'), available: true },
            { key: 'sale', label: 'Sale', url: veyluneCategoryRoutes.url('sale'), available: true }
        ] %}
        {% set veyluneMegaRooms = [
            { key: 'living-room', label: 'veylune.home.discovery.rooms.livingRoom', url: veyluneCategoryRoutes.url('livingRoom'), available: true },
            { key: 'dining-room', label: 'veylune.home.discovery.rooms.diningRoom', url: veyluneCategoryRoutes.url('diningRoom'), available: true },
            { key: 'bedroom', label: 'veylune.home.discovery.rooms.bedroom', url: veyluneCategoryRoutes.url('bedroom'), available: true },
            { key: 'workspace', label: 'veylune.home.discovery.rooms.workspace', url: veyluneCategoryRoutes.url('workspace'), available: true },
            { key: 'outdoor', label: 'veylune.home.discovery.rooms.outdoor', url: veyluneCategoryRoutes.url('outdoorRoom'), available: true }
        ] %}
        {% set veyluneMegaCollections = [
            { key: 'founder-selection', label: 'veylune.home.discovery.collections.founderSelection', url: veyluneCategoryRoutes.url('founderSelection'), available: true },
            { key: 'new-arrivals', label: 'veylune.home.discovery.collections.newArrivals', url: veyluneCategoryRoutes.url('newArrivals'), available: true },
            { key: 'best-sellers', label: 'Best Sellers', url: veyluneCategoryRoutes.url('bestSellers'), available: true },
            { key: 'sale', label: 'Sale', url: veyluneCategoryRoutes.url('sale'), available: true }
        ] %}
    {% endif %}
    {% set veyluneDepartmentRail = isPrivatePreview ? [] : [
        { key: 'furniture', label: 'Furniture', url: veyluneCategoryRoutes.url('furniture') },
        { key: 'outdoor', label: 'Outdoor', url: veyluneCategoryRoutes.url('departmentOutdoor') },
        { key: 'bedding-bath', label: 'Bedding & Bath', url: veyluneCategoryRoutes.url('beddingBath') },
        { key: 'mattresses', label: 'Mattresses', url: veyluneCategoryRoutes.url('mattresses') },
        { key: 'rugs', label: 'Rugs', url: veyluneCategoryRoutes.url('rugs') },
        { key: 'decor-objects', label: 'Decor & Objects', url: veyluneCategoryRoutes.url('departmentDecorObjects') },
        { key: 'lighting', label: 'Lighting', url: veyluneCategoryRoutes.url('departmentLighting') },
        { key: 'organization', label: 'Organization', url: veyluneCategoryRoutes.url('organization') },
        { key: 'dining-kitchen', label: 'Dining & Kitchen', url: veyluneCategoryRoutes.url('diningKitchen') },
        { key: 'sale', label: 'Sale', url: veyluneCategoryRoutes.url('sale'), sale: true }
    ] %}
    {% set veyluneLivingIndexAxes = [
        { key: 'object', label: 'Object', url: veyluneRoutes.shop, mega: 'shop' },
        { key: 'room', label: 'Room', url: veyluneRoutes.rooms, mega: 'rooms' },
        { key: 'material', label: 'Material', url: veyluneRoutes.editions, mega: null },
        { key: 'style', label: 'Style', url: veyluneRoutes.collections, mega: 'collections' },
        { key: 'maker', label: 'Maker', url: veyluneRoutes.partnership, mega: null },
        { key: 'project', label: 'Project', url: veyluneRoutes.consultation, mega: null },
        { key: 'sale', label: 'Sale', url: veyluneCategoryRoutes.url('sale'), mega: null }
    ] %}

	<header class="veylune-header veylune-header--living-index" data-veylune-header data-veylune-living-index-header>
		{% block layout_header_navigation %}
            <div class="veylune-marketplace-utility" aria-label="Store services">
                <div class="veylune-marketplace-utility__inner">
                    <div class="veylune-marketplace-family" aria-label="Veylune family">
                        <a class="veylune-marketplace-family__primary" href="{{ path('frontend.home.page') }}">Veylune</a>
                        <a href="{{ veyluneRoutes.rooms }}">Rooms</a>
                        <a href="{{ veyluneRoutes.editions }}">Material Index</a>
                    </div>
                    <a class="veylune-marketplace-utility__announcement"
                       href="{{ veyluneRoutes.consultation }}">
                        Private consultation by appointment
                    </a>
                    <div class="veylune-marketplace-utility__right">
                        <nav class="veylune-marketplace-utility__links" aria-label="Programs and services">
                            <a href="{{ veyluneRoutes.partnership }}">Atelier Partnerships</a>
                            <a href="{{ veyluneRoutes.consultation }}">Design Service</a>
                            <span>EN / EUR</span>
                        </nav>
                    </div>
                </div>
            </div>
			<div class="veylune-header__bar">
				<div class="veylune-header__inner">

					<div class="veylune-header__mobile-toggle">
						{% block layout_header_navigation_toggle %}
							<button class="veylune-header__icon-button nav-main-toggle-btn header-actions-btn" type="button" data-veylune-mobile-toggle aria-expanded="false" aria-controls="veyluneMobileNav" aria-label="{{ 'general.menuLink'|trans|striptags }}">
								{% sw_icon 'stack' %}
							</button>
						{% endblock %}
					</div>

					{% block layout_header_logo %}
						<a class="veylune-header__logo" href="{{ path('frontend.home.page') }}" aria-label="{{ 'header.logoLink'|trans|striptags }}">
							<span class="veylune-header__logo-main">
								veylune
							</span>
						</a>
					{% endblock %}

                    <div class="veylune-marketplace-search" data-veylune-header-search>
                        <form class="veylune-marketplace-search__form" action="{{ path('frontend.veylune.living_index.search') }}" method="get" role="search" data-veylune-header-search-form>
                            <label class="visually-hidden" for="veyluneMarketplaceSearch">{{ 'header.searchPlaceholder'|trans|striptags }}</label>
                            <input id="veyluneMarketplaceSearch"
                                   class="veylune-marketplace-search__input"
                                   type="search"
                                   name="q"
                                   value="{{ app.request.attributes.get('_route') == 'frontend.veylune.living_index.search' ? app.request.query.get('q')|default('') : '' }}"
                                   autocomplete="off"
                                   placeholder="Search objects, rooms, materials, makers..."
                                   aria-autocomplete="list"
                                   aria-controls="veyluneMarketplaceSuggestions"
                                   aria-expanded="false"
                                   data-vli-header-search-input
                                   aria-label="{{ 'header.searchPlaceholder'|trans|striptags }}">
                            <button class="veylune-marketplace-search__submit" type="submit">Search</button>
                        </form>
                        <section class="vli-header-suggest"
                                 id="veyluneMarketplaceSuggestions"
                                 aria-label="Search suggestions"
                                 aria-live="polite"
                                 data-vli-header-suggest
                                 hidden>
                            <a class="vli-header-suggest__query"
                               href="{{ path('frontend.veylune.living_index.search') }}"
                               data-vli-header-query-link
                               hidden>
                                <span>Search for</span>
                                <strong data-vli-header-query-label></strong>
                                <b aria-hidden="true">&rarr;</b>
                            </a>
                            <div class="vli-header-suggest__grid">
                                <div>
                                    <p>Popular searches</p>
                                    {% for suggestion in [
                                        { label: 'Living room', query: 'living room', terms: 'living room sofa seating' },
                                        { label: 'Quiet contrast', query: 'quiet contrast', terms: 'quiet contrast style restraint' },
                                        { label: 'Oak furniture', query: 'oak furniture', terms: 'oak wood furniture table' },
                                        { label: 'Sculptural lighting', query: 'sculptural lighting', terms: 'light lighting lamp sculptural' },
                                        { label: 'Private project', query: 'private project', terms: 'project design service consultation' }
                                    ] %}
                                        <a href="{{ path('frontend.veylune.living_index.search', { q: suggestion.query }) }}"
                                           data-vli-header-suggestion
                                           data-search-terms="{{ suggestion.terms }}">{{ suggestion.label }}</a>
                                    {% endfor %}
                                </div>
                                <div>
                                    <p>Explore by type</p>
                                    {% for axis in veyluneLivingIndexAxes %}
                                        {% if axis.key != 'sale' %}
                                            <a href="{{ path('frontend.veylune.living_index.search', { axis: axis.key }) }}"
                                               data-vli-header-suggestion
                                               data-search-terms="{{ axis.key }} {{ axis.label|lower }}">{{ axis.label }}</a>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                            <small data-vli-header-search-scope>Suggestions cover public Living Index paths only.</small>
                        </section>
                    </div>
					<nav class="veylune-header__nav" id="veylunePrimaryNavigation" aria-label="{{ 'veylune.header.primaryNavAriaLabel'|trans|striptags }}" data-veylune-nav-surface="primary">
                        {% for axis in veyluneLivingIndexAxes %}
                                <a class="veylune-header__nav-link{% if axis.key == 'sale' %} veylune-header__nav-link--sale{% endif %}"
                                   href="{{ axis.url }}"
                                   id="veyluneNavTrigger-{{ axis.mega|default(axis.key) }}"
                                   data-veylune-nav-key="{{ axis.key }}"
                                   {% if axis.mega %}data-veylune-mega-trigger="{{ axis.mega }}" aria-haspopup="true" aria-expanded="false" aria-controls="veyluneMegaPanel-{{ axis.mega }}"{% endif %}
                                   data-veylune-page-transition>
                                    {{ axis.label }}
                                </a>
                        {% endfor %}
					</nav>

					<div class="veylune-header__actions">
						{% block layout_header_search %}
                            <a class="veylune-header__search-toggle veylune-header__search-toggle--mobile" href="#veyluneMarketplaceSearch" aria-label="{{ 'header.searchButton'|trans|striptags }}">
                                <span class="veylune-header__search-toggle-icon" aria-hidden="true">{% sw_icon 'search' %}</span>
                            </a>
                        {% endblock %}

                        {% block layout_header_actions_account %}
                            {% if isPrivatePreview %}
                                <a class="veylune-marketplace-action" href="{{ path('frontend.veylune.preview.account', { token: veyluneHeaderPreviewToken }) }}" aria-label="Private account preview" data-veylune-preview-account data-veylune-header-account>
                                    <span class="veylune-marketplace-action__icon" aria-hidden="true">{% sw_icon 'avatar' %}</span>
                                    <span class="veylune-marketplace-action__label">Sign In</span>
                                </a>
                            {% else %}
                                <a class="veylune-marketplace-action" href="{{ path('frontend.account.home.page') }}" aria-label="{{ 'account.myAccount'|trans|striptags }}" data-veylune-header-account>
                                    <span class="veylune-marketplace-action__icon" aria-hidden="true">{% sw_icon 'avatar' %}</span>
                                    <span class="veylune-marketplace-action__label">Sign In</span>
                                </a>
                            {% endif %}
                        {% endblock %}

						{% block layout_header_actions_cart %}
                            {% if isPrivatePreview %}
                                <a class="veylune-header__bag veylune-marketplace-action" href="{{ path('frontend.veylune.preview.cart', { token: veyluneHeaderPreviewToken }) }}" aria-label="Cart, 0 items" data-veylune-preview-cart data-veylune-header-cart>
                                    <span class="veylune-header__bag-icon" aria-hidden="true">{% sw_icon 'basket' %}</span>
                                    <span class="veylune-header__bag-label veylune-marketplace-action__label">Cart <span class="veylune-marketplace-action__count">0</span></span>
                                </a>
                            {% else %}
                                <a class="veylune-header__bag veylune-marketplace-action" href="{{ path('frontend.checkout.cart.page') }}" aria-label="{{ 'checkout.cartTitle'|trans|striptags }}" data-veylune-header-cart>
                                    <span class="veylune-header__bag-icon" aria-hidden="true">{% sw_icon 'basket' %}</span>
                                    <span class="veylune-header__bag-label veylune-marketplace-action__label">Cart <span class="veylune-marketplace-action__count">{{ page.cart.lineItems|length }}</span></span>
                                </a>
                            {% endif %}
                        {% endblock %}
					</div>
				</div>
			</div>

            {% if not isPrivatePreview %}
                <nav class="veylune-marketplace-department-rail"
                    aria-label="Shop Veylune departments"
                     data-veylune-nav-surface="departments"
                     data-vli-visual-baseline="department-rail">
                    <div class="veylune-marketplace-department-rail__inner">
                        {% for department in veyluneDepartmentRail %}
                            <a{% if department.sale|default(false) %} class="veylune-marketplace-department-rail__sale"{% endif %}
                               href="{{ department.url }}"
                               data-veylune-nav-key="{{ department.key }}"
                               data-veylune-page-transition>{{ department.label }}</a>
                        {% endfor %}
                    </div>
                </nav>
            {% endif %}

            <div class="veylune-mega" data-veylune-mega aria-hidden="true">
                <div class="veylune-mega__backdrop" aria-hidden="true"></div>
                <div class="veylune-mega__panel" role="region" aria-label="{{ 'veylune.header.mega.ariaLabel'|trans|striptags }}" data-veylune-nav-surface="mega">
                    <button class="veylune-mega__close" type="button" data-veylune-mega-close aria-label="Close menu">
                        {% sw_icon 'x' %}
                    </button>
                    {% for item in veyluneNavigationRegistry %}
                        {% if item.mega and item.desktop %}
                            <section class="veylune-mega__scene"
                                     id="veyluneMegaPanel-{{ item.mega }}"
                                     data-veylune-mega-panel="{{ item.mega }}"
                                     aria-labelledby="veyluneNavTrigger-{{ item.key }}"
                                     aria-label="{{ item.label|trans|striptags }}"
                                     aria-hidden="true">
                                {% if item.mega == 'shop' %}
                                    <div class="veylune-mega__group" data-veylune-registry-scope="mega-shop" data-veylune-registry-entity="departments">
                                        <h3>{{ 'veylune.header.mega.groups.categories'|trans|sw_sanitize }}</h3>
                                        <div class="veylune-mega__links">
                                            {% for category in veyluneMegaCategories %}
                                                {% if category.available %}
                                                <a href="{{ category.url }}" data-veylune-registry-key="{{ category.key }}" data-veylune-page-transition>{{ category.label|trans|sw_sanitize }}</a>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>
                                    <div class="veylune-mega__group" data-veylune-registry-scope="mega-shop" data-veylune-registry-entity="rooms">
                                        <h3>{{ 'veylune.header.mega.groups.rooms'|trans|sw_sanitize }}</h3>
                                        <div class="veylune-mega__links">
                                            {% for room in veyluneMegaRooms %}
                                                {% if room.available %}
                                                <a href="{{ room.url }}" data-veylune-registry-key="{{ room.key }}" data-veylune-page-transition>{{ room.label|trans|sw_sanitize }}</a>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>
                                    <div class="veylune-mega__group" data-veylune-registry-scope="mega-shop" data-veylune-registry-entity="collections">
                                        <h3>{{ 'veylune.header.mega.groups.collections'|trans|sw_sanitize }}</h3>
                                        <div class="veylune-mega__links">
                                            {% for collection in veyluneMegaCollections %}
                                                {% if collection.available %}
                                                <a href="{{ collection.url }}" data-veylune-registry-key="{{ collection.key }}" data-veylune-page-transition>{{ collection.label|trans|sw_sanitize }}</a>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% elseif item.mega == 'rooms' %}
                                    <div class="veylune-mega__group veylune-mega__group--wide" data-veylune-registry-scope="mega-rooms" data-veylune-registry-entity="rooms">
                                        <h3>{{ 'veylune.header.mega.groups.rooms'|trans|sw_sanitize }}</h3>
                                        <div class="veylune-mega__links veylune-mega__links--columns">
                                            {% for room in veyluneMegaRooms %}
                                                {% if room.available %}
                                                <a href="{{ room.url }}" data-veylune-registry-key="{{ room.key }}" data-veylune-page-transition>{{ room.label|trans|sw_sanitize }}</a>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% elseif item.mega == 'collections' %}
                                    <div class="veylune-mega__group veylune-mega__group--wide" data-veylune-registry-scope="mega-collections" data-veylune-registry-entity="collections">
                                        <h3>{{ 'veylune.header.mega.groups.collections'|trans|sw_sanitize }}</h3>
                                        <div class="veylune-mega__links">
                                            {% for collection in veyluneMegaCollections %}
                                                {% if collection.available %}
                                                <a href="{{ collection.url }}" data-veylune-registry-key="{{ collection.key }}" data-veylune-page-transition>{{ collection.label|trans|sw_sanitize }}</a>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                    </div>
                                {% endif %}
                                <div class="veylune-mega__group" data-veylune-registry-scope="mega-{{ item.mega }}" data-veylune-registry-entity="services">
                                    <h3>Services &amp; Inspiration</h3>
                                    <div class="veylune-mega__links">
                                        <a href="{{ veyluneRoutes.consultation }}" data-veylune-registry-key="consultation" data-veylune-page-transition>Design Consultation</a>
                                        <a href="{{ veyluneRoutes.editions }}" data-veylune-registry-key="journal" data-veylune-page-transition>Journal &amp; Material Index</a>
                                        <a href="{{ veyluneRoutes.trade }}" data-veylune-registry-key="trade" data-veylune-page-transition>Trade Program</a>
                                    </div>
                                </div>
                            </section>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>

			<div class="veylune-mobile-nav" id="veyluneMobileNav" data-veylune-mobile-nav role="dialog" aria-modal="true" aria-label="{{ 'veylune.header.mobile.navAriaLabel'|trans|striptags }}" aria-hidden="true">
				<div class="veylune-mobile-nav__inner">
					<button class="veylune-mobile-nav__close" type="button" data-veylune-mobile-close aria-label="{{ 'veylune.header.mobile.closeAriaLabel'|trans|striptags }}">
						{% sw_icon 'x' %}
					</button>
					<span class="veylune-mobile-nav__kicker">Browse Veylune</span>
                    {% sw_include '@VeyluneTheme/storefront/layout/header/mobile-navigation.html.twig' %}
				</div>
			</div>
		{% endblock %}
	</header>
{% endblock %}
