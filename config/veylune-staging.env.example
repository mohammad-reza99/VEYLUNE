# Veylune staging environment contract.
#
# Copy these names into the staging secret manager or deployment platform.
# Do not commit a filled copy of this file and do not source this example.

VEYLUNE_STAGING_CONFIRMED=0
VEYLUNE_RC_REF=veylune-rc-20260902.1
VEYLUNE_STAGING_URL=https://staging.example.invalid
VEYLUNE_STAGING_HOST=staging.example.invalid
VEYLUNE_STAGING_USER=deploy
VEYLUNE_STAGING_SSH_PORT=22
VEYLUNE_STAGING_RELEASE_ROOT=/srv/veylune/releases
VEYLUNE_STAGING_SHARED_ROOT=/srv/veylune/shared
VEYLUNE_STAGING_CURRENT_LINK=/srv/veylune/current
VEYLUNE_BACKUP_OWNER=replace-with-owner
VEYLUNE_ROLLBACK_REF=395b026

# Shopware must run with production behavior on staging.
APP_ENV=prod
APP_DEBUG=0
APP_URL=https://staging.example.invalid
APP_SECRET=replace-via-secret-manager
DATABASE_URL=mysql://replace-via-secret-manager
MAILER_DSN=smtp://replace-via-secret-manager
VEYLUNE_DRAFT_PREVIEW_ENABLED=0
SHOPWARE_HTTP_CACHE_ENABLED=1
